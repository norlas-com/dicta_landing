---
import type { GetStaticPaths } from "astro";
import BlogIndexPage from "../../../components/pages/BlogIndexPage.astro";
import { PREFIXED_LOCALES, type Locale } from "../../../i18n/locales";

// See src/pages/[lang]/faq.astro: the .map must stay inline here.
export const getStaticPaths = (() =>
  PREFIXED_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
---

<BlogIndexPage locale={lang as Locale} />
