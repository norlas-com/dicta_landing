---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { PREFIXED_LOCALES, type Locale } from "../../../../i18n/locales";
import BlogIndexPage from "../../../../components/pages/BlogIndexPage.astro";
import type { Topic } from "../../../../lib/blog-topics";

// Inline (not an imported helper): getStaticPaths runs in an isolated scope.
// One page per (language, topic) pair that has at least one post.
export const getStaticPaths = (async () => {
  const posts = await getCollection(
    "blog",
    (p) => !p.data.draft && (PREFIXED_LOCALES as readonly string[]).includes(p.data.lang),
  );
  const pairs = new Set(posts.map((p) => `${p.data.lang}/${p.data.topic}`));
  return [...pairs].map((pair) => {
    const [lang, topic] = pair.split("/");
    return { params: { lang, topic } };
  });
}) satisfies GetStaticPaths;

const { lang, topic } = Astro.params;
---

<BlogIndexPage locale={lang as Locale} topic={topic as Topic} />
