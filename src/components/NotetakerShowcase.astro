---
import type { Locale } from "../i18n/ui";
import { t } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);

const platforms = [
  { key: "meet", label: "Google Meet", color: "var(--color-platform-meet)" },
  { key: "zoom", label: "Zoom", color: "var(--color-platform-zoom)" },
  { key: "teams", label: "Teams", color: "var(--color-platform-teams)" },
];
---

<div class="relative w-full">
  <div class="absolute -inset-px rounded-panel bg-brand-gradient opacity-40 blur-[2px]" aria-hidden="true"></div>

  <div class="relative flex items-center gap-3.5 rounded-panel border border-border bg-surface/90 backdrop-blur-sm px-4 py-3.5 shadow-pop">
    <span class="relative shrink-0 grid place-items-center w-12 h-12 rounded-control bg-surface-2 border border-border overflow-hidden">
      {
        platforms.map((p, i) => (
          <span
            data-platform-logo={i}
            class:list={[
              "absolute inset-0 grid place-items-center transition-opacity duration-500",
              i === 0 ? "opacity-100" : "opacity-0",
            ]}
          >
            <span class="grid place-items-center w-7 h-7 rounded-md" style={`background:${p.color}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m22 8-6 4 6 4V8z"></path>
                <rect x="2" y="6" width="14" height="12" rx="2"></rect>
              </svg>
            </span>
          </span>
        ))
      }
    </span>

    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <span class="text-sm font-semibold text-foreground truncate">Dicta Notetaker</span>
        <span class="inline-flex items-center gap-1 text-2xs font-medium text-live">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-live opacity-70 animate-ping"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-live"></span>
          </span>
          REC
        </span>
      </div>
      <div class="text-xs text-muted mt-0.5">
        {d.notetaker.steps.recording} · <span data-platform-label>{platforms[0].label}</span>
      </div>
    </div>

    <div class="flex items-end gap-[3px] h-7 shrink-0" aria-hidden="true">
      {[0, 1, 2, 3].map((b) => (
        <span
          class="w-[3px] rounded-full bg-accent animate-equalize"
          style={`height:100%;animation-delay:${b * 0.16}s`}
        ></span>
      ))}
    </div>
  </div>
</div>

<script define:vars={{ labels: platforms.map((p) => p.label) }}>
  document.querySelectorAll("[data-platform-label]").forEach((labelEl) => {
    const card = labelEl.closest(".relative")?.parentElement;
    if (!card) return;
    const logos = card.querySelectorAll("[data-platform-logo]");
    let i = 0;
    setInterval(() => {
      i = (i + 1) % labels.length;
      logos.forEach((el, idx) => {
        el.classList.toggle("opacity-100", idx === i);
        el.classList.toggle("opacity-0", idx !== i);
      });
      labelEl.textContent = labels[i];
    }, 2600);
  });
</script>
