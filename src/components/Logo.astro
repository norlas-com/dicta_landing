---
// The waveform-D mark next to the serif wordmark. The mark is an <img> rather
// than inline SVG so the header and the mobile menu can both show it without
// their gradient ids colliding.
interface Props {
  /** Tailwind text size for the wordmark; the mark scales with it. */
  size?: "md" | "lg";
  class?: string;
}
const { size = "lg", class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <img
    src="/logo.svg"
    alt=""
    width="370"
    height="319"
    decoding="async"
    class:list={["w-auto flex-none", size === "lg" ? "h-[1.6rem]" : "h-6"]}
  />
  <span class:list={["font-display font-semibold tracking-tight leading-none", size === "lg" ? "text-[1.6rem]" : "text-2xl"]}>Dicta</span>
</span>
