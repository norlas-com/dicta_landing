---
import type { Locale } from "../../i18n/ui";
import { t, appUrl } from "../../i18n/utils";
import { HOME_V2 } from "../../i18n/pages/home-v2";
import StoreBadges from "../StoreBadges.astro";

/**
 * The last page of the story, drenched in ink: the promise once more, one
 * verb, and the stores. Rounded on top so it lifts off the paper like the
 * proof band near the start; the footer sits below it on paper.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const c = HOME_V2[locale].closing;
---

<section class="px-3 sm:px-5 pb-3 sm:pb-5" aria-labelledby="closing-title">
  <div class="bg-ink text-ink-fg rounded-[2rem] sm:rounded-[3rem] py-24 sm:py-32 lg:py-40 text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h2 id="closing-title" class="reveal font-display text-[clamp(2.8rem,8vw,6.6rem)] leading-[0.98] tracking-[-0.035em] font-medium text-balance">
        {c.title}
        <span class="block italic font-normal text-ink-accent">{c.titleAccent}</span>
      </h2>
      <p class="reveal mt-8 text-lg text-ink-muted" style="--rd:.08s">{c.sub}</p>
      <div class="reveal mt-10 flex justify-center" style="--rd:.14s">
        <a
          href={appUrl("/sign-up")}
          data-analytics-event="signup_start_click"
          data-analytics-location="closing"
          class="group inline-flex items-center justify-center gap-2 h-14 px-10 rounded-pill bg-ink-fg text-ink text-base font-semibold hover:bg-ink-accent active:scale-[0.98] transition-[background-color,transform] duration-200 ease-out-expo"
        >
          {d.home.startFree}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 ease-out-expo group-hover:translate-x-0.5 rtl:-scale-x-100"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="reveal mt-10 flex justify-center" style="--rd:.2s">
        <StoreBadges locale={locale} location="closing" />
      </div>
    </div>
  </div>
</section>
