---
import type { Locale } from "../../i18n/ui";
import { t, appUrl } from "../../i18n/utils";
import { HOME_V2 } from "../../i18n/pages/home-v2";
import { meetingUi } from "../../i18n/pages/meeting-ui";
import StoreBadges from "../StoreBadges.astro";
import TaskLine from "../meeting/TaskLine.astro";
import VisitRecap from "../meeting/VisitRecap.astro";

/**
 * The end of the meeting: the recap is done and one task is left open, the
 * visitor's own — "☐ You: start for free". The stores sit under it, and the
 * visit itself (pages, time, topics) closes the room when there is one to
 * show.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const c = HOME_V2[locale].closing;
const m = meetingUi(locale);
---

<section class="px-3 sm:px-5 pb-3 sm:pb-5" aria-labelledby="closing-title">
  <div class="max-w-6xl mx-auto bg-ink text-ink-fg rounded-[1.75rem] sm:rounded-[2.25rem] dark:ring-1 dark:ring-inset dark:ring-ink-line/70 px-6 sm:px-10 lg:px-14 py-14 sm:py-20 lg:py-24">
    <div class="max-w-3xl">
      <h2 id="closing-title" class="reveal font-display text-[clamp(2.6rem,6.4vw,5.2rem)] leading-[0.98] tracking-[-0.035em] font-medium text-balance">
        {c.title}
        <span class="block italic font-normal text-ink-accent">{c.titleAccent}</span>
      </h2>
      <p class="reveal mt-7 text-lg text-ink-muted" style="--rd:.06s">{c.sub}</p>
    </div>

    <div class="reveal mt-10 max-w-[38rem]" style="--rd:.12s">
      <TaskLine
        tone="ink"
        who={m.you}
        task={m.taskStartFree}
        href={appUrl("/sign-up")}
        cta={d.home.startFree}
        attrs={{ "data-analytics-event": "signup_start_click", "data-analytics-location": "closing" }}
      />
    </div>

    <div class="reveal mt-8 flex flex-wrap items-center gap-x-8 gap-y-5" style="--rd:.18s">
      <StoreBadges locale={locale} location="closing" />
      <VisitRecap locale={locale} tone="ink" />
    </div>
  </div>
</section>
