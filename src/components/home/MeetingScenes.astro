---
import type { Locale } from "../../i18n/ui";
import { localePath } from "../../i18n/utils";
import { HOME_V2 } from "../../i18n/pages/home-v2";
import { meetingUi } from "../../i18n/pages/meeting-ui";
import Room from "../meeting/Room.astro";
import NotesCard from "../meeting/NotesCard.astro";
import NotesItem from "../meeting/NotesItem.astro";
import SceneArt from "../meeting/SceneArt.astro";
import BrandIcons from "../BrandIcons.astro";

/**
 * The meeting itself: four scenes in the ink room on the start side, and the
 * notes Dicta writes during them on the other. On lg+ the notes card stays
 * pinned beside the scenes and each scene, as it crosses the middle of the
 * screen, writes its own lines into the card (data-notes-scene). Below lg the
 * grid collapses to DOM order (scenes 1–3, the card, scene 4) and each line
 * writes itself in as it scrolls into view.
 *
 * DOM order decides the heading order (unchanged from before the redesign):
 * offline H2 → online H2 → payoff H2 → notes H3 (meetingTitle) → languages H2.
 * Every line of copy is in the static HTML; only opacity/transform animate,
 * gated on html.js and switched off for reduced motion.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const h = HOME_V2[locale];
const off = h.offline;
const on = h.online;
const pay = h.payoff;
const lang = h.languages;
const m = meetingUi(locale);
const tags = ["UZ", "RU", "EN", "AR"];
const sampleLang = ["uz", "ru", "en", "ar"];

// One tone per person in the sample meeting, from the theme tokens.
const tone = ["bg-accent text-accent-fg", "bg-tier-business text-tier-business-fg", "bg-tier-top text-tier-top-fg"];
const who = (name: string) => Math.max(0, pay.tasks.findIndex((t) => t.who === name));

const h2 = "font-display text-ink-fg mt-4 text-[clamp(2.1rem,3.6vw,3.1rem)] leading-[1.04] tracking-[-0.03em] font-medium text-balance";
const kicker = "text-sm font-medium text-ink-accent";
const body = "mt-6 text-[1.0625rem] text-ink-muted leading-relaxed max-w-[46ch]";
const link =
  "group mt-7 inline-flex items-center gap-2 text-base font-medium text-ink-fg underline decoration-ink-line underline-offset-[6px] hover:text-ink-accent hover:decoration-ink-accent transition-colors";
const arrow = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none transition-transform duration-200 ease-out-expo group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>`;
// Every block is a grid row of the start column on lg+, about one screen tall.
const block = "lg:col-start-1 lg:min-h-[90vh] justify-center";
// Sections of the notes: a mono label that is the page's own copy.
const secLabel = "meeting-label text-muted mb-3";
---

<section class="px-3 sm:px-5 pb-16 sm:pb-24" data-meeting-scenes>
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:gap-x-6 xl:gap-x-8">
    {/* Scene 1: in the room. */}
    <Room variant="scene" as="div" data-scene-block="offline" class:list={[block, "rounded-t-[1.75rem] sm:rounded-t-[2.25rem]"]}>
      <p class={kicker}>{off.kicker}</p>
      <h2 id="scene-offline" class={h2}>
        {off.title}
        <span class="block italic font-normal text-ink-accent">{off.titleAccent}</span>
      </h2>
      <p class={body}>{off.body}</p>
      <p class="mt-4 text-base text-ink-muted/85 leading-relaxed max-w-[46ch]">{off.roundTable}</p>
      <a href={localePath("/use-cases/offline-meetings", locale)} data-analytics-event="cta_clicked" data-analytics-location="scene_offline" class={link}>
        {off.link}
        <Fragment set:html={arrow} />
      </a>
      <div slot="art" class="relative max-w-[30rem]">
        <SceneArt kind="offline" />
        {/* Voices, told apart. */}
        <ul class="mt-3 flex flex-wrap justify-center gap-1.5" aria-hidden="true">
          {off.speakers.map((name, i) => (
            <li class="inline-flex items-center gap-1.5 h-7 ps-1 pe-2.5 rounded-pill bg-ink-2 ring-1 ring-inset ring-ink-line text-xs font-medium text-ink-fg">
              <span class:list={["w-5 h-5 rounded-full grid place-items-center text-[0.625rem] font-semibold", tone[i]]}>{name.slice(0, 1)}</span>
              {name}
            </li>
          ))}
        </ul>
      </div>
    </Room>

    {/* Scene 2: online calls. */}
    <Room variant="scene" as="div" data-scene-block="online" class:list={[block, "border-t border-dashed border-ink-line"]}>
      <p class={kicker}>{on.kicker}</p>
      <h2 id="scene-online" class={h2}>
        {on.title}
        <span class="block italic font-normal text-ink-accent">{on.titleAccent}</span>
      </h2>
      <p class={body}>{on.body}</p>
      <div class="mt-6">
        <BrandIcons brands={["meet", "zoom", "teams"]} />
      </div>
      <a href={localePath("/use-cases/meeting-bot", locale)} data-analytics-event="cta_clicked" data-analytics-location="scene_online" class={link}>
        {on.link}
        <Fragment set:html={arrow} />
      </a>
      <div slot="art" class="relative max-w-[30rem]">
        <SceneArt kind="online" />
        {/* The room's name, the pasted link and the bot joining: decoration. */}
        <div aria-hidden="true">
          <span class="absolute top-[9.5%] start-[22%] meeting-label text-ink-muted">{on.room}</span>
          <div class="absolute -bottom-4 start-0 end-6 sm:end-auto sm:w-[22rem] flex items-center gap-2 p-1.5 rounded-[0.9rem] bg-surface text-foreground shadow-pop">
            <span class="flex-1 min-w-0 flex items-center gap-2 h-9 px-2.5 rounded-[0.6rem] bg-surface-2 text-[0.8125rem] text-foreground-soft">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-muted"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
              <span class="truncate" dir="ltr">{on.placeholder}</span>
            </span>
            <span class="flex-none inline-flex items-center h-9 px-3 rounded-[0.6rem] bg-accent text-accent-fg text-[0.8125rem] font-semibold">{on.send}</span>
          </div>
          <span class="absolute top-[46%] -end-1 max-w-[62%] hidden sm:inline-flex items-center gap-1.5 min-h-7 px-2.5 py-1 rounded-pill bg-ink-fg text-ink text-xs font-medium leading-tight">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><path d="M5 12l5 5L20 7"></path></svg>
            {on.joined}
          </span>
        </div>
      </div>
    </Room>

    {/* Scene 3: the recap. Its steps are the copy; the card shows them done. */}
    <Room variant="scene" as="div" data-scene-block="payoff" class:list={[block, "border-t border-dashed border-ink-line max-lg:rounded-b-[1.75rem] max-lg:sm:rounded-b-[2.25rem]"]}>
      <h2 id="scene-payoff" class={h2}>
        {pay.title}
        <span class="block italic font-normal text-ink-accent">{pay.titleAccent}</span>
      </h2>
      <ol class="mt-9 grid sm:grid-cols-2 gap-x-8 gap-y-7 max-w-[40rem]">
        {pay.steps.map((s, i) => (
          <li class="border-t border-ink-line pt-4">
            <p class="text-sm font-semibold text-ink-accent tabular-nums">{i + 1} · {s.label}</p>
            <p class="mt-2 text-base text-ink-muted leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
    </Room>

    {/* The notes, written during the scenes. */}
    <NotesCard
      sticky
      label={`${m.dicta} · ${m.notesLive}`}
      class="lg:col-start-2 lg:row-start-1 lg:row-span-4 my-4 lg:my-0"
      data-notes-pin
    >
      <h3 class="notes-title text-foreground">{pay.meetingTitle}</h3>
      <div class="mt-2.5 flex items-center gap-3 text-sm text-muted tabular-nums">
        <span class="flex -space-x-1.5 rtl:space-x-reverse">
          {pay.tasks.map((t, k) => (
            <span class:list={["w-6 h-6 rounded-full ring-2 ring-surface grid place-items-center text-[0.6875rem] font-semibold", tone[k]]}>{t.who.slice(0, 1)}</span>
          ))}
        </span>
        <span>52:10</span>
        <span class="notes-in ms-auto flex items-center gap-1" data-notes-scene="languages" data-ui-label>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none me-0.5"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
          {tags.map((tg) => (
            <span class="meeting-label inline-flex items-center h-5 px-1.5 rounded-[0.35rem] bg-accent-soft text-accent">{tg}</span>
          ))}
        </span>
      </div>

      <div class="mt-5 grid gap-4">
        <div class="notes-in" data-notes-scene="offline">
          <p class={secLabel}>{pay.steps[0].label}</p>
          <p class="text-[0.9375rem] leading-[1.6] text-foreground-soft">{pay.summary}</p>
        </div>

        <div class="notes-in" data-notes-scene="offline" style="--rd:.12s">
          <p class={secLabel} data-ui-label>{m.speakers}</p>
          <ul class="flex flex-wrap gap-1.5">
            {off.speakers.map((name, i) => (
              <li class="inline-flex items-center gap-1.5 h-7 ps-2 pe-2.5 rounded-pill bg-surface-2 text-[0.8125rem] font-medium text-foreground">
                <span aria-hidden="true" class:list={["w-2 h-2 rounded-full", tone[i].split(" ")[0]]}></span>
                {name}
              </li>
            ))}
            <li class="notes-in inline-flex items-center gap-1.5 min-h-7 py-1 ps-2 pe-2.5 rounded-pill border border-dashed border-accent/60 text-[0.8125rem] font-medium text-accent leading-tight" data-notes-scene="online">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none"><path d="M5 12l5 5L20 7"></path></svg>
              {on.joined}
            </li>
          </ul>
        </div>

        <div class="notes-in" data-notes-scene="payoff">
          <p class={secLabel}>{pay.steps[1].label}</p>
          <ul class="grid gap-1.5">
            {pay.decisions.map((x) => (
              <NotesItem kind="check" as="li">{x}</NotesItem>
            ))}
          </ul>
        </div>

        <div class="notes-in" data-notes-scene="payoff" style="--rd:.12s">
          <div class="flex items-center justify-between gap-3 mb-2">
            <p class="meeting-label text-muted">{pay.steps[2].label}</p>
            <BrandIcons brands={["trello"]} />
          </div>
          <ul class="divide-y divide-border">
            {pay.tasks.map((x) => (
              <NotesItem kind="task" as="li" class="py-1.5">
                <span class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                  <span class="min-w-0">{x.text}</span>
                  <span class="inline-flex items-center gap-1.5 text-[0.8125rem] text-muted">
                    <span class:list={["w-5 h-5 rounded-full grid place-items-center text-[0.625rem] font-semibold", tone[who(x.who)]]}>{x.who.slice(0, 1)}</span>
                    {x.who}
                  </span>
                </span>
              </NotesItem>
            ))}
          </ul>
        </div>

        <div class="notes-in" data-notes-scene="payoff" style="--rd:.24s">
          <p class={secLabel}>{pay.ask}</p>
          <div class="flex justify-end">
            <p class="max-w-[88%] rounded-[1rem] rounded-ee-[0.3rem] bg-accent text-accent-fg px-3.5 py-2 text-[0.9375rem] leading-snug">{pay.question}</p>
          </div>
          <div class="mt-2 flex">
            <div class="max-w-[92%] rounded-[1rem] rounded-es-[0.3rem] bg-surface-2 px-3.5 py-2.5 text-[0.9375rem] leading-snug text-foreground">
              {pay.answer}
              <span class="mt-1.5 flex items-center gap-1.5 text-xs text-muted tabular-nums">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                {pay.meetingTitle} · 31:46
              </span>
            </div>
          </div>
          <a
            href={localePath("/features/ai-summary", locale)}
            data-analytics-event="cta_clicked"
            data-analytics-location="scene_payoff"
            class="group mt-4 inline-flex items-center gap-2 text-[0.9375rem] font-medium text-accent hover:text-accent-strong transition-colors"
          >
            {pay.link}
            <Fragment set:html={arrow} />
          </a>
        </div>

      </div>
    </NotesCard>

    {/* Scene 4: languages. */}
    <Room variant="scene" as="div" data-scene-block="languages" class:list={[block, "lg:border-t lg:border-dashed lg:border-ink-line rounded-[1.75rem] sm:rounded-[2.25rem] lg:rounded-t-none"]}>
      <h2 id="scene-languages" class={h2}>
        {lang.title}
        <span class="block italic font-normal text-ink-accent">{lang.titleAccent}</span>
      </h2>
      <p class={body}>{lang.body}</p>
      <ul class="mt-8 grid gap-x-8 sm:grid-cols-2 max-w-[40rem]" aria-label={lang.title}>
        {lang.samples.map((s, i) => (
          <li class="flex items-baseline gap-4 py-3.5 border-b border-ink-line">
            <span class="shrink-0 w-7 font-mono text-[12px] text-ink-muted tabular-nums">{tags[i]}</span>
            <span class="font-display text-xl text-ink-fg" dir={i === 3 ? "rtl" : "ltr"} lang={sampleLang[i]}>{s}</span>
          </li>
        ))}
      </ul>
      <div slot="art" class="max-w-[26rem]">
        <SceneArt kind="languages" />
      </div>
    </Room>
  </div>
</section>

<style>
  /* A pinned card taller than the screen pins by its foot instead of its
     head, so its last lines stay in reach. --notes-h is measured below. */
  @media (min-width: 1024px) {
    :global(.notes-card[data-notes-pin]) {
      top: min(6rem, calc(100vh - var(--notes-h, 0px) - 1.25rem));
    }
  }
</style>

<script>
  // Notes written by the scenes. On lg+ (card pinned beside the room) a
  // scene's lines appear when that scene crosses the middle of the screen —
  // and with it every earlier scene's, so a jump never leaves gaps. Below lg
  // the card sits in the flow, so each line appears as it scrolls into view.
  // Reduced motion: global.css already shows every line in its final state.
  const root = document.querySelector<HTMLElement>("[data-meeting-scenes]");
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-notes-scene]")];
    const reveal = (els: HTMLElement[]) => els.forEach((el) => el.classList.add("revealed"));
    const wide = matchMedia("(min-width: 1024px)");
    if (!("IntersectionObserver" in window)) {
      reveal(items);
    } else if (wide.matches) {
      const order = ["offline", "online", "payoff", "languages"];
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const k = order.indexOf((e.target as HTMLElement).dataset.sceneBlock ?? "");
            reveal(items.filter((el) => order.indexOf(el.dataset.notesScene ?? "") <= k));
            io.unobserve(e.target);
          }
        },
        { rootMargin: "-30% 0px -45% 0px" },
      );
      root.querySelectorAll("[data-scene-block]").forEach((b) => io.observe(b));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("revealed");
            io.unobserve(e.target);
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );
      items.forEach((el) => io.observe(el));
    }
    // Height of the card, for its pinned offset (see the style above).
    const pin = root.querySelector<HTMLElement>("[data-notes-pin]");
    if (pin && "ResizeObserver" in window) {
      new ResizeObserver(() => pin.style.setProperty("--notes-h", `${pin.offsetHeight}px`)).observe(pin);
    }
    // The layout switched between pinned and stacked: show the notes whole.
    wide.addEventListener("change", () => reveal(items));
  }
</script>
