---
import type { Locale } from "../../i18n/ui";
import { t, appUrl, localePath } from "../../i18n/utils";
import { HOME_V2 } from "../../i18n/pages/home-v2";
import { meetingUi } from "../../i18n/pages/meeting-ui";
import Room from "../meeting/Room.astro";

/**
 * The opening room. The page is the meeting: the promise on the start side,
 * the call itself on the other — the visitor's tile (speaking), Dicta's tile
 * (writing), and the sample meeting's lines running as live captions under
 * them. The captions are decoration (aria-hidden): the same sample meeting is
 * real text in the notes further down.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const c = HOME_V2[locale].hero;
const m = meetingUi(locale);
const live = d.home.hero.live;
const bars = [0.45, 0.8, 0.35, 1, 0.6, 0.9, 0.4, 0.7];
---

<section class="px-3 sm:px-5 pt-3 sm:pt-5" aria-labelledby="hero-title">
  <Room variant="hero" as="div" class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] gap-12 lg:gap-14 items-center">
      <div>
        <p class="reveal text-sm font-medium text-ink-muted">{c.eyebrow}</p>
        <h1
          id="hero-title"
          class="reveal font-display text-ink-fg mt-5 text-[clamp(3rem,7.4vw,5.6rem)] leading-[0.96] tracking-[-0.035em] font-medium text-balance"
          style="--rd:.06s"
        >
          {c.title}
          <span class="block italic font-normal text-ink-accent">{c.titleAccent}</span>
        </h1>
        <p class="reveal mt-7 max-w-[46ch] text-lg text-ink-muted leading-relaxed" style="--rd:.12s">{c.sub}</p>

        <div class="reveal mt-9 flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3" style="--rd:.18s">
          <a
            href={appUrl("/sign-up")}
            data-analytics-event="signup_start_click"
            data-analytics-location="hero"
            class="group inline-flex items-center justify-center gap-2 min-h-[3.25rem] px-8 rounded-pill bg-ink-fg text-ink text-base font-semibold hover:bg-ink-accent active:scale-[0.98] transition-[background-color,transform] duration-200 ease-out-expo"
          >
            {d.home.startFree}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 ease-out-expo group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a
            href={localePath("/download", locale)}
            data-analytics-event="cta_clicked"
            data-analytics-location="hero_download"
            class="inline-flex items-center justify-center min-h-[3.25rem] px-7 rounded-pill border border-ink-line text-ink-fg text-base font-medium hover:bg-ink-2 transition-colors duration-150 ease-out-expo"
          >
            {c.download}
          </a>
        </div>
        <p class="reveal mt-5 text-sm text-ink-muted/80" style="--rd:.24s">{c.platforms}</p>
      </div>

      {/* The call: two tiles and the captions. */}
      <div class="reveal min-w-0" style="--rd:.2s">
        <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
          <div class="hero-tile relative aspect-[4/3.4] rounded-[1.1rem] bg-ink-2 ring-2 ring-ink-accent grid place-items-center">
            <span class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-ink-line grid place-items-center text-ink-fg font-display text-xl" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.5" r="3.6"></circle><path d="M5 20a7 7 0 0 1 14 0"></path></svg>
            </span>
            <span class="absolute start-3 bottom-2.5 meeting-label text-ink-fg" data-ui-label>{m.you}</span>
            <span class="absolute end-3 bottom-3 flex items-center gap-[2px] h-3.5" aria-hidden="true">
              {bars.slice(0, 4).map((h, i) => (
                <span class="wave-bar block w-[2px] rounded-full bg-ink-accent" style={`height:${Math.round(h * 14)}px;--wd:${(i * 0.12).toFixed(2)}s`}></span>
              ))}
            </span>
          </div>
          <div class="hero-tile relative aspect-[4/3.4] rounded-[1.1rem] bg-ink-2 grid place-items-center">
            <span class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-ink-fg grid place-items-center" aria-hidden="true">
              <img src="/logo.svg" alt="" width="370" height="319" decoding="async" class="h-6 sm:h-7 w-auto" />
            </span>
            <span class="absolute start-3 bottom-2.5 meeting-label text-ink-fg flex items-center gap-1.5" data-ui-label>
              {m.dicta}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-ink-accent"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
            </span>
          </div>
        </div>

        <ol class="mt-3 rounded-[1.1rem] bg-ink-2/60 ring-1 ring-inset ring-ink-line px-4 py-3.5 space-y-2.5 text-[0.9375rem] leading-snug" aria-hidden="true">
          {live.map((l, i) => (
            <li class="live-line flex gap-3" style={`--ld:${(0.9 + i * 1.1).toFixed(2)}s`}>
              <span class="flex-none w-11 font-mono text-[12px] leading-[1.35rem] text-ink-muted/80 tabular-nums" dir="ltr">{`00:${String(4 + i * 7).padStart(2, "0")}`}</span>
              <span class="min-w-0 text-ink-fg/90"><b class="font-semibold text-ink-accent">{l.who}</b> {l.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Room>
</section>
