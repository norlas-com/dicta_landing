---
import type { Locale } from "../../i18n/ui";
import { localePath } from "../../i18n/utils";
import { HOME_V2 } from "../../i18n/pages/home-v2";
import Room from "../meeting/Room.astro";
import SceneArt from "../meeting/SceneArt.astro";

/**
 * Who it is for: one more room, a lecture hall drawn in ink, with the
 * audiences as links into their use-case pages.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = HOME_V2[locale].audiences;
---

<section class="px-3 sm:px-5" aria-labelledby="scene-audiences">
  <Room variant="hero" as="div" class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-10 lg:gap-14 items-center">
      <div>
        <h2 id="scene-audiences" class="reveal font-display text-ink-fg text-[clamp(2.2rem,4.4vw,3.6rem)] leading-[1.03] tracking-[-0.03em] font-medium text-balance max-w-[16ch]">
          {c.title}
          <span class="block italic font-normal text-ink-accent">{c.titleAccent}</span>
        </h2>
        <p class="reveal mt-6 text-lg text-ink-muted max-w-[44ch]" style="--rd:.06s">{c.body}</p>
        <ul class="reveal mt-9 flex flex-wrap gap-2.5" style="--rd:.12s">
          {c.items.map((it) => (
            <li>
              <a
                href={localePath(`/use-cases/${it.slug}`, locale)}
                data-analytics-event="cta_clicked"
                data-analytics-location={`audience_${it.slug}`}
                class="inline-flex items-center min-h-11 px-5 py-2 rounded-pill border border-ink-line text-ink-fg text-base font-medium hover:bg-ink-fg hover:text-ink hover:border-ink-fg transition-colors duration-200 ease-out-expo"
              >
                {it.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal max-w-[30rem] w-full lg:justify-self-end" style="--rd:.1s">
        <SceneArt kind="audience" />
      </div>
    </div>
  </Room>
</section>
