---
import { Image } from "astro:assets";
import type { Locale } from "../../i18n/ui";
import { localePath } from "../../i18n/utils";
import { HOME_V2 } from "../../i18n/pages/home-v2";
import { PHOTOS } from "../../lib/photos";

/**
 * Offline meetings, Dicta's niche: a real table, a phone on it, voices told
 * apart. The photo carries the scene; two small product moments land on it
 * once it is on screen (the recorder, then each speaker as Dicta hears them).
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = HOME_V2[locale].offline;
const p = PHOTOS.boardroom;
const tint = ["bg-[oklch(0.62_0.14_200)]", "bg-[oklch(0.64_0.16_45)]", "bg-[oklch(0.58_0.14_150)]"];
---

<section class="relative py-24 sm:py-32 lg:py-40" aria-labelledby="scene-offline">
  <div class="max-w-6xl mx-auto px-6 lg:px-10 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] gap-14 lg:gap-20 items-center">
    <div>
      <p class="reveal text-sm font-medium text-accent">{c.kicker}</p>
      <h2 id="scene-offline" class="reveal font-display text-foreground mt-5 text-[clamp(2.3rem,4.6vw,3.9rem)] leading-[1.02] tracking-[-0.03em] font-medium text-balance" style="--rd:.06s">
        {c.title}
        <span class="block italic font-normal text-accent">{c.titleAccent}</span>
      </h2>
      <p class="reveal mt-7 text-lg text-muted leading-relaxed max-w-[44ch]" style="--rd:.12s">{c.body}</p>
      <p class="reveal mt-4 text-base text-muted-soft leading-relaxed max-w-[44ch]" style="--rd:.16s">{c.roundTable}</p>
      <a
        href={localePath("/use-cases/offline-meetings", locale)}
        data-analytics-event="cta_clicked"
        data-analytics-location="scene_offline"
        class="reveal group mt-8 inline-flex items-center gap-2 text-base font-medium text-foreground hover:text-accent transition-colors"
        style="--rd:.2s"
      >
        {c.link}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 ease-out-expo group-hover:translate-x-0.5 rtl:-scale-x-100"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>

    <div class="reveal-shot relative">
      <div class="relative overflow-hidden rounded-[2rem] aspect-[4/3.4] shadow-shot">
        <Image src={p.src} width={p.width} height={p.height} alt={c.photoAlt} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 40rem, 100vw" loading="lazy" class="photo-ink absolute inset-0 w-full h-full object-cover" />
        <div class="photo-ink-overlay absolute inset-0" aria-hidden="true"></div>
      </div>

      {/* The recorder on the table. */}
      <div class="beat absolute -bottom-7 start-4 sm:start-8 flex items-center gap-3 h-14 ps-4 pe-5 rounded-pill bg-surface border border-border shadow-pop" style="--bd:.5s" aria-hidden="true">
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full rounded-full bg-live opacity-60 animate-ping"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-live"></span>
        </span>
        <span class="text-sm font-medium text-foreground">{c.recording}</span>
        <span class="text-sm text-muted tabular-nums">48:12</span>
      </div>

      {/* Voices, told apart. */}
      <ul class="absolute top-5 end-5 sm:top-7 sm:end-7 flex flex-col items-end gap-2" aria-hidden="true">
        {c.speakers.map((name, i) => (
          <li class="beat inline-flex items-center gap-2 h-9 ps-1.5 pe-3.5 rounded-pill bg-surface/95 border border-border shadow-card text-sm font-medium text-foreground" style={`--bd:${0.8 + i * 0.35}s`}>
            <span class:list={["w-6 h-6 rounded-full grid place-items-center text-2xs font-semibold text-ink-fg font-sans", tint[i]]}>{name.slice(0, 1)}</span>
            {name}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
