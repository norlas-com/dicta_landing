---
import type { Locale } from "../i18n/ui";
import { t, localePath } from "../i18n/utils";
import type { FaqItem } from "../lib/faq";

/**
 * FAQ accordion on native <details>/<summary>: keyboard and screen-reader
 * accessible with no script, and every answer stays in the HTML for crawlers.
 *
 * `home` adds the section heading and a link to the full /faq page; the /faq
 * page renders the bare list under its own <h1>.
 */
interface Props {
  locale: Locale;
  items: FaqItem[];
  home?: boolean;
}
const { locale, items, home = false } = Astro.props;
const f = t(locale).faq;
---

<section id={home ? "faq" : undefined} class:list={[home && "relative scroll-mt-20"]}>
  <div class:list={["relative max-w-3xl mx-auto px-6 lg:px-10", home ? "py-20 lg:py-24" : "pb-24"]}>
    {
      home && (
        <div class="reveal max-w-2xl">
          <p class="text-sm font-medium text-accent mb-4">{f.eyebrow}</p>
          <h2 class="font-display text-[2.2rem] sm:text-[3rem] font-semibold tracking-[-0.025em] leading-[1.08] text-foreground text-balance">
            <span class="block">{f.headingPre}</span>
            <span class="block text-accent">{f.headingAccent}</span>
          </h2>
          <p class="text-base sm:text-lg text-muted mt-5 max-w-[56ch] leading-relaxed">{f.sub}</p>
        </div>
      )
    }

    <div class:list={["space-y-3", home && "mt-10"]}>
      {
        items.map((item) => (
          <details class="group rounded-card border border-border bg-surface open:shadow-card transition-colors duration-150 ease-out-expo">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-card px-5 py-4 text-start font-medium text-foreground hover:text-accent transition-colors duration-150 ease-out-expo [&::-webkit-details-marker]:hidden"
              data-analytics-event="faq_opened"
              data-analytics-question={item.key}
            >
              <span>{item.q}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="shrink-0 text-muted transition-transform duration-200 ease-out-expo group-open:rotate-180"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-muted leading-relaxed">
              <p>{item.a}</p>
              {item.more && (
                <p class="mt-3">
                  <a href={item.more.href} class="text-accent hover:text-accent-strong font-medium">
                    {item.more.label}
                  </a>
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>

    {
      home && (
        <p class="mt-8">
          <a
            href={localePath("/faq", locale)}
            data-analytics-event="nav_clicked"
            data-analytics-item="faq_all"
            class="text-accent hover:text-accent-strong font-medium"
          >
            {f.allLabel}
          </a>
        </p>
      )
    }
  </div>
</section>
