---
import type { Locale } from "../i18n/ui";
import { t, localePath } from "../i18n/utils";
import type { FaqItem } from "../lib/faq";
import { meetingUi } from "../i18n/pages/meeting-ui";

/**
 * FAQ accordion on native <details>/<summary>: keyboard and screen-reader
 * accessible with no script, and every answer stays in the HTML for crawlers.
 *
 * `home` adds the section heading and a link to the full /faq page; the /faq
 * page renders the bare list under its own <h1>.
 */
interface Props {
  locale: Locale;
  items: FaqItem[];
  home?: boolean;
}
const { locale, items, home = false } = Astro.props;
const f = t(locale).faq;
const m = meetingUi(locale);
---

<section id={home ? "faq" : undefined} class:list={[home && "relative scroll-mt-20"]}>
  <div class:list={["relative max-w-3xl mx-auto", home ? "px-6 lg:px-10 py-14 sm:py-20 lg:py-24" : "px-3 sm:px-5 pb-24"]}>
    {
      home && (
        <div class="reveal max-w-2xl">
          <p class="text-sm font-medium text-accent mb-4">{f.eyebrow}</p>
          <h2 class="font-display text-[clamp(2.3rem,4.6vw,3.6rem)] font-medium tracking-[-0.03em] leading-[1.04] text-foreground text-balance">
            <span class="block">{f.headingPre}</span>
            <span class="block italic font-normal text-accent">{f.headingAccent}</span>
          </h2>
          <p class="text-base sm:text-lg text-muted mt-5 max-w-[56ch] leading-relaxed">{f.sub}</p>
        </div>
      )
    }

    <div class:list={["notes-card relative min-w-0 bg-surface text-foreground rounded-card border border-border shadow-card px-5 pt-4 pb-6 sm:px-7 sm:pt-5 sm:pb-7", home && "mt-10"]}>
      <p class="meeting-label flex items-center gap-2 text-muted pb-3.5 mb-5 border-b border-dashed border-border" data-ui-label>
        <img src="/logo.svg" alt="" width="370" height="319" decoding="async" class="h-3 w-auto flex-none" />
        <span>{m.dicta} · {m.notesLive}</span>
      </p>
      {
        items.map((item) => (
          <details class="group border-b border-dashed border-border last:border-b-0">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-start font-display text-lg font-medium leading-snug text-foreground hover:text-accent transition-colors duration-150 ease-out-expo [&::-webkit-details-marker]:hidden"
              data-analytics-event="faq_opened"
              data-analytics-question={item.key}
            >
              <span>{item.q}</span>
              <span aria-hidden="true" class="shrink-0 grid place-items-center w-6 h-6 rounded-[6px] border border-border-strong text-accent transition-transform duration-200 ease-out-expo group-open:rotate-45">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 1.5v9M1.5 6h9" /></svg>
              </span>
            </summary>
            <div class="pb-5 text-muted leading-relaxed">
              <p>{item.a}</p>
              {item.more && (
                <p class="mt-3">
                  <a href={item.more.href} class="text-accent hover:text-accent-strong font-medium">
                    {item.more.label}
                  </a>
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>

    {
      home && (
        <p class="mt-8">
          <a
            href={localePath("/faq", locale)}
            data-analytics-event="nav_clicked"
            data-analytics-item="faq_all"
            class="text-accent hover:text-accent-strong font-medium"
          >
            {f.allLabel}
          </a>
        </p>
      )
    }
  </div>
</section>
