---
/**
 * One line of the notes: a decision (✓), an open task (☐) or plain text.
 * The glyph is decoration; `who` ("Rustam", "You") is a UI label; the slot is
 * the real copy and may hold its own heading.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  kind: "check" | "task" | "text";
  who?: string;
  as?: "div" | "li";
  class?: string;
}
const { kind, who, as: Tag = "div", class: className, ...rest } = Astro.props;
---

<Tag
  data-notes-item={kind}
  class:list={[
    "notes-item flex items-start gap-3 text-[0.9375rem] leading-[1.6] text-foreground-soft",
    className,
  ]}
  {...rest}
>
  {
    kind === "check" && (
      <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="flex-none mt-[0.22em] text-accent">
        <path d="M3 8.5l3.2 3L13 4.5" />
      </svg>
    )
  }
  {kind === "task" && <span aria-hidden="true" class="notes-box mt-[0.3em]" />}
  <div class="min-w-0 flex-1">
    {who && <b data-ui-label class="font-semibold text-foreground">{who}:</b>} <slot />
  </div>
</Tag>
