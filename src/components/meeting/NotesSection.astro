---
/** One section of the notes: a mono label (SUMMARY, DECISIONS, TASKS…) and
 *  its lines. */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  label: string;
  class?: string;
}
const { label, class: className, ...rest } = Astro.props;
---

<div class:list={["notes-section mt-6 first:mt-0", className]} {...rest}>
  <p class="meeting-label text-muted mb-3" data-ui-label>{label}</p>
  <slot />
</div>
