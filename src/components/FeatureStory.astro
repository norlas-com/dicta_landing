---
import type { Locale } from "../i18n/ui";
import { t, localePath } from "../i18n/utils";
import FeatureScreen from "./FeatureScreen.astro";
import FeatureCloser from "./FeatureCloser.astro";
import NotetakerShowcase from "./NotetakerShowcase.astro";

import f1 from "../assets/landing/f1-dicta-meet.jpg";
import f2 from "../assets/landing/f2-transcription.jpg";
import f3 from "../assets/landing/f3-ai-summary.jpg";
import f4 from "../assets/landing/f4-tasks.jpg";
import f5 from "../assets/landing/f5-bots.jpg";
import f6 from "../assets/landing/f6-desktop.jpg";
import f7 from "../assets/landing/f7-mobile.jpg";

/**
 * The scroll-driven feature story: 7 one-viewport screens (Problem → Our
 * solution → full-bleed photo, alternating sides) plus the pricing closer.
 * `data-feature-story` enables mandatory root-scroller snap (global.css);
 * the fixed dot rail and the up/down arrow rail track and page between
 * screens; each screen re-animates its content whenever it becomes active.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const f = d.landing.features;
const labels = { problem: f.problemLabel, solution: f.solutionLabel };

const screens = [
  { ...f.f1, image: f1, brands: ["meet", "zoom", "teams"] },
  { ...f.f2, image: f2, brands: undefined },
  { ...f.f3, image: f3, brands: undefined },
  { ...f.f4, image: f4, brands: ["jira", "trello", "asana", "clickup"] },
  { ...f.f5, image: f5, brands: ["zoom", "meet", "teams"] },
  { ...f.f6, image: f6, brands: undefined },
  { ...f.f7, image: f7, brands: undefined },
];

const dotLabels = [...screens.map((s) => s.title), `${f.closer.titlePre} ${f.closer.titleAccent}`];
---

<div data-feature-story>
  {
    screens.map((s, i) => (
      <FeatureScreen
        index={i + 1}
        id={`feature-${i + 1}`}
        title={s.title}
        problem={s.problem}
        solution={s.solution}
        image={s.image}
        alt={s.alt}
        flip={i % 2 === 1}
        labels={labels}
        brands={s.brands}
      >
        {i === 4 && (
          <div slot="visual" class="hidden lg:block absolute bottom-8 left-8 w-80 drop-shadow-xl">
            <NotetakerShowcase locale={locale} />
          </div>
        )}
        {i === 5 && (
          <a
            slot="cta"
            href={localePath("/download", locale)}
            data-download-label
            data-win-label={d.nav.downloadWin}
            data-analytics-event="download_app_clicked"
            data-analytics-os="na"
            data-analytics-arch="na"
            class="inline-flex items-center gap-2 h-12 px-7 rounded-pill bg-accent text-accent-fg font-medium hover:bg-accent-strong transition-colors duration-150 ease-out-expo"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span data-download-text>{f.f6cta}</span>
          </a>
        )}
        {/* f7 is the mobile-app screen. It described the apps for months with
            nothing to tap — this is the one place on the page where a reader
            has just been told what the phone app does. */}
        {i === 6 && (
          <a
            slot="cta"
            href={localePath("/download", locale)}
            data-analytics-event="download_app_clicked"
            data-analytics-os="mobile"
            data-analytics-arch="na"
            class="inline-flex items-center gap-2 h-12 px-7 rounded-pill bg-accent text-accent-fg font-medium hover:bg-accent-strong transition-colors duration-150 ease-out-expo"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="2" width="14" height="20" rx="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
            {f.f7cta}
          </a>
        )}
      </FeatureScreen>
    ))
  }

  <FeatureCloser locale={locale} />

  <nav
    data-feature-dots
    aria-label={f.dotsLabel}
    class="feature-dots fixed right-4 lg:right-6 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col gap-2.5 p-2 rounded-pill bg-background/55 backdrop-blur-sm border border-border/60 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    {
      dotLabels.map((label, i) => (
        <button
          type="button"
          data-dot={i}
          aria-label={label}
          class:list={[
            "w-2.5 h-2.5 rounded-full transition-all duration-300",
            i === 0 ? "bg-accent scale-125" : "bg-foreground/25 hover:bg-foreground/50",
          ]}
        ></button>
      ))
    }
  </nav>

  <div
    data-feature-arrows
    class="feature-arrows fixed right-4 lg:right-6 bottom-5 lg:bottom-8 z-40 flex flex-col gap-2 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <button
      type="button"
      data-arrow="-1"
      aria-label={f.prevLabel}
      class="grid place-items-center w-11 h-11 rounded-full border border-border bg-background/70 backdrop-blur-sm text-foreground shadow-card hover:bg-surface-2 hover:border-border-strong active:scale-95 transition-all duration-150 ease-out-expo disabled:opacity-35 disabled:pointer-events-none"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <button
      type="button"
      data-arrow="1"
      aria-label={f.nextLabel}
      class="grid place-items-center w-11 h-11 rounded-full border border-border bg-background/70 backdrop-blur-sm text-foreground shadow-card hover:bg-surface-2 hover:border-border-strong active:scale-95 transition-all duration-150 ease-out-expo disabled:opacity-35 disabled:pointer-events-none"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
  </div>
</div>

<script>
  import { track } from "../lib/analytics";
  const story = document.querySelector("[data-feature-story]");
  if (story) {
    const screens = [...story.querySelectorAll("[data-screen]")];
    const dotsNav = story.querySelector("[data-feature-dots]");
    const dots = dotsNav ? [...dotsNav.querySelectorAll("[data-dot]")] : [];
    const arrowsBox = story.querySelector("[data-feature-arrows]");
    const arrows = arrowsBox ? [...arrowsBox.querySelectorAll<HTMLButtonElement>("[data-arrow]")] : [];
    let active = 0;
    // Fire feature_section_viewed once per section per page-load.
    const seen = new Set<number>();

    const setActive = (i: number) => {
      active = i;
      if (!seen.has(i)) {
        seen.add(i);
        track("feature_section_viewed", {
          index: i,
          title: dots[i]?.getAttribute("aria-label") ?? "",
        });
      }
      screens.forEach((s, idx) => s.classList.toggle("is-active", idx === i));
      dots.forEach((dot, idx) => {
        const on = idx === i;
        dot.classList.toggle("bg-accent", on);
        dot.classList.toggle("scale-125", on);
        dot.classList.toggle("bg-foreground/25", !on);
        dot.classList.toggle("hover:bg-foreground/50", !on);
        if (on) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      arrows.forEach((btn) => {
        const dir = Number(btn.dataset.arrow);
        // The up arrow keeps working on the first screen (it returns to the
        // hero); only the down arrow dead-ends on the last screen.
        btn.disabled = dir === 1 && i === screens.length - 1;
      });
    };

    // A screen becomes active when it crosses the middle band of the viewport.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(screens.indexOf(e.target));
        }
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
    );
    screens.forEach((s) => io.observe(s));

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        track("feature_nav_clicked", { index: i });
        screens[i]?.scrollIntoView({ block: "start" });
      });
    });

    arrows.forEach((btn) => {
      btn.addEventListener("click", () => {
        const dir = Number(btn.dataset.arrow);
        track("feature_nav_clicked", { direction: dir === 1 ? "next" : "prev" });
        if (active === 0 && dir === -1) {
          window.scrollTo({ top: 0 });
          return;
        }
        screens[active + dir]?.scrollIntoView({ block: "start" });
      });
    });

    // The rails only show while the story is on screen (hero, pricing and
    // footer stay clean).
    const rails = [dotsNav, arrowsBox].filter(Boolean) as Element[];
    if (rails.length) {
      const vis = new IntersectionObserver(
        ([e]) => {
          rails.forEach((el) => {
            el.classList.toggle("opacity-0", !e.isIntersecting);
            el.classList.toggle("pointer-events-none", !e.isIntersecting);
          });
        },
        { threshold: 0.04 },
      );
      vis.observe(story);
    }
  }

  // OS-aware download label on the screen-6 CTA (generic default; swap to the
  // Windows label when detected) — same pattern the header button used.
  const isWin = /Win(dows|32|64|CE)/i.test(navigator.userAgent);
  if (isWin) {
    document.querySelectorAll("[data-download-label]").forEach((el) => {
      const win = el.getAttribute("data-win-label");
      const text = el.querySelector("[data-download-text]");
      if (win && text) text.textContent = win;
    });
  }
</script>
