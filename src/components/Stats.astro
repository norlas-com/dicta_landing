---
import type { Locale } from "../i18n/ui";
import { t } from "../i18n/utils";
import type { UsageStats } from "../lib/stats";

/**
 * A quiet strip between the opening room and the meeting: real usage so far,
 * said as one sentence rather than a row of metric tiles. Numbers come from
 * api.dicta.uz/v1/public/stats at build time (lib/stats.ts) and count up once
 * when the strip scrolls into view; the final value is in the HTML, so no-JS
 * and reduced-motion visitors see it.
 */
interface Props {
  locale: Locale;
  stats: UsageStats;
}
const { locale, stats } = Astro.props;
const s = t(locale).home.stats;

const intlLocale = locale === "uz" ? "uz-Latn-UZ" : locale;
const fmt = new Intl.NumberFormat(intlLocale);
const date = new Intl.DateTimeFormat(intlLocale, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(
  new Date(`${stats.asOf}T00:00:00Z`),
);

// Labels are either a plain word or plural forms keyed by CLDR category,
// "one:час|few:часа|many:часов|other:часа", so the noun agrees with whatever
// number the API returns on the next rebuild.
const plural = new Intl.PluralRules(intlLocale);
const noun = (label: string, n: number) => {
  if (!label.includes(":")) return label;
  const forms = Object.fromEntries(label.split("|").map((f) => f.split(":") as [string, string]));
  return forms[plural.select(n)] ?? forms.other;
};

const parts: { n: number; label: string }[] = [
  { n: stats.hours, label: noun(s.hours, stats.hours) },
  { n: stats.meetings, label: noun(s.meetings, stats.meetings) },
  { n: stats.users, label: noun(s.users, stats.users) },
];
---

<section aria-labelledby="stats-title" class="px-3 sm:px-5">
  <div class="max-w-6xl mx-auto px-3 sm:px-5 lg:px-14 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] gap-x-12 gap-y-4 items-baseline">
    <div class="reveal flex items-center gap-2.5">
      <span class="w-2 h-2 rounded-full bg-accent flex-none" aria-hidden="true"></span>
      <h2 id="stats-title" class="text-sm font-semibold text-foreground">{s.eyebrow}</h2>
    </div>

    <div>
      <p class="reveal font-display text-foreground text-[1.55rem] leading-[1.32] sm:text-[1.95rem] lg:text-[2.2rem] lg:leading-[1.24] tracking-[-0.015em] max-w-[32ch] text-balance" style="--rd:.06s" data-stats data-intl={intlLocale}>
        {/* One line on purpose: a line break between these expressions renders
            as a space before the commas and the final period. */}
        {s.pre}{parts.map((p, i) => (<><span class="whitespace-nowrap"><span class="font-sans font-semibold tabular-nums text-accent" data-count={p.n}>{fmt.format(p.n)}</span> {p.label}</span>{i === 0 ? s.sep1 : i === 1 ? s.sep2 : ""}</>))}{s.post}
      </p>

      <div class="reveal mt-5 flex flex-wrap items-center gap-x-6 gap-y-1.5 text-sm text-muted" style="--rd:.12s">
        <span class="tabular-nums">{s.updated.replace("{date}", date)}</span>
        <span>{s.footnote}</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Count up once, the first time the sentence is on screen.
  const el = document.querySelector<HTMLElement>("[data-stats]");
  if (el && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const nums = [...el.querySelectorAll<HTMLElement>("[data-count]")];
    // The build formatted the final numbers for this locale; land on exactly
    // that text, whatever the browser's own number format is.
    const finals = nums.map((n) => n.textContent);
    const fmt = new Intl.NumberFormat(el.dataset.intl || document.documentElement.lang || undefined);
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const start = performance.now();
        const dur = 1600;
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - p, 4);
          for (const n of nums) n.textContent = fmt.format(Math.round(Number(n.dataset.count) * eased));
          if (p < 1) requestAnimationFrame(tick);
          else nums.forEach((n, i) => (n.textContent = finals[i]));
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  }
</script>
