---
import type { ImageMetadata } from "astro";
import type { Locale } from "../i18n/ui";
import { t, localePath } from "../i18n/utils";
import Shot from "./Shot.astro";
import BrandIcons from "./BrandIcons.astro";
import StoreBadges from "./StoreBadges.astro";

/**
 * What Dicta does, in three acts with the real product beside each one
 * (capture → transcript → summary and tasks), then where it runs. Screenshots
 * are captures of the app with a demo workspace, not mockups.
 */
interface ShotPair {
  light: ImageMetadata;
  dark?: ImageMetadata;
}
interface Props {
  locale: Locale;
  shots: { capture: ShotPair; transcript: ShotPair; summary: ShotPair; mobile: ShotPair };
}
const { locale, shots } = Astro.props;
const f = t(locale).home.features;

const acts = [
  { ...f.capture, shot: shots.capture, brands: ["meet", "zoom", "teams"] },
  { ...f.transcript, shot: shots.transcript, brands: undefined },
  { ...f.summary, shot: shots.summary, brands: ["jira", "trello", "asana", "clickup"] },
];
---

<section id="features" aria-labelledby="features-title" class="relative scroll-mt-20 overflow-x-clip">
  <div class="max-w-6xl mx-auto px-6 lg:px-10 pt-20 lg:pt-32">
    <div class="max-w-2xl">
      <h2 id="features-title" class="reveal font-display text-[2.2rem] sm:text-[3rem] font-semibold leading-[1.08] tracking-[-0.025em] text-foreground text-balance">
        {f.titlePre} <span class="text-accent">{f.titleAccent}</span>
      </h2>
      <p class="reveal text-lg text-muted mt-5 max-w-[52ch] leading-relaxed" style="--rd:.08s">{f.sub}</p>
    </div>

    <div class="mt-16 lg:mt-24 space-y-24 lg:space-y-36">
      {
        acts.map((a, i) => (
          <article class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
            <div class:list={["lg:col-span-5", i % 2 === 1 && "lg:order-2 lg:col-start-8"]}>
              <p class="reveal flex items-baseline gap-3 text-sm font-medium text-accent">
                <span class="font-display text-3xl font-semibold tabular-nums leading-none">0{i + 1}</span>
                {a.kicker}
              </p>
              <h3 class="reveal font-display text-[1.9rem] sm:text-[2.3rem] font-semibold leading-[1.12] tracking-[-0.02em] text-foreground mt-4 text-balance" style="--rd:.05s">
                {a.title}
              </h3>
              <p class="reveal text-base sm:text-lg text-muted mt-4 leading-relaxed max-w-[46ch]" style="--rd:.1s">{a.body}</p>
              <ul class="reveal mt-6 space-y-2.5" style="--rd:.15s">
                {a.points.map((pt) => (
                  <li class="flex gap-3 text-foreground-soft">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-1 shrink-0 text-accent">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
              {a.brands && (
                <div class="reveal mt-7" style="--rd:.2s">
                  <BrandIcons brands={a.brands} />
                </div>
              )}
            </div>
            <div class:list={["lg:col-span-7", i % 2 === 1 ? "lg:order-1 lg:col-start-1 lg:-ms-[12%]" : "lg:-me-[12%]"]}>
              <Shot light={a.shot.light} dark={a.shot.dark} alt={a.alt} sizes="(min-width: 1024px) 44rem, calc(100vw - 3rem)" class="reveal-shot" />
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* Where it runs: the phone, the desktop, the browser. */}
  <div class="max-w-6xl mx-auto px-6 lg:px-10 pt-24 lg:pt-36 pb-20 lg:pb-28">
    <div class="relative grid md:grid-cols-[minmax(0,1fr)_auto] gap-10 lg:gap-20 items-center rounded-panel bg-surface-2 border border-border px-6 sm:px-10 lg:px-14 pt-10 md:py-0 overflow-hidden">
      <div class="md:py-14">
        <p class="reveal text-sm font-medium text-accent">{f.apps.kicker}</p>
        <h3 class="reveal font-display text-[1.9rem] sm:text-[2.3rem] font-semibold leading-[1.12] tracking-[-0.02em] text-foreground mt-3 max-w-[20ch] text-balance" style="--rd:.05s">
          {f.apps.title}
        </h3>
        <p class="reveal text-base sm:text-lg text-muted mt-4 leading-relaxed max-w-[48ch]" style="--rd:.1s">{f.apps.body}</p>
        <div class="reveal mt-7 flex flex-col gap-4" style="--rd:.15s">
          <StoreBadges locale={locale} location="features_apps" />
          <a
            href={localePath("/download", locale)}
            data-analytics-event="download_app_clicked"
            data-analytics-os="na"
            data-analytics-arch="na"
            class="group inline-flex items-center gap-2 w-fit text-base font-medium text-foreground hover:text-accent transition-colors duration-150 ease-out-expo"
          >
            {f.apps.desktop}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 ease-out-expo group-hover:translate-x-0.5 rtl:-scale-x-100">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="w-[15.5rem] sm:w-[17rem] mx-auto md:mx-0 md:self-end md:translate-y-10 -mb-24 md:mb-0">
        <Shot mobile light={shots.mobile.light} dark={shots.mobile.dark} alt={f.apps.alt} sizes="17rem" class="reveal-shot" />
      </div>
    </div>
  </div>
</section>
