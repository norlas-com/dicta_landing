---
import type { ImageMetadata } from "astro";
import type { Locale } from "../i18n/ui";
import { t, appUrl, localePath } from "../i18n/utils";
import Shot from "./Shot.astro";

/**
 * Hero: the promise on the left, the real product on the right. The recap
 * screenshot bleeds past the container edge on wide screens; a small live
 * transcript card overlaps it to show what happens DURING the call, the
 * screenshot shows what you get AFTER it.
 */
interface Props {
  locale: Locale;
  shot: ImageMetadata;
  shotDark?: ImageMetadata;
}
const { locale, shot, shotDark } = Astro.props;
const d = t(locale);
const h = d.home.hero;
const home = localePath("/", locale);
---

<section class="relative overflow-hidden">
  {/* Paper grain: a faint ruled-notebook grid, fading out from the top. */}
  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none opacity-[0.5] dark:opacity-[0.35]"
    style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px); background-size: 100% 34px; -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 70%); mask-image: linear-gradient(to bottom, #000 0%, transparent 70%);"
  ></div>

  <div class="relative max-w-6xl mx-auto px-6 lg:px-10 pt-12 sm:pt-16 lg:pt-24 pb-16 lg:pb-28">
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-12 lg:gap-14 items-center">
      <div class="relative z-10">
        <p class="reveal inline-flex items-center gap-2 text-sm font-medium text-accent mb-6">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-live opacity-60 animate-ping"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-live"></span>
          </span>
          {h.eyebrow}
        </p>

        <h1 class="reveal font-display font-semibold text-foreground text-balance text-[2.75rem] leading-[1.04] sm:text-[3.6rem] lg:text-[4.4rem] tracking-[-0.03em]" style="--rd:.06s">
          {h.titlePre} <em class="not-italic text-accent">{h.titleAccent}</em>
        </h1>

        <p class="reveal text-lg text-muted mt-6 max-w-[46ch] leading-relaxed" style="--rd:.14s">
          {h.sub}
        </p>

        <div class="reveal mt-9 flex flex-col sm:flex-row sm:flex-wrap gap-3" style="--rd:.22s">
          <a
            href={appUrl("/sign-up")}
            data-analytics-event="signup_start_click"
            data-analytics-location="hero"
            class="group inline-flex items-center justify-center gap-2 whitespace-nowrap h-[3.25rem] px-8 rounded-pill bg-accent text-accent-fg text-base font-semibold shadow-glow hover:bg-accent-strong active:scale-[0.98] transition-[background-color,transform] duration-200 ease-out-expo"
          >
            {d.home.startFree}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 ease-out-expo group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a
            href={`${home === "/" ? "" : home}/#contact`}
            data-analytics-event="cta_clicked"
            data-analytics-location="hero_contact"
            class="inline-flex items-center justify-center whitespace-nowrap h-[3.25rem] px-7 rounded-pill border border-border-strong text-foreground text-base font-medium hover:bg-surface-2 transition-colors duration-150 ease-out-expo"
          >
            {h.ctaSecondary}
          </a>
        </div>

        <p class="reveal mt-5 text-sm text-muted-soft" style="--rd:.28s">{h.note}</p>
      </div>

      <div class="relative lg:-me-[22%] xl:-me-[30%]">
        <Shot light={shot} dark={shotDark} alt={h.shotAlt} eager sizes="(min-width: 1280px) 52rem, (min-width: 1024px) 46rem, calc(100vw - 3rem)" class="reveal-shot" />

        {/* What happens during the call. Lines are this locale's sample
            conversation; they type in once, then stay. */}
        <div
          class="reveal absolute -bottom-10 start-3 sm:start-[-1.5rem] lg:start-[-3rem] w-[min(18.5rem,calc(100%-1.5rem))] rounded-card border border-border bg-surface shadow-pop p-4"
          style="--rd:.5s"
          aria-hidden="true"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center gap-2 text-2xs font-semibold uppercase tracking-[0.14em] text-live">
              <span class="w-1.5 h-1.5 rounded-full bg-live animate-pulse"></span>
              {h.liveLabel}
            </span>
            <span class="text-2xs text-muted-soft tabular-nums">12:04</span>
          </div>
          <ul class="space-y-2.5 text-[0.8125rem] leading-snug">
            {
              h.live.map((l, i) => (
                <li class="live-line flex gap-2.5" style={`--ld:${1.1 + i * 0.9}s`}>
                  <span class="mt-0.5 grid place-items-center shrink-0 w-6 h-6 rounded-full bg-accent-soft text-accent text-2xs font-semibold font-sans">{l.who.slice(0, 1)}</span>
                  <span>
                    <span class="block text-2xs font-semibold text-foreground-soft">{l.who}</span>
                    <span class="text-foreground">{l.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
