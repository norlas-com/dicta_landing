---
import type { Locale } from "../i18n/ui";
import { t } from "../i18n/utils";

/**
 * Customer proof strip under the hero (dicta.uz only — HomePage gates it).
 * Premier is a real customer that records all of its online and offline
 * meetings with Dicta. There is deliberately no quote and no metric: the one
 * claim is the sentence in the dictionary.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale).trust;

const CUSTOMER_URL = "https://premier.uz/";

// LOGO DROP-IN: when we have Premier's logo file, put it in public/ and set the
// path here (e.g. "/customers/premier.svg"). The text wordmark below is then
// replaced by the image; nothing else needs to change.
const CUSTOMER_LOGO: string | null = null;
---

<section aria-label={tr.eyebrow} class="relative">
  <div class="max-w-6xl mx-auto px-6 lg:px-10 pb-16 lg:pb-20">
    <div class="reveal flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8 rounded-panel border border-border bg-surface/70 backdrop-blur-sm px-6 py-6 sm:px-8">
      <div class="shrink-0">
        <span class="block text-2xs uppercase tracking-[0.18em] text-muted-soft mb-2">{tr.eyebrow}</span>
        <a
          href={CUSTOMER_URL}
          target="_blank"
          rel="noopener"
          aria-label={tr.linkLabel}
          data-analytics-event="outbound_click"
          data-analytics-url="premier.uz"
          class="inline-block transition-opacity duration-150 ease-out-expo hover:opacity-80"
        >
          {
            CUSTOMER_LOGO ? (
              <img src={CUSTOMER_LOGO} alt="Premier" class="h-8 w-auto" />
            ) : (
              <span class="font-display text-3xl font-semibold tracking-tight text-foreground">Premier</span>
            )
          }
        </a>
      </div>
      <span aria-hidden="true" class="hidden sm:block self-stretch w-px bg-border"></span>
      <p class="text-base sm:text-lg text-foreground-soft leading-relaxed max-w-[56ch]">{tr.lead}</p>
    </div>
  </div>
</section>
