---
import type { Locale } from "../i18n/ui";
import { t } from "../i18n/utils";

/**
 * The story's final screen: a giant typographic statement ("all of this at
 * the lowest price on the market") with a hero-style aurora backdrop that
 * bookends the page, flowing straight into #pricing below.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale).landing.features.closer;
---

<section id="feature-8" data-screen class="feature-screen relative flex items-center overflow-hidden">
  <div
    aria-hidden="true"
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1100px] h-[680px] pointer-events-none opacity-[0.2] dark:opacity-[0.28] blur-[90px] bg-brand-gradient bg-[length:200%_200%] animate-gradient-shimmer"
  ></div>

  <div class="relative w-full max-w-4xl mx-auto px-6 lg:px-10 py-20 text-center">
    <h2 class="reveal font-display text-[2.6rem] sm:text-[3.4rem] lg:text-[4.2rem] font-semibold tracking-[-0.02em] leading-[1.12] text-foreground text-balance">
      <span class="block">{c.titlePre}</span>
      <span class="block text-accent">{c.titleAccent}</span>
    </h2>

    <p class="reveal text-base sm:text-lg text-muted mt-6 max-w-[58ch] mx-auto leading-relaxed" style="--rd:.12s">
      {c.sub}
    </p>

    <div class="reveal mt-9" style="--rd:.2s">
      <a
        href="#pricing"
        class="group relative inline-flex items-center justify-center h-12 px-8 rounded-pill font-medium text-white overflow-hidden bg-brand-gradient bg-[length:160%_160%] shadow-glow transition-[background-position,transform] duration-500 ease-out-expo hover:bg-[position:100%_50%] active:scale-[0.98]"
      >
        {c.cta}
      </a>
    </div>
  </div>
</section>
