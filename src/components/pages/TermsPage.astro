---
import type { Locale } from "../../i18n/ui";
import { t, localePath } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = t(locale).legal;
const tm = L.terms;
const support = "support@dicta.uz";
const legal = "legal@dicta.uz";
// The money terms live in full in the public offer; Terms only summarises them.
const offerHref = localePath("/offer", locale);
const prose =
  "max-w-3xl w-full mx-auto px-6 py-16 space-y-6 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-foreground [&_h2]:mt-8 [&_h2]:mb-2 [&_p]:text-muted [&_p]:leading-relaxed [&_a]:text-accent [&_a]:hover:text-accent-strong [&_ul]:list-disc [&_ul]:ps-6 [&_ul]:text-muted [&_ul]:space-y-1.5 [&_li]:leading-relaxed [&_strong]:text-foreground";
---

<Layout
  title={`${L.termsTitle} — Dicta`}
  description={tm.intro}
  locale={locale}
  path="/terms"
>
  <Header locale={locale} path="/terms" />
  <article class={prose}>
    <h1 class="font-display text-4xl font-semibold text-foreground">{L.termsTitle}</h1>
    <p class="!text-sm">{L.termsUpdated}</p>

    <p>{tm.intro}</p>

    <h2>{tm.acceptableUse.title}</h2>
    <ul>
      <li>{tm.acceptableUse.item1}</li>
      <li>{tm.acceptableUse.item2}</li>
      <li>{tm.acceptableUse.item3}</li>
    </ul>

    <h2>{tm.availability.title}</h2>
    <p>{tm.availability.body}</p>

    <h2>{tm.yourContent.title}</h2>
    <p>{tm.yourContent.body}</p>

    <h2>{tm.payment.title}</h2>
    <p>{tm.payment.body}</p>

    <h2>{tm.renewal.title}</h2>
    <p>{tm.renewal.body}</p>

    <h2>{tm.refunds.title}</h2>
    <p>{tm.refunds.bodyBefore}<a href={offerHref}>{tm.refunds.linkLabel}</a>{tm.refunds.bodyAfter}</p>

    <h2>{tm.taxes.title}</h2>
    <p>{tm.taxes.body}</p>

    <h2>{tm.termination.title}</h2>
    <p>{tm.termination.bodyBefore}<a href={`mailto:${support}`}>{support}</a>{tm.termination.bodyAfter}</p>

    <h2>{tm.liability.title}</h2>
    <p>{tm.liability.body}</p>

    <h2>{tm.contact.title}</h2>
    <p>{tm.contact.legalLabel}<a href={`mailto:${legal}`}>{legal}</a>.</p>
  </article>
  <Footer locale={locale} />
</Layout>
