---
import type { ImageMetadata } from "astro";
import type { Locale } from "../../i18n/ui";
import { localePath, appUrl } from "../../i18n/utils";
import { FEATURES, FEATURE_SHOTS, FEATURE_RELATED, WEBINAR_LAUNCH_DISCOUNT_PERCENT, type FeatureSlug } from "../../i18n/pages/features";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import Shot from "../Shot.astro";
import { meetingUi } from "../../i18n/pages/meeting-ui";
import CompactHero from "../meeting/CompactHero.astro";
import NotesCard from "../meeting/NotesCard.astro";
import NotesItem from "../meeting/NotesItem.astro";
import NotesSection from "../meeting/NotesSection.astro";
import TaskLine from "../meeting/TaskLine.astro";
import TimedSteps from "../meeting/TimedSteps.astro";
import ClosingRoom from "../meeting/ClosingRoom.astro";

interface Props {
  locale: Locale;
  slug: FeatureSlug;
}
const { locale, slug } = Astro.props;
const L = FEATURES[locale];
const ui = L.ui;
const f = L.features[slug];
const path = `/features/${slug}`;

const shotFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/landing/shots/*.png", { eager: true });
const img = (name: string) => shotFiles[`../../assets/landing/shots/${name}.png`]?.default;
const shotDef = FEATURE_SHOTS[slug];
const shot = shotDef && img(shotDef.name) ? { light: img(shotDef.name)!, dark: img(`${shotDef.name}-dark`), mobile: shotDef.mobile } : null;

const related = FEATURE_RELATED[slug];
const m = meetingUi(locale);
const ART = {
  transcription: "languages",
  "ai-summary": "phone",
  "notetaker-bot": "online",
  "meeting-room": "online",
  "offline-recording": "offline",
  upload: "phone",
  "desktop-app": "online",
  webinars: "audience",
  "ai-chat": "phone",
  "tasks-integrations": "phone",
} as const;
const art = ART[slug];
const last = f.steps.length - 1;
const stamps = f.steps.map((_, i) => (i === 0 ? `00:00 · ${m.you}` : i === last ? `${m.stepLater} · ${m.you}` : `00:0${i} · ${m.dicta}`));
const h2 = "font-display text-[1.8rem] sm:text-[2.2rem] font-semibold tracking-[-0.02em] leading-[1.15] text-foreground text-balance";
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: f.faq.map((i) => ({
      "@type": "Question",
      name: i.q,
      acceptedAnswer: { "@type": "Answer", text: i.a },
    })),
  },
];
---

<Layout title={`${f.metaTitle} — Dicta`} description={f.metaDesc} locale={locale} path={path} jsonLd={jsonLd} visitTopic="features">
  <Header locale={locale} path={path} />
  <div class="relative flex-1">
    <div class="max-w-6xl mx-auto px-3 sm:px-5 pt-8 lg:pt-12">
      <nav aria-label="Breadcrumb" class="text-sm text-muted mb-5 px-3 sm:px-1">
        <a href={localePath("/features", locale)} class="hover:text-accent transition-colors">{ui.breadcrumbRoot}</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-foreground-soft">{f.name}</span>
      </nav>
      <CompactHero eyebrow={f.name} h1={f.h1} sub={f.sub} art={art}>
        {slug === "webinars" && WEBINAR_LAUNCH_DISCOUNT_PERCENT > 0 && (
          <a
            href={appUrl("/sign-up")}
            data-analytics-event="cta_clicked"
            data-analytics-location="feature_webinars_offer"
            class="group mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-2xl border border-ink-line bg-ink-2 px-4 py-3 text-sm text-ink-fg hover:border-ink-accent transition-colors"
          >
            <span class="inline-flex items-center justify-center rounded-pill bg-accent px-2.5 py-0.5 text-xs font-semibold text-accent-fg">−{WEBINAR_LAUNCH_DISCOUNT_PERCENT}%</span>
            <span class="min-w-[14rem] flex-1 leading-snug">{ui.webinarOffer(WEBINAR_LAUNCH_DISCOUNT_PERCENT)}</span>
            <span class="font-semibold text-ink-accent whitespace-nowrap">{ui.webinarOfferCta} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100">→</span></span>
          </a>
        )}
        {slug === "desktop-app" && (
          <p class="mt-7">
            <a
              href={localePath("/download", locale)}
              data-analytics-event="download_app_clicked"
              data-analytics-os="na"
              data-analytics-arch="na"
              class="inline-flex items-center justify-center min-h-[3rem] px-7 rounded-pill border border-ink-line text-ink-fg text-base font-medium hover:bg-ink-2 transition-colors"
            >
              {ui.desktopLink}
            </a>
          </p>
        )}
        <NotesCard slot="notes" as="section" aria-labelledby="benefits-title" label={`${m.dicta} · ${m.notesLive}`}>
          <h2 id="benefits-title" class="font-display text-[1.5rem] sm:text-[1.75rem] font-semibold tracking-[-0.02em] leading-tight text-foreground text-balance">{ui.benefitsTitle}</h2>
          <ul class="mt-5 grid gap-4">
            {f.benefits.map((b, i) => (
              <NotesItem kind="check" as="li" class="notes-in" style={`--rd:${(i * 0.12).toFixed(2)}s`}>
                <h3 class="font-display text-lg font-semibold leading-snug text-foreground">{b.t}</h3>
                <p class="mt-1 text-muted leading-relaxed">{b.d}</p>
              </NotesItem>
            ))}
          </ul>
          <NotesSection label={m.nextStep} class="mt-7 notes-in" style="--rd:.36s">
            <TaskLine
              who={m.you}
              task={m.taskTryFeature}
              href={appUrl("/sign-up")}
              cta={ui.ctaPrimary}
              attrs={{ "data-analytics-event": "cta_clicked", "data-analytics-location": `feature_${slug}_hero` }}
            />
          </NotesSection>
        </NotesCard>
      </CompactHero>
    </div>

    {shot && (
      <div class:list={["mx-auto px-6 lg:px-10 pt-14 lg:pt-20 w-full", shot.mobile ? "max-w-[20.5rem]" : "max-w-5xl"]}>
        <Shot light={shot.light} dark={shot.dark} mobile={shot.mobile} alt={f.h1} sizes={shot.mobile ? "17rem" : "(min-width: 1024px) 60rem, calc(100vw - 3rem)"} eager />
      </div>
    )}

    <section aria-labelledby="how-title" class="max-w-4xl mx-auto px-6 lg:px-10 pt-20 lg:pt-28">
      <h2 id="how-title" class={h2}>{ui.howTitle}</h2>
      <TimedSteps class="mt-10" steps={f.steps} stamps={stamps} numbers={f.steps.map((_, i) => `0${i + 1}`)} titleTag="h3" />
    </section>

    <section aria-labelledby="faq-title" class="max-w-3xl mx-auto px-6 lg:px-10 pt-20 lg:pt-28">
      <h2 id="faq-title" class={h2}>{ui.faqTitle}</h2>
      <div class="mt-8 grid gap-3">
        {f.faq.map((i) => (
          <details class="group rounded-card border border-border bg-surface open:shadow-card transition-colors duration-150 ease-out-expo">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 rounded-card px-5 py-4 text-lg font-medium text-foreground hover:text-accent transition-colors [&::-webkit-details-marker]:hidden">
              {i.q}
              <span aria-hidden="true" class="text-accent transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
            </summary>
            <p class="px-5 pb-5 text-muted leading-relaxed">{i.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section aria-labelledby="related-title" class="max-w-6xl mx-auto px-6 lg:px-10 pt-20 lg:pt-28">
      <h2 id="related-title" class={h2}>{ui.relatedTitle}</h2>
      <div class="mt-8 grid md:grid-cols-3 gap-5">
        {related.map((r) => (
          <a href={localePath(`/features/${r}`, locale)} class="group block rounded-card border border-border bg-surface p-6 hover:border-border-strong hover:shadow-card transition-[border-color,box-shadow]">
            <h3 class="font-display text-xl font-semibold text-foreground group-hover:text-accent transition-colors">{L.features[r].name}</h3>
            <p class="mt-2 text-muted leading-relaxed">{L.features[r].card}</p>
          </a>
        ))}
      </div>
      <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-base font-medium">
        <a href={localePath("/features", locale)} class="text-foreground hover:text-accent transition-colors">{ui.allFeatures}</a>
        <a href={localePath("/use-cases", locale)} class="text-foreground hover:text-accent transition-colors">{ui.useCases}</a>
        <a href={localePath("/pricing", locale)} class="text-foreground hover:text-accent transition-colors">{ui.pricing}</a>
      </p>
    </section>

    <ClosingRoom
      locale={locale}
      headingId="cta-title"
      title={ui.ctaTitle}
      sub={ui.ctaSub}
      task={{
        who: m.you,
        task: m.taskStartFree,
        href: appUrl("/sign-up"),
        cta: ui.ctaPrimary,
        attrs: { "data-analytics-event": "cta_clicked", "data-analytics-location": `feature_${slug}_footer` },
      }}
      secondary={[
        {
          href: localePath("/download", locale),
          label: ui.ctaSecondary,
          attrs: { "data-analytics-event": "download_app_clicked", "data-analytics-os": "na", "data-analytics-arch": "na" },
        },
      ]}
      class="mt-20 lg:mt-28 mb-3 sm:mb-5"
    />
  </div>
  <Footer locale={locale} />
</Layout>
