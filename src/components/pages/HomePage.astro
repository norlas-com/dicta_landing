---
import type { ImageMetadata } from "astro";
import type { Locale } from "../../i18n/ui";
import { t } from "../../i18n/utils";
import { fetchCatalog } from "../../lib/catalog";
import { fetchStats } from "../../lib/stats";
import { faqItems, faqJsonLd, FAQ_HOME_KEYS } from "../../lib/faq";
import { APP_STORE_URL, PLAY_STORE_URL } from "../../lib/appLinks";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Hero from "../Hero.astro";
import Customers from "../Customers.astro";
import Stats from "../Stats.astro";
import Features from "../Features.astro";
import Pricing from "../Pricing.astro";
import Faq from "../Faq.astro";
import Contact from "../Contact.astro";
import FinalCta from "../FinalCta.astro";
import Footer from "../Footer.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const [catalog, stats] = await Promise.all([fetchCatalog(), fetchStats()]);
const faq = faqItems(locale, catalog, FAQ_HOME_KEYS);

// Real app screenshots (a demo workspace), light + optional dark capture.
const shotFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/landing/shots/*.png", { eager: true });
const img = (name: string) => shotFiles[`../../assets/landing/shots/${name}.png`]?.default;
const pair = (...names: string[]) => {
  const name = names.find((n) => img(n));
  if (!name) throw new Error(`landing: missing screenshot ${names.join(" / ")}`);
  return { light: img(name)!, dark: img(`${name}-dark`) };
};
const hero = pair("recap");
const shots = {
  capture: pair("meetings-list"),
  transcript: pair("transcript"),
  summary: pair("tasks", "recap"),
  mobile: pair("mobile-recap", "mobile-meetings"),
};

const title = `Dicta: ${d.home.hero.titlePre} ${d.home.hero.titleAccent}`;
const description = d.home.hero.sub;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Dicta",
    url: "https://dicta.uz",
    logo: "https://dicta.uz/apple-touch-icon.png",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Dicta",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web, macOS, Windows, iOS, Android",
    description,
    // Store listings, so search engines can associate the apps with the brand.
    // The per-platform MobileApplication entries with downloadUrl live on
    // /download, which is the page that actually links them.
    sameAs: [APP_STORE_URL, PLAY_STORE_URL],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "UZS",
    },
  },
  faqJsonLd(faq),
];
---

<Layout title={title} description={description} locale={locale} path="/" jsonLd={jsonLd}>
  <Header locale={locale} path="/" />
  <Hero locale={locale} shot={hero.light} shotDark={hero.dark} />
  <Customers locale={locale} />
  <Stats locale={locale} stats={stats} />
  <Features locale={locale} shots={shots} />
  {catalog && <Pricing locale={locale} catalog={catalog} />}
  <Faq locale={locale} items={faq} home />
  <Contact locale={locale} />
  <FinalCta locale={locale} />
  <Footer locale={locale} />
</Layout>
