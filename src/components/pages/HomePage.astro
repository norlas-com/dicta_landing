---
import type { Locale } from "../../i18n/ui";
import { t } from "../../i18n/utils";
import { fetchCatalog } from "../../lib/catalog";
import { fetchStats } from "../../lib/stats";
import { faqItems, faqJsonLd, FAQ_HOME_KEYS } from "../../lib/faq";
import { APP_STORE_URL, PLAY_STORE_URL } from "../../lib/appLinks";
import { HOME_META } from "../../i18n/pages/home-meta";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import HeroStage from "../home/HeroStage.astro";
import ProofBand from "../home/ProofBand.astro";
import Stats from "../Stats.astro";
import SceneOffline from "../home/SceneOffline.astro";
import SceneOnline from "../home/SceneOnline.astro";
import ScenePayoff from "../home/ScenePayoff.astro";
import SceneLanguages from "../home/SceneLanguages.astro";
import SceneAudiences from "../home/SceneAudiences.astro";
import Pricing from "../Pricing.astro";
import Faq from "../Faq.astro";
import Contact from "../Contact.astro";
import ClosingStage from "../home/ClosingStage.astro";
import Footer from "../Footer.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const [catalog, stats] = await Promise.all([fetchCatalog(), fetchStats()]);
const faq = faqItems(locale, catalog, FAQ_HOME_KEYS);

const { title, description } = HOME_META[locale];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Dicta",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web, macOS, Windows, iOS, Android",
    description,
    // Store listings, so search engines can associate the apps with the brand.
    // The per-platform MobileApplication entries with downloadUrl live on
    // /download, which is the page that actually links them.
    sameAs: [APP_STORE_URL, PLAY_STORE_URL],
    offers: catalog
      ? catalog.plans.map((p) => ({
          "@type": "Offer",
          name: p.name,
          price: String(p.prices.UZS / 100),
          priceCurrency: "UZS",
        }))
      : { "@type": "Offer", price: "0", priceCurrency: "UZS" },
  },
  faqJsonLd(faq),
];
---

<Layout title={title} description={description} locale={locale} path="/" jsonLd={jsonLd}>
  <Header locale={locale} path="/" />
  <HeroStage locale={locale} />
  <ProofBand locale={locale}>
    <Stats locale={locale} stats={stats} />
  </ProofBand>
  <SceneOffline locale={locale} />
  <SceneOnline locale={locale} />
  <ScenePayoff locale={locale} />
  <SceneLanguages locale={locale} />
  <SceneAudiences locale={locale} />
  {catalog && <Pricing locale={locale} catalog={catalog} />}
  <Faq locale={locale} items={faq} home />
  <Contact locale={locale} />
  <ClosingStage locale={locale} />
  <Footer locale={locale} />
</Layout>
