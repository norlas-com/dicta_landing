---
import type { Locale } from "../../i18n/ui";
import { t } from "../../i18n/utils";
import { fetchCatalog } from "../../lib/catalog";
import { faqItems, faqJsonLd, FAQ_HOME_KEYS } from "../../lib/faq";
import { SITE } from "../../../site.config.mjs";
import { APP_STORE_URL, PLAY_STORE_URL } from "../../lib/appLinks";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Hero from "../Hero.astro";
import FeatureStory from "../FeatureStory.astro";
import Pricing from "../Pricing.astro";
import Trust from "../Trust.astro";
import Faq from "../Faq.astro";
import Contact from "../Contact.astro";
import Footer from "../Footer.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const catalog = await fetchCatalog();
const faq = faqItems(locale, catalog, FAQ_HOME_KEYS);

const title = "Dicta — " + d.landing.h1Pre + " " + d.landing.h1Accent;
const description = d.landing.sub;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Dicta",
    url: "https://dicta.uz",
    logo: "https://dicta.uz/apple-touch-icon.png",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Dicta",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web, macOS, Windows, iOS, Android",
    description,
    // Store listings, so search engines can associate the apps with the brand.
    // The per-platform MobileApplication entries with downloadUrl live on
    // /download, which is the page that actually links them.
    sameAs: [APP_STORE_URL, PLAY_STORE_URL],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "UZS",
    },
  },
  faqJsonLd(faq),
];
---

<Layout title={title} description={description} locale={locale} path="/" jsonLd={jsonLd}>
  {/* data-snap-free wrappers are snap areas around the story: taller than the
      viewport they scroll freely under mandatory snap (see global.css). */}
  <div data-snap-free>
    <Header locale={locale} path="/" />
    <Hero locale={locale} />
    {/* Customer proof is dicta.uz-only: Premier is a dicta.uz customer and
        means nothing to the global audience. */}
    {SITE.id === "uz" && <Trust locale={locale} />}
  </div>
  <FeatureStory locale={locale} />
  <div data-snap-free>
    {catalog && <Pricing locale={locale} catalog={catalog} />}
    <Faq locale={locale} items={faq} home />
    <Contact locale={locale} />
    <Footer locale={locale} />
  </div>
</Layout>
