---
import type { ImageMetadata } from "astro";
import type { Locale } from "../../i18n/ui";
import { appUrl, localePath } from "../../i18n/utils";
import { faqJsonLd, type FaqItem } from "../../lib/faq";
import { USE_CASES, USE_CASE_SLUGS, USE_CASE_META, UI, type UseCaseSlug } from "../../i18n/pages/use-cases";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import Faq from "../Faq.astro";
import Shot from "../Shot.astro";

interface Props {
  locale: Locale;
  slug: UseCaseSlug;
}
const { locale, slug } = Astro.props;
const u = UI[locale];
const c = USE_CASES[slug][locale];
const meta = USE_CASE_META[slug];
const path = `/use-cases/${slug}`;

const shotFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/landing/shots/*.png", { eager: true });
const img = (name?: string) => (name ? shotFiles[`../../assets/landing/shots/${name}.png`]?.default : undefined);
const light = img(meta.shot)!;
const dark = img(meta.dark);

const faqItems = c.faq.map((f) => ({ q: f.q, a: f.a })) as FaqItem[];
const others = USE_CASE_SLUGS.filter((s) => s !== slug);
const abs = (p: string) => new URL(localePath(p, locale), "https://dicta.uz").toString();

const jsonLd = [
  faqJsonLd(faqItems),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: u.crumb, item: abs("/use-cases") },
      { "@type": "ListItem", position: 2, name: c.name, item: abs(path) },
    ],
  },
];
const kicker = "text-sm font-medium text-accent mb-3";
const h2 = "font-display text-[1.8rem] sm:text-[2.3rem] font-semibold tracking-[-0.02em] leading-[1.15] text-foreground text-balance";
---

<Layout title={`${c.title} — Dicta`} description={c.meta} locale={locale} path={path} jsonLd={jsonLd}>
  <Header locale={locale} path={path} />
  <main class="relative flex-1">
    <section class="max-w-6xl mx-auto px-6 lg:px-10 pt-14 pb-16 grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-12 items-center">
      <div>
        <a href={localePath("/use-cases", locale)} class="text-sm font-medium text-accent hover:text-accent-strong">{u.crumb}</a>
        <h1 class="font-display text-[2.3rem] sm:text-[3.1rem] font-semibold tracking-[-0.025em] leading-[1.1] text-foreground text-balance mt-4">
          {c.h1}
        </h1>
        <p class="text-base sm:text-lg text-muted mt-5 max-w-[56ch] leading-relaxed">{c.sub}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={appUrl("/sign-up")}
            data-analytics-event="signup_start_click"
            data-analytics-location={`use_case_${slug}_hero`}
            class="inline-flex items-center justify-center h-[3.25rem] px-8 rounded-pill bg-accent text-accent-fg text-base font-semibold hover:bg-accent-strong active:scale-[0.98] transition-[background-color,transform] duration-200 ease-out-expo"
          >
            {u.ctaPrimary}
          </a>
          <a
            href={localePath("/pricing", locale)}
            class="inline-flex items-center justify-center h-[3.25rem] px-8 rounded-pill border border-border-strong text-foreground text-base font-medium hover:bg-surface-2 transition-colors duration-150"
          >
            {u.ctaPricing}
          </a>
        </div>
      </div>
      <div class:list={[meta.mobile && "max-w-[18rem] mx-auto w-full"]}>
        <Shot
          mobile={meta.mobile}
          light={light}
          dark={dark}
          alt={u.shotAlt[meta.shot]}
          sizes={meta.mobile ? "18rem" : "(min-width: 1024px) 34rem, calc(100vw - 3rem)"}
          eager
        />
      </div>
    </section>

    <section class="border-t border-border bg-surface-2">
      <div class="max-w-4xl mx-auto px-6 lg:px-10 py-16">
        <p class={kicker}>{u.problemKicker}</p>
        <h2 class={h2}>{c.problemTitle}</h2>
        <div class="mt-6 space-y-4 text-base sm:text-lg text-muted leading-relaxed max-w-[62ch]">
          {c.problem.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 lg:px-10 py-16">
      <p class={kicker}>{u.howKicker}</p>
      <h2 class={h2}>{c.stepsTitle}</h2>
      <ol class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          c.steps.map((s, i) => (
            <li class="rounded-card border border-border bg-surface p-6">
              <span class="font-display text-3xl font-semibold text-accent tabular-nums">{i + 1}</span>
              <h3 class="font-semibold text-foreground mt-3">{s.t}</h3>
              <p class="text-muted mt-2 leading-relaxed text-[0.95rem]">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="border-t border-border">
      <div class="max-w-6xl mx-auto px-6 lg:px-10 py-16">
        <h2 class={h2}>{u.featuresTitle}</h2>
        <ul class="mt-10 grid sm:grid-cols-2 gap-x-10 gap-y-7">
          {
            meta.features.map((k) => (
              <li class="border-s-2 border-accent ps-5">
                <h3 class="font-semibold text-foreground">{u.features[k].t}</h3>
                <p class="text-muted mt-1.5 leading-relaxed">{u.features[k].d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 pt-16">
        <h2 class={h2}>{u.faqTitle}</h2>
      </div>
      <div class="pt-8">
        <Faq locale={locale} items={faqItems} />
      </div>
    </section>

    <section class="bg-ink text-ink-fg">
      <div class="max-w-6xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <h2 class="font-display text-[2rem] sm:text-[2.8rem] font-semibold tracking-[-0.025em] leading-[1.1] max-w-[20ch] text-balance">{u.ctaTitle}</h2>
        <p class="text-lg text-ink-muted mt-4">{u.ctaSub}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={appUrl("/sign-up")}
            data-analytics-event="signup_start_click"
            data-analytics-location={`use_case_${slug}_cta`}
            class="inline-flex items-center justify-center h-[3.25rem] px-8 rounded-pill bg-ink-fg text-ink text-base font-semibold hover:bg-ink-accent active:scale-[0.98] transition-[background-color,transform] duration-200 ease-out-expo"
          >
            {u.ctaPrimary}
          </a>
          <a href={localePath("/pricing", locale)} class="inline-flex items-center justify-center h-[3.25rem] px-8 rounded-pill border border-ink-line text-ink-fg text-base font-medium hover:bg-ink-2 transition-colors duration-150">{u.ctaPricing}</a>
          <a href={localePath("/faq", locale)} class="inline-flex items-center justify-center h-[3.25rem] px-8 rounded-pill border border-ink-line text-ink-fg text-base font-medium hover:bg-ink-2 transition-colors duration-150">{u.ctaFaq}</a>
        </div>
      </div>
    </section>

    <nav aria-label={u.othersTitle} class="max-w-6xl mx-auto px-6 lg:px-10 py-14">
      <h2 class="font-display text-xl font-semibold text-foreground">{u.othersTitle}</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          others.map((s) => (
            <li>
              <a href={localePath(`/use-cases/${s}`, locale)} class="inline-flex items-center h-10 px-4 rounded-pill border border-border bg-surface text-sm font-medium text-foreground hover:border-border-strong hover:text-accent transition-colors">
                {USE_CASES[s][locale].name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
  <Footer locale={locale} />
</Layout>
