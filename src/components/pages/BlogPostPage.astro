---
import { render } from "astro:content";
import { SITE } from "../../../site.config.mjs";
import type { Locale } from "../../i18n/ui";
import { localePath, appUrl } from "../../i18n/utils";
import { blogCopy } from "../../i18n/pages/blog";
import {
  type Post,
  postPath,
  topicPath,
  readingMinutes,
  formatDate,
  relatedPosts,
  translationsOf,
} from "../../lib/blog";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { meetingUi } from "../../i18n/pages/meeting-ui";
import Room from "../meeting/Room.astro";
import TaskLine from "../meeting/TaskLine.astro";
import VisitRecap from "../meeting/VisitRecap.astro";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const locale = post.data.lang as Locale;
const c = blogCopy[locale];
const { Content, headings } = await render(post);
const m = meetingUi(locale);
// "In this post": the H2s Astro already gave ids to; only worth showing for a longer read.
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingMinutes(post.body, locale);
const translations = await translationsOf(post);
const related = await relatedPosts(post);

const abs = (path: string) => new URL(path, SITE.url).toString();
const url = abs(postPath(post));
const alternates: Partial<Record<Locale, string>> = {};
for (const [l, p] of Object.entries(translations)) alternates[l as Locale] = postPath(p as Post);
const others = (Object.entries(translations) as [Locale, Post][]).filter(([l]) => l !== locale);

// Link previews get the JPEG twin of a WebP cover: not every unfurler
// (LinkedIn, older Facebook crawlers) reads WebP.
const shareImage = post.data.cover?.replace(/\.webp$/, ".jpg");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    inLanguage: locale,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    mainEntityOfPage: url,
    url,
    ...(shareImage ? { image: abs(shareImage) } : {}),
    articleSection: c.topics[post.data.topic],
    keywords: post.data.tags.join(", "),
    author: { "@type": "Organization", name: "Dicta", url: SITE.url },
    publisher: {
      "@type": "Organization",
      name: "Dicta",
      url: SITE.url,
      logo: { "@type": "ImageObject", url: abs("/logo-mark.png") },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: c.home, item: abs(localePath("/", locale)) },
      { "@type": "ListItem", position: 2, name: c.navLabel, item: abs(localePath("/blog", locale)) },
      {
        "@type": "ListItem",
        position: 3,
        name: c.topics[post.data.topic],
        item: abs(topicPath(post.data.topic, locale)),
      },
      { "@type": "ListItem", position: 4, name: post.data.title, item: url },
    ],
  },
  ...(post.data.faq.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: post.data.faq.map(({ q, a }) => ({
            "@type": "Question",
            name: q,
            acceptedAnswer: { "@type": "Answer", text: a },
          })),
        },
      ]
    : []),
];
---

<Layout
  title={`${post.data.title} — Dicta`}
  description={post.data.description}
  locale={locale}
  path={`/blog/${post.data.slug}`}
  alternates={alternates}
  ogType="article"
  ogImage={shareImage}
  jsonLd={jsonLd}
  visitTopic="blog"
>
  <Header locale={locale} path="/blog" />
  <article class="relative flex-1">
    <div class="max-w-6xl mx-auto px-6 lg:px-10 pt-12 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-x-14">
      <aside data-post-rail class="mb-8 lg:mb-0 lg:pt-[3.4rem]">
        <div class="lg:sticky lg:top-24">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4 lg:grid-cols-1 lg:gap-y-5">
            <div>
              <dt data-ui-label class="meeting-label text-muted">{m.post.topic}</dt>
              <dd class="mt-1.5 text-sm">
                <a href={topicPath(post.data.topic, locale)} class="font-medium text-accent hover:underline">{c.topics[post.data.topic]}</a>
              </dd>
            </div>
            <div>
              <dt data-ui-label class="meeting-label text-muted">{m.post.writtenBy}</dt>
              <dd data-ui-label class="mt-1.5 text-sm text-foreground-soft">Dicta</dd>
            </div>
            <div>
              <dt data-ui-label class="meeting-label text-muted">{m.post.duration}</dt>
              <dd class="mt-1.5 text-sm text-foreground-soft">{c.readMin(minutes)}</dd>
            </div>
            <div>
              <dt data-ui-label class="meeting-label text-muted">{m.post.date}</dt>
              <dd class="mt-1.5 text-sm text-foreground-soft">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
              </dd>
            </div>
          </dl>
          {
            toc.length >= 2 &&
              [
                // Closed on a phone (it sits above the article), open beside it on a
                // wide screen: two copies shown by breakpoint, so nothing toggles
                // after load and the layout never shifts. Both are UI labels.
                { cls: "lg:hidden", open: false },
                { cls: "max-lg:hidden", open: true },
              ].map(({ cls, open }) => (
                <details data-post-toc open={open} data-ui-label class={`mt-6 border-t border-border pt-4 ${cls}`}>
                  <summary class="meeting-label text-muted cursor-pointer select-none">{m.post.inThisPost}</summary>
                  <ol class="mt-3 grid gap-2 text-sm leading-snug">
                    {toc.map((h) => (
                      <li>
                        <a href={`#${h.slug}`} class="text-foreground-soft hover:text-accent transition-colors">{h.text}</a>
                      </li>
                    ))}
                  </ol>
                </details>
              ))
          }
        </div>
      </aside>

      <div class="min-w-0">
        <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
          <a href={localePath("/", locale)} class="hover:text-foreground">{c.home}</a>
          <span aria-hidden="true"> / </span>
          <a href={localePath("/blog", locale)} class="hover:text-foreground">{c.navLabel}</a>
          <span aria-hidden="true"> / </span>
          <a href={topicPath(post.data.topic, locale)} class="font-medium text-accent hover:underline">{c.topics[post.data.topic]}</a>
        </nav>
        <h1 class="font-display text-[2.1rem] sm:text-[2.9rem] font-semibold tracking-[-0.02em] leading-[1.15] text-foreground text-balance">
          {post.data.title}
        </h1>
        {
          post.data.updated && (
            <p class="text-sm text-muted mt-5">
              {c.updated} <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated, locale)}</time>
            </p>
          )
        }
        {
          others.length > 0 && (
            <p class="text-sm text-muted mt-3">
              {c.alsoIn}:
              {others.map(([l, p], i) => (
                <Fragment>
                  {i > 0 ? ", " : " "}
                  <a href={postPath(p)} hreflang={l} lang={l} class="text-accent hover:underline">
                    {c.langName[l]}
                  </a>
                </Fragment>
              ))}
            </p>
          )
        }

        {
          post.data.cover && (
            <img
              src={post.data.cover}
              alt={post.data.coverAlt ?? ""}
              width="1376"
              height="768"
              fetchpriority="high"
              class="w-full aspect-[16/9] object-cover rounded-card bg-surface-2 mt-8"
            />
          )
        }

        <div class="max-w-[44rem] mt-10 pb-12 blog-prose">
          <Content />
        </div>
      </div>
    </div>

    <section aria-labelledby="blog-cta" class="px-3 sm:px-5 mb-16">
      <Room variant="hero" as="div" class="max-w-6xl mx-auto">
        <h2 id="blog-cta" class="font-display text-[1.9rem] sm:text-[2.4rem] font-medium leading-[1.1] tracking-[-0.02em] max-w-[22ch] text-balance">
          {c.ctaTitle}
        </h2>
        <p class="text-lg text-ink-muted mt-4 max-w-[52ch] leading-relaxed">{c.ctaSub}</p>
        <div class="mt-8 flex flex-col lg:flex-row lg:items-center gap-4 max-w-3xl">
          <TaskLine
            tone="ink"
            class="lg:flex-1"
            who={m.you}
            task={m.taskStartFree}
            href={appUrl("/sign-up")}
            cta={c.ctaPrimary}
            attrs={{ "data-analytics-event": "signup_start_click", "data-analytics-location": "blog_post" }}
          />
          <a
            href={localePath("/download", locale)}
            data-analytics-event="download_app_clicked"
            data-analytics-os="na"
            data-analytics-arch="na"
            class="inline-flex items-center justify-center min-h-[3.25rem] px-7 rounded-pill border border-ink-line text-ink-fg text-base font-medium hover:bg-ink-2 transition-colors"
          >
            {c.ctaSecondary}
          </a>
        </div>
        <VisitRecap locale={locale} tone="ink" class="mt-6" />
      </Room>
    </section>

    {
      related.length > 0 && (
        <section aria-labelledby="blog-related" class="max-w-6xl mx-auto px-6 lg:px-10 pb-24">
          <h2 id="blog-related" class="font-display text-2xl font-semibold text-foreground mb-5">{c.related}</h2>
          <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <li>
                <a href={postPath(p)} class="group record">
                  <p class="meeting-label text-muted">{c.readMin(readingMinutes(p.body, locale))}</p>
                  <p class="font-display text-lg font-semibold leading-snug text-foreground mt-2.5 flex-1 group-hover:text-accent transition-colors">{p.data.title}</p>
                  <hr class="record__rule" />
                  <span aria-hidden="true" class="record__foot"><span class="record__arrow">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
  <Footer locale={locale} />
</Layout>

<style is:global>
  .blog-prose {
    font-family: var(--font-serif), var(--font-arabic), Georgia, serif;
    font-size: 1.1875rem;
    line-height: 1.75;
    color: var(--color-foreground-soft);
  }
  .blog-prose > * + * { margin-block-start: 1.15em; }
  .blog-prose h2 {
    font-family: var(--font-serif), var(--font-arabic), Georgia, serif;
    font-size: 1.75rem; line-height: 1.25; font-weight: 600;
    color: var(--color-foreground); margin-block: 2.2em 0.6em; letter-spacing: -0.015em;
  }
  .blog-prose h2, .blog-prose h3 { scroll-margin-block-start: 6rem; }
  .blog-prose h3 {
    font-size: 1.25rem; line-height: 1.3; font-weight: 600;
    color: var(--color-foreground); margin-block: 1.8em 0.4em;
  }
  .blog-prose a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .blog-prose ul, .blog-prose ol { padding-inline-start: 1.4em; }
  .blog-prose ul { list-style: disc; }
  .blog-prose ol { list-style: decimal; }
  .blog-prose li + li { margin-block-start: 0.4em; }
  .blog-prose ul.contains-task-list { list-style: none; padding-inline-start: 0.2em; }
  .blog-prose .task-list-item input { margin-inline-end: 0.55em; accent-color: var(--color-accent); }
  .blog-prose strong { color: var(--color-foreground); font-weight: 600; }
  .blog-prose blockquote {
    border-inline-start: 3px solid var(--color-border-strong);
    padding-inline-start: 1.1em; color: var(--color-muted);
  }
  .blog-prose table { width: 100%; border-collapse: collapse; font-size: 0.95rem; display: block; overflow-x: auto; }
  .blog-prose th, .blog-prose td {
    border: 1px solid var(--color-border); padding: 0.55em 0.75em; text-align: start; vertical-align: top;
  }
  .blog-prose th { background: var(--color-surface-2); color: var(--color-foreground); }
  .blog-prose img { max-width: 100%; height: auto; border-radius: 12px; }
  .blog-prose hr { border: 0; border-top: 1px solid var(--color-border); margin-block: 2em; }
</style>
