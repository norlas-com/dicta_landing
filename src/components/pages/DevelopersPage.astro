---
import type { Locale } from "../../i18n/ui";
import { localePath, appUrl } from "../../i18n/utils";
import { developersPage } from "../../i18n/pages/developers";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { meetingUi } from "../../i18n/pages/meeting-ui";
import Room from "../meeting/Room.astro";
import NotesCard from "../meeting/NotesCard.astro";
import NotesItem from "../meeting/NotesItem.astro";
import ClosingRoom from "../meeting/ClosingRoom.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = developersPage[locale];
const m = meetingUi(locale);
const home = localePath("/", locale);
const homeBase = home === "/" ? "" : home;
const origin = "https://dicta.uz";
const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: c.breadcrumbHome, item: `${origin}${home}` },
    { "@type": "ListItem", position: 2, name: c.integrations.eyebrow, item: `${origin}${localePath("/developers", locale)}` },
  ],
};
---

<Layout title={c.metaTitle} description={c.metaDescription} locale={locale} path="/developers" jsonLd={[crumbLd]} visitTopic="developers">
  <Header locale={locale} path="/developers" />
  <div class="relative flex-1">
    <div class="max-w-6xl mx-auto px-3 sm:px-5 pt-8 lg:pt-12">
      <Room variant="compact" as="div">
        <p class="meeting-label text-ink-muted" data-ui-label>{m.topics.developers}</p>
        <h1 class="font-display text-ink-fg mt-4 text-[clamp(2.1rem,5.4vw,3.4rem)] leading-[1.04] tracking-[-0.03em] font-medium text-balance">
          {c.h1}
        </h1>
        <p class="mt-5 max-w-[56ch] text-base sm:text-lg text-ink-muted leading-relaxed">{c.intro}</p>
      </Room>
    </div>

    <section class="relative" aria-labelledby="integrations-title">
      <div class="max-w-6xl mx-auto px-6 lg:px-10 pt-16 lg:pt-24 pb-16 lg:pb-24">
        <p class="text-sm font-medium text-accent mb-4">{c.integrations.eyebrow}</p>
        <h2 id="integrations-title" class="font-display text-[2rem] sm:text-[2.6rem] font-semibold tracking-[-0.02em] leading-[1.1] text-foreground text-balance">
          {c.integrations.title}
        </h2>
        <p class="text-base text-muted mt-4 max-w-[60ch] leading-relaxed">{c.integrations.sub}</p>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            c.integrations.items.map((it) => (
              <NotesCard>
                <NotesItem kind="check">
                  <h3 class="font-display text-lg font-semibold leading-snug text-foreground">{it.name}</h3>
                  <p class="mt-1.5 text-sm text-muted leading-relaxed">{it.body}</p>
                </NotesItem>
              </NotesCard>
            ))
          }
        </div>
      </div>
    </section>

    {/* The API contact leads, as it did before the redesign; signing up stays
        the secondary action. */}
    <ClosingRoom
      locale={locale}
      headingId="api-title"
      primary={{
        href: `${homeBase}/#contact`,
        label: c.api.cta,
        attrs: { "data-analytics-event": "cta_clicked", "data-analytics-location": "developers_api" },
      }}
      secondary={[
        {
          href: appUrl("/sign-up"),
          label: c.links.signup,
          attrs: { "data-analytics-event": "signup_start_click", "data-analytics-location": "developers_page" },
        },
      ]}
      class="mb-3 sm:mb-5"
    >
      <div slot="head" class="grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-start">
        <div>
          <p class="text-sm font-medium text-ink-accent mb-3">{c.api.eyebrow}</p>
          <h2 id="api-title" class="font-display text-[2rem] sm:text-[2.6rem] font-medium leading-[1.08] tracking-[-0.025em] text-balance">
            {c.api.title}
          </h2>
          <p class="text-lg text-ink-muted mt-4 max-w-[48ch] leading-relaxed">{c.api.body}</p>
        </div>
        <NotesCard>
          <ul class="grid gap-3">
            {
              c.api.points.map((pt) => (
                <NotesItem kind="check" as="li">{pt}</NotesItem>
              ))
            }
          </ul>
        </NotesCard>
      </div>
      <p class="text-sm text-ink-muted mt-5 max-w-[60ch] leading-relaxed">{c.api.note}</p>
      <p slot="after" class="max-w-6xl mx-auto px-3 sm:px-5 mt-8 mb-12 flex flex-wrap gap-x-6 gap-y-2">
        <a href={localePath("/pricing", locale)} class="text-accent hover:text-accent-strong font-medium">{c.links.pricing}</a>
        <a href={localePath("/faq", locale)} class="text-accent hover:text-accent-strong font-medium">{c.links.faq}</a>
      </p>
    </ClosingRoom>
  </div>
  <Footer locale={locale} />
</Layout>
