---
import type { Locale } from "../../i18n/ui";
import { t } from "../../i18n/utils";
import { fetchCatalog } from "../../lib/catalog";
import { faqItems, faqJsonLd } from "../../lib/faq";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import Faq from "../Faq.astro";
import Room from "../meeting/Room.astro";
import { meetingUi } from "../../i18n/pages/meeting-ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const f = t(locale).faq;
const m = meetingUi(locale);
const items = faqItems(locale, await fetchCatalog());
---

<Layout
  title={`${f.pageTitle} — Dicta`}
  description={f.pageSub}
  locale={locale}
  path="/faq"
  jsonLd={[faqJsonLd(items)]}
  visitTopic="faq"
>
  <Header locale={locale} path="/faq" />
  <main class="relative flex-1">
    <div class="max-w-3xl mx-auto px-3 sm:px-5 pt-8 lg:pt-12 pb-10">
      <Room variant="compact" as="div">
        <p class="meeting-label text-ink-muted" data-ui-label>{m.topics.faq}</p>
        <h1 class="font-display text-ink-fg mt-4 text-[clamp(2.1rem,5.4vw,3.4rem)] leading-[1.04] tracking-[-0.03em] font-medium text-balance">
          {f.pageTitle}
        </h1>
        <p class="mt-5 max-w-[48ch] text-base sm:text-lg text-ink-muted leading-relaxed">{f.pageSub}</p>
      </Room>
    </div>
    <Faq locale={locale} items={items} />
  </main>
  <Footer locale={locale} />
</Layout>
