---
import type { Locale } from "../../i18n/ui";
import { t, localePath } from "../../i18n/utils";
import { fetchDesktopRelease } from "../../lib/desktop";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import StoreBadges from "../StoreBadges.astro";
import { APP_STORE_URL, PLAY_STORE_URL, SMART_APP_URL } from "../../lib/appLinks";
import { qrSvg } from "../../lib/qr";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const dl = d.download;
const rel = await fetchDesktopRelease();

// QR of the UA-sniffing smart link, so one code serves both platforms. Built at
// build time — the page is static and the URL never varies.
const qr = qrSvg(`https://dicta.uz${SMART_APP_URL}`, 132);

// Structured data for both mobile listings. The home page already declares the
// web/desktop SoftwareApplication; this page is where the store listings live,
// so the downloadUrls belong here.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "Dicta",
    operatingSystem: "iOS",
    applicationCategory: "BusinessApplication",
    downloadUrl: APP_STORE_URL,
    offers: { "@type": "Offer", price: "0", priceCurrency: "UZS" },
  },
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "Dicta",
    operatingSystem: "Android",
    applicationCategory: "BusinessApplication",
    downloadUrl: PLAY_STORE_URL,
    offers: { "@type": "Offer", price: "0", priceCurrency: "UZS" },
  },
];
---

<Layout title={`${dl.title} — Dicta`} description={dl.sub} locale={locale} path="/download" jsonLd={jsonLd}>
  <Header locale={locale} path="/download" />

  <section class="relative overflow-hidden flex-1">
    <div aria-hidden="true" class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[500px] pointer-events-none opacity-[0.16] dark:opacity-25 blur-[90px] bg-brand-gradient bg-[length:200%_200%] animate-gradient-shimmer"></div>

    <div class="relative max-w-4xl mx-auto px-6 lg:px-10 pt-16 pb-24 text-center">
      <h1 class="font-display text-[2.4rem] sm:text-[3.2rem] font-semibold tracking-[-0.02em] leading-[1.12] text-foreground text-balance">
        {dl.title}
      </h1>
      <p class="text-base sm:text-lg text-muted mt-5 max-w-[52ch] mx-auto leading-relaxed">{dl.sub}</p>

      {/* Two platform groups. Desktop leads by default — that's the right
          answer for the visitor most likely to be here, and the one a no-JS
          visitor gets. The script at the bottom flips the flex order for phone
          visitors: a phone can't run a .pkg, so opening with macOS/Windows
          installers is the wrong first thing to show them. Ordering via flex
          `order` rather than moving nodes keeps one cacheable static page. */}
      <div data-platforms class="mt-12 flex flex-col gap-12">

      <section data-group="mobile" class="order-2 text-left">
        <div class="flex items-baseline gap-3 mb-4">
          <h2 class="font-display text-lg font-semibold tracking-tight text-foreground">{dl.mobileHeading}</h2>
          <span class="flex-1 h-px bg-border/70" aria-hidden="true"></span>
        </div>
        <div class="rounded-panel border border-border bg-surface/70 backdrop-blur-sm p-6">
          <div class="flex flex-col sm:flex-row sm:items-center gap-6">
            <div class="min-w-0 flex-1">
              <p class="text-sm text-muted leading-relaxed max-w-[46ch]">{dl.mobileSub}</p>
              <StoreBadges locale={locale} class="mt-5" location="download_page" />
            </div>
            {/* Desktop-only: a phone visitor is already holding the device. */}
            <div data-mobile-qr class="hidden sm:flex shrink-0 flex-col items-center gap-2">
              <div class="rounded-2xl bg-white p-2.5 shadow-card ring-1 ring-border" set:html={qr} />
              <p class="text-2xs text-muted max-w-[16ch] text-center leading-snug">{dl.mobileScan}</p>
            </div>
          </div>
        </div>
      </section>

      <section data-group="desktop" class="order-1 text-left">
        <div class="flex items-baseline gap-3 mb-4">
          <h2 class="font-display text-lg font-semibold tracking-tight text-foreground">{dl.desktopHeading}</h2>
          <span class="flex-1 h-px bg-border/70" aria-hidden="true"></span>
        </div>
        <p class="text-sm text-muted leading-relaxed max-w-[52ch] mb-5">{dl.desktopSub}</p>

      <div class="grid gap-5 sm:grid-cols-2 text-left" data-download data-arm={rel.arm64Url} data-intel={rel.intelUrl} data-win={rel.winUrl}>
        <!-- macOS -->
        <div data-os-card="mac" class="rounded-panel border border-border bg-surface/70 backdrop-blur-sm p-6 transition-shadow">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-control bg-surface-2 border border-border text-foreground">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.365 1.43c0 1.14-.42 2.2-1.12 2.98-.76.86-2 1.52-3.02 1.44-.14-1.1.42-2.26 1.08-2.98.74-.82 2.06-1.44 3.06-1.44zM20.9 17.02c-.56 1.28-.82 1.85-1.54 2.98-1 1.58-2.42 3.54-4.18 3.55-1.56.02-1.96-1.02-4.08-1-2.12.01-2.56 1.02-4.12 1.01-1.76-.02-3.1-1.79-4.1-3.36-2.8-4.42-3.1-9.6-1.37-12.36 1.23-1.96 3.17-3.1 4.99-3.1 1.86 0 3.03 1.02 4.57 1.02 1.49 0 2.4-1.02 4.55-1.02 1.63 0 3.35.89 4.58 2.42-4.02 2.2-3.37 7.94.7 9.86z"/></svg>
            </span>
            <div>
              <p class="text-base font-semibold text-foreground">{dl.osMac}</p>
              <p class="text-xs text-muted" data-mac-hint>{dl.macHint}</p>
            </div>
          </div>

          <a
            data-mac-primary
            href={rel.arm64Url}
            data-analytics-event="download_app_clicked"
            data-analytics-os="macos"
            data-analytics-arch="arm"
            class="mt-5 w-full inline-flex items-center justify-center gap-2 h-11 rounded-pill font-medium text-white bg-brand-gradient bg-[length:160%_160%] shadow-glow hover:bg-[position:100%_50%] transition-[background-position] duration-300 ease-out-expo"
          >
            {dl.mac} · <span data-mac-arch>{dl.appleSilicon}</span>
          </a>
          <div class="mt-3 flex items-center justify-between text-xs">
            <a href={rel.arm64Url} data-mac-alt-arm data-analytics-event="download_app_clicked" data-analytics-os="macos" data-analytics-arch="arm" class="text-muted hover:text-foreground transition-colors">{dl.appleSilicon}</a>
            <a href={rel.intelUrl} data-mac-alt-intel data-analytics-event="download_app_clicked" data-analytics-os="macos" data-analytics-arch="intel" class="text-muted hover:text-foreground transition-colors">{dl.intel}</a>
          </div>
        </div>

        <!-- Windows -->
        <div data-os-card="win" class="rounded-panel border border-border bg-surface/70 backdrop-blur-sm p-6 transition-shadow">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-control bg-surface-2 border border-border text-foreground">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.1 10.4 4v7.3H3zM10.4 12.7V20L3 18.9v-6.2zM11.3 3.9 21 2.5v8.8h-9.7zM21 12.7v8.8l-9.7-1.4v-7.4z"/></svg>
            </span>
            <div>
              <p class="text-base font-semibold text-foreground">{dl.osWindows}</p>
              <p class="text-xs text-muted">{dl.windowsHint}</p>
            </div>
          </div>

          <a
            data-win-primary
            href={rel.winUrl}
            data-analytics-event="download_app_clicked"
            data-analytics-os="windows"
            data-analytics-arch="na"
            class="mt-5 w-full inline-flex items-center justify-center gap-2 h-11 rounded-pill font-medium text-foreground bg-surface-2 border border-border-strong hover:bg-surface-3 transition-colors"
          >
            {dl.windows}
          </a>
          <p class="mt-3 text-xs text-muted leading-snug">{dl.smartscreen}</p>
        </div>
      </div>
      </section>

      </div>

      <p class="mt-8 text-sm text-foreground-soft font-medium">{dl.note}</p>
      <a href={localePath("/", locale)} class="mt-4 inline-flex text-sm text-muted hover:text-foreground transition-colors">← {dl.back}</a>
    </div>
  </section>

  <Footer locale={locale} />
</Layout>

<script>
  // Phone visitors: lead with the stores, not with .pkg/.exe files they can't
  // run. Done client-side rather than by rendering per user-agent so the page
  // stays ONE static artifact the edge can cache for everyone — a UA-varying
  // render would need `Vary: User-Agent` and give up edge caching for a change
  // this small. Desktop-first is the served default, so a no-JS visitor still
  // gets a coherent page.
  (() => {
    const wrap = document.querySelector("[data-platforms]");
    if (!wrap) return;
    const ua = navigator.userAgent || "";
    const isIOS = /iPhone|iPad|iPod/i.test(ua);
    const isAndroid = /Android/i.test(ua);
    if (!isIOS && !isAndroid) return;

    wrap.querySelector('[data-group="mobile"]')?.classList.replace("order-2", "order-1");
    wrap.querySelector('[data-group="desktop"]')?.classList.replace("order-1", "order-2");

    // Put the visitor's own store first within the badge row.
    if (isAndroid) {
      wrap.querySelector('a[data-analytics-os="android"]')?.classList.replace("order-2", "order-1");
      wrap.querySelector('a[data-analytics-os="ios"]')?.classList.replace("order-1", "order-2");
    }

    // The QR only makes sense on a device that isn't the phone.
    wrap.querySelector("[data-mobile-qr]")?.remove();
  })();
</script>

<script define:vars={{ intelHint: dl.intelHint, macHint: dl.macHint, intelLabel: dl.intel, armLabel: dl.appleSilicon, apiLatest: "https://api.dicta.uz/v1/desktop/latest" }}>
  document.querySelectorAll("[data-download]").forEach((root) => {
    const ua = navigator.userAgent;
    const isWin = /Win(dows|32|64|CE)/i.test(ua);
    const macCard = root.querySelector('[data-os-card="mac"]');
    const winCard = root.querySelector('[data-os-card="win"]');
    const ringOn = (el) => el && el.classList.add("ring-2", "ring-accent/40");

    // Highlight the visitor's platform.
    if (isWin) ringOn(winCard);
    else ringOn(macCard);

    // Detect Apple Silicon vs Intel via the WebGL renderer string.
    function macArch() {
      try {
        const c = document.createElement("canvas");
        const gl = c.getContext("webgl") || c.getContext("experimental-webgl");
        if (!gl) return null;
        const dbg = gl.getExtension("WEBGL_debug_renderer_info");
        const r = dbg ? String(gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) || "") : "";
        if (/apple/i.test(r)) return "arm";
        if (/intel|amd|radeon|nvidia|geforce/i.test(r)) return "intel";
      } catch (e) {}
      return null;
    }

    // Point every download control at the given release URLs, then pick the
    // right default macOS arch. Runs first with the build-time (baked) URLs,
    // then again if the live API returns fresher ones — so the page always
    // links the newest release without a rebuild, and still works if the API
    // is unreachable (the baked URLs stay in place).
    function apply(arm, intel, win) {
      if (arm) root.setAttribute("data-arm", arm);
      if (intel) root.setAttribute("data-intel", intel);
      if (win) root.setAttribute("data-win", win);
      const armUrl = root.getAttribute("data-arm");
      const intelUrl = root.getAttribute("data-intel");
      const winUrl = root.getAttribute("data-win");
      const primary = root.querySelector("[data-mac-primary]");
      const altArm = root.querySelector("[data-mac-alt-arm]");
      const altIntel = root.querySelector("[data-mac-alt-intel]");
      const winPrimary = root.querySelector("[data-win-primary]");
      const archSpan = root.querySelector("[data-mac-arch]");
      const hint = root.querySelector("[data-mac-hint]");
      if (altArm && armUrl) altArm.setAttribute("href", armUrl);
      if (altIntel && intelUrl) altIntel.setAttribute("href", intelUrl);
      if (winPrimary && winUrl) winPrimary.setAttribute("href", winUrl);
      const intelMac = !isWin && macArch() === "intel";
      const macUrl = intelMac ? intelUrl : armUrl;
      if (primary && macUrl) primary.setAttribute("href", macUrl);
      // Keep the analytics arch param in sync with the detected default arch,
      // so download_app_clicked reports the real target for the primary button.
      if (primary) primary.setAttribute("data-analytics-arch", intelMac ? "intel" : "arm");
      if (archSpan) archSpan.textContent = intelMac ? intelLabel : armLabel;
      if (hint) hint.textContent = intelMac ? intelHint : macHint;
    }

    // Baked URLs already on the elements are the fallback.
    apply(root.getAttribute("data-arm"), root.getAttribute("data-intel"), root.getAttribute("data-win"));

    // Upgrade to the true latest from the public backend endpoint.
    fetch(apiLatest, { headers: { accept: "application/json" } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => { if (d) apply(d.mac_arm64_url, d.mac_intel_url, d.win_url); })
      .catch(() => {});
  });
</script>
