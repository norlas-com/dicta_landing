---
import type { Locale } from "../../i18n/ui";
import { t, localePath, appUrl } from "../../i18n/utils";
import { pricingPage } from "../../i18n/pages/pricing";
import { fetchCatalog } from "../../lib/catalog";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import Pricing from "../Pricing.astro";
import { meetingUi } from "../../i18n/pages/meeting-ui";
import Room from "../meeting/Room.astro";
import NotesCard from "../meeting/NotesCard.astro";
import NotesItem from "../meeting/NotesItem.astro";
import TaskLine from "../meeting/TaskLine.astro";
import VisitRecap from "../meeting/VisitRecap.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = pricingPage[locale];
const k = c.compare;
const p = t(locale).pricing;
const m = meetingUi(locale);
const catalog = await fetchCatalog();

const home = localePath("/", locale);
const homeBase = home === "/" ? "" : home;
const contactHref = `${homeBase}/#contact`;

const group = (n: number) =>
  Math.round(n)
    .toString()
    .replace(/\B(?=(\d{3})+(?!\d))/g, " ");
const uzs = (minor: number) => (minor === 0 ? k.free : `${group(minor / 100)} ${k.uzsUnit}`);
const usd = (minor: number) => (minor === 0 ? k.free : `$${(minor / 100).toFixed(2)}`);

const plans = catalog?.plans ?? [];
const rows = catalog
  ? [
      { label: k.priceUzs, cells: plans.map((x) => uzs(x.prices.UZS)), strong: true },
      { label: k.priceUsd, cells: plans.map((x) => usd(x.prices.USD)), strong: true },
      { label: k.minutes, cells: plans.map((x) => `${x.minutes} ${k.minutesSuffix}`) },
      { label: k.storage, cells: plans.map((x) => `${x.storage_gb} ${k.storageSuffix}`) },
      {
        label: k.retention,
        cells: plans.map((x) =>
          x.retention_days == null ? k.retentionForever : k.retentionDays.replace("{days}", String(x.retention_days)),
        ),
      },
      { label: k.support, cells: plans.map((x) => p.support[x.support]) },
      { label: k.noCard, cells: plans.map((x) => (x.prices.USD === 0 && x.prices.UZS === 0 ? k.no : "")) },
    ]
  : [];
const packs = (catalog?.packs ?? []).map((pk) =>
  k.packsLine
    .replace("{min}", String(pk.minutes))
    .replace("{uzs}", `${group(pk.prices.UZS / 100)} ${k.uzsUnit}`)
    .replace("{usd}", usd(pk.prices.USD)),
);

const origin = "https://dicta.uz";
const productLd = plans.map((x) => ({
  "@context": "https://schema.org",
  "@type": "Product",
  name: `Dicta ${x.name}`,
  description: `${k.minutes}: ${x.minutes}. ${k.storage}: ${x.storage_gb} ${k.storageSuffix}.`,
  brand: { "@type": "Brand", name: "Dicta" },
  offers: (["UZS", "USD"] as const).map((cur) => ({
    "@type": "Offer",
    price: (x.prices[cur] / 100).toFixed(2),
    priceCurrency: cur,
    availability: "https://schema.org/InStock",
    url: `${origin}${localePath("/pricing", locale)}`,
  })),
}));
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.billing.items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: c.breadcrumbHome, item: `${origin}${home}` },
    { "@type": "ListItem", position: 2, name: p.navLabel, item: `${origin}${localePath("/pricing", locale)}` },
  ],
};
---

<Layout
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="/pricing"
  jsonLd={[...productLd, faqLd, crumbLd]}
  visitTopic="pricing"
>
  <Header locale={locale} path="/pricing" />
  <main class="relative flex-1">
    <div class="max-w-6xl mx-auto px-3 sm:px-5 pt-8 lg:pt-12">
      <Room variant="compact" as="div">
        <p class="meeting-label text-ink-muted" data-ui-label>{m.topics.pricing}</p>
        <h1 class="font-display text-ink-fg mt-4 text-[clamp(2.1rem,5.4vw,3.4rem)] leading-[1.04] tracking-[-0.03em] font-medium text-balance">
          {c.h1}
        </h1>
        <p class="mt-5 max-w-[56ch] text-base sm:text-lg text-ink-muted leading-relaxed">{c.intro}</p>
      </Room>
    </div>

    {catalog && <Pricing locale={locale} catalog={catalog} />}

    <section class="relative scroll-mt-20" aria-labelledby="compare-title">
      <div class="max-w-6xl mx-auto px-6 lg:px-10 pb-16 lg:pb-24">
        <p class="text-sm font-medium text-accent mb-4">{k.eyebrow}</p>
        <h2 id="compare-title" class="font-display text-[2rem] sm:text-[2.6rem] font-semibold tracking-[-0.02em] leading-[1.1] text-foreground text-balance">
          {k.title}
        </h2>
        <p class="text-base text-muted mt-4 max-w-[60ch] leading-relaxed">{k.sub}</p>

        {
          catalog ? (
            <>
              <div class="mt-8 overflow-x-auto rounded-card border border-border bg-surface shadow-card">
                <table class="w-full min-w-[36rem] sm:min-w-[40rem] text-sm text-start border-collapse">
                  <caption class="sr-only">{k.caption}</caption>
                  <thead>
                    <tr class="border-b border-border">
                      <th scope="col" class="sticky start-0 z-10 bg-surface text-start font-medium text-muted-soft px-4 sm:px-5 py-4 w-[9.5rem] sm:w-auto">{k.featureCol}</th>
                      {plans.map((x) => (
                        <th scope="col" class:list={["text-start font-semibold px-4 sm:px-5 py-4", x.popular ? "text-accent" : "text-foreground"]}>
                          {x.name}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {rows.map((r) => (
                      <tr class="border-b border-border last:border-b-0">
                        <th scope="row" class="sticky start-0 z-10 bg-surface text-start font-medium text-foreground-soft px-4 sm:px-5 py-4 shadow-[1px_0_0_var(--color-border)] sm:shadow-none">{r.label}</th>
                        {r.cells.map((cell) => (
                          <td class:list={["px-4 sm:px-5 py-4 tabular-nums", r.strong ? "font-semibold text-foreground" : "text-foreground-soft"]}>
                            {cell === "" ? "—" : cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="text-sm text-muted mt-5 max-w-[70ch] leading-relaxed">{k.limitsNote}</p>
              {packs.length > 0 && (
                <NotesCard class="mt-8 max-w-3xl" label={`${m.dicta} · ${m.notesLive}`}>
                  <h3 class="font-display text-xl font-semibold text-foreground">{k.packsTitle}</h3>
                  <ul class="mt-4 grid gap-3">
                    {packs.map((line) => (
                      <NotesItem kind="check" as="li">{line}</NotesItem>
                    ))}
                  </ul>
                </NotesCard>
              )}
              <p class="text-xs text-muted-soft mt-6">{p.vatNote}</p>
            </>
          ) : (
            <p class="mt-8 text-muted">{k.noCatalog}</p>
          )
        }
      </div>
    </section>

    <section class="relative" aria-labelledby="billing-title">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 pb-16 lg:pb-24">
        <p class="text-sm font-medium text-accent mb-4">{c.billing.eyebrow}</p>
        <h2 id="billing-title" class="font-display text-[2rem] sm:text-[2.6rem] font-semibold tracking-[-0.02em] leading-[1.1] text-foreground text-balance">
          {c.billing.title}
        </h2>
        <NotesCard class="mt-8" label={`${m.dicta} · ${m.notesLive}`}>
          {
            c.billing.items.map((item, i) => (
              <details class="group border-b border-dashed border-border last:border-b-0">
                <summary
                  class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-start font-display text-lg font-medium leading-snug text-foreground hover:text-accent transition-colors duration-150 ease-out-expo [&::-webkit-details-marker]:hidden"
                  data-analytics-event="faq_opened"
                  data-analytics-question={`billing_${i}`}
                >
                  <span>{item.q}</span>
                  <span aria-hidden="true" class="shrink-0 grid place-items-center w-6 h-6 rounded-[6px] border border-border-strong text-accent transition-transform duration-200 ease-out-expo group-open:rotate-45">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 1.5v9M1.5 6h9" /></svg>
                  </span>
                </summary>
                <div class="pb-5 text-muted leading-relaxed">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </NotesCard>
        <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          <a href={localePath("/faq", locale)} class="text-accent hover:text-accent-strong font-medium">{c.links.faq}</a>
          <a href={localePath("/developers", locale)} class="text-accent hover:text-accent-strong font-medium">{c.links.developers}</a>
        </p>
      </div>
    </section>

    <section aria-labelledby="enterprise-title" class="px-3 sm:px-5 mb-3 sm:mb-5">
      <Room variant="hero" as="div" class="max-w-6xl mx-auto">
        <h2 id="enterprise-title" class="font-display text-[2rem] sm:text-[2.8rem] font-medium leading-[1.08] tracking-[-0.025em] max-w-[18ch] text-balance">
          {c.enterprise.title}
        </h2>
        <p class="text-lg text-ink-muted mt-4 max-w-[48ch] leading-relaxed">{c.enterprise.body}</p>
        <div class="mt-8 flex flex-col lg:flex-row lg:items-center gap-4 max-w-3xl">
          <TaskLine
            tone="ink"
            class="lg:flex-1"
            who={m.you}
            task={m.taskStartFree}
            href={appUrl("/sign-up")}
            cta={c.enterprise.secondary}
            attrs={{ "data-analytics-event": "signup_start_click", "data-analytics-location": "pricing_page_bottom" }}
          />
          <a
            href={contactHref}
            data-analytics-event="cta_clicked"
            data-analytics-location="pricing_enterprise"
            class="inline-flex items-center justify-center min-h-[3.25rem] px-7 rounded-pill border border-ink-line text-ink-fg text-base font-medium hover:bg-ink-2 transition-colors"
          >
            {c.enterprise.cta}
          </a>
        </div>
        <VisitRecap locale={locale} tone="ink" class="mt-6" />
      </Room>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
