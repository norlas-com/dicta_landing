---
import type { Locale } from "../../i18n/ui";
import { t, localePath, appUrl } from "../../i18n/utils";
import { pricingPage } from "../../i18n/pages/pricing";
import { fetchCatalog } from "../../lib/catalog";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import Pricing from "../Pricing.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = pricingPage[locale];
const k = c.compare;
const p = t(locale).pricing;
const catalog = await fetchCatalog();

const home = localePath("/", locale);
const homeBase = home === "/" ? "" : home;
const contactHref = `${homeBase}/#contact`;

const group = (n: number) =>
  Math.round(n)
    .toString()
    .replace(/\B(?=(\d{3})+(?!\d))/g, " ");
const uzs = (minor: number) => (minor === 0 ? k.free : `${group(minor / 100)} ${k.uzsUnit}`);
const usd = (minor: number) => (minor === 0 ? k.free : `$${(minor / 100).toFixed(2)}`);

const plans = catalog?.plans ?? [];
const rows = catalog
  ? [
      { label: k.priceUzs, cells: plans.map((x) => uzs(x.prices.UZS)), strong: true },
      { label: k.priceUsd, cells: plans.map((x) => usd(x.prices.USD)), strong: true },
      { label: k.minutes, cells: plans.map((x) => `${x.minutes} ${k.minutesSuffix}`) },
      { label: k.storage, cells: plans.map((x) => `${x.storage_gb} ${k.storageSuffix}`) },
      {
        label: k.retention,
        cells: plans.map((x) =>
          x.retention_days == null ? k.retentionForever : k.retentionDays.replace("{days}", String(x.retention_days)),
        ),
      },
      { label: k.support, cells: plans.map((x) => p.support[x.support]) },
      { label: k.noCard, cells: plans.map((x) => (x.prices.USD === 0 && x.prices.UZS === 0 ? k.no : "")) },
    ]
  : [];
const packs = (catalog?.packs ?? []).map((pk) =>
  k.packsLine
    .replace("{min}", String(pk.minutes))
    .replace("{uzs}", `${group(pk.prices.UZS / 100)} ${k.uzsUnit}`)
    .replace("{usd}", usd(pk.prices.USD)),
);

const origin = "https://dicta.uz";
const productLd = plans.map((x) => ({
  "@context": "https://schema.org",
  "@type": "Product",
  name: `Dicta ${x.name}`,
  description: `${k.minutes}: ${x.minutes}. ${k.storage}: ${x.storage_gb} ${k.storageSuffix}.`,
  brand: { "@type": "Brand", name: "Dicta" },
  offers: (["UZS", "USD"] as const).map((cur) => ({
    "@type": "Offer",
    price: (x.prices[cur] / 100).toFixed(2),
    priceCurrency: cur,
    availability: "https://schema.org/InStock",
    url: `${origin}${localePath("/pricing", locale)}`,
  })),
}));
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.billing.items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: c.breadcrumbHome, item: `${origin}${home}` },
    { "@type": "ListItem", position: 2, name: p.navLabel, item: `${origin}${localePath("/pricing", locale)}` },
  ],
};
---

<Layout
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="/pricing"
  jsonLd={[...productLd, faqLd, crumbLd]}
>
  <Header locale={locale} path="/pricing" />
  <div class="relative flex-1">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 pt-16 pb-2">
      <h1 class="font-display text-[2.4rem] sm:text-[3.2rem] font-semibold tracking-[-0.02em] leading-[1.12] text-foreground text-balance">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted mt-5 max-w-[56ch] leading-relaxed">{c.intro}</p>
    </div>

    {catalog && <Pricing locale={locale} catalog={catalog} />}

    <section class="relative scroll-mt-20" aria-labelledby="compare-title">
      <div class="max-w-6xl mx-auto px-6 lg:px-10 pb-16 lg:pb-24">
        <p class="text-sm font-medium text-accent mb-4">{k.eyebrow}</p>
        <h2 id="compare-title" class="font-display text-[2rem] sm:text-[2.6rem] font-semibold tracking-[-0.02em] leading-[1.1] text-foreground text-balance">
          {k.title}
        </h2>
        <p class="text-base text-muted mt-4 max-w-[60ch] leading-relaxed">{k.sub}</p>

        {
          catalog ? (
            <>
              <div class="mt-8 overflow-x-auto rounded-panel border border-border bg-surface">
                <table class="w-full min-w-[40rem] text-sm text-start border-collapse">
                  <caption class="sr-only">{k.caption}</caption>
                  <thead>
                    <tr class="border-b border-border">
                      <th scope="col" class="text-start font-medium text-muted-soft px-5 py-4">{k.featureCol}</th>
                      {plans.map((x) => (
                        <th scope="col" class:list={["text-start font-semibold px-5 py-4", x.popular ? "text-accent" : "text-foreground"]}>
                          {x.name}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {rows.map((r) => (
                      <tr class="border-b border-border last:border-b-0">
                        <th scope="row" class="text-start font-medium text-foreground-soft px-5 py-4">{r.label}</th>
                        {r.cells.map((cell) => (
                          <td class:list={["px-5 py-4 tabular-nums", r.strong ? "font-semibold text-foreground" : "text-foreground-soft"]}>
                            {cell === "" ? "—" : cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="text-sm text-muted mt-5 max-w-[70ch] leading-relaxed">{k.limitsNote}</p>
              {packs.length > 0 && (
                <div class="mt-8">
                  <h3 class="text-lg font-semibold text-foreground">{k.packsTitle}</h3>
                  <ul class="mt-3 space-y-1.5 text-sm text-foreground-soft">
                    {packs.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
              )}
              <p class="text-xs text-muted-soft mt-6">{p.vatNote}</p>
            </>
          ) : (
            <p class="mt-8 text-muted">{k.noCatalog}</p>
          )
        }
      </div>
    </section>

    <section class="relative" aria-labelledby="billing-title">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 pb-16 lg:pb-24">
        <p class="text-sm font-medium text-accent mb-4">{c.billing.eyebrow}</p>
        <h2 id="billing-title" class="font-display text-[2rem] sm:text-[2.6rem] font-semibold tracking-[-0.02em] leading-[1.1] text-foreground text-balance">
          {c.billing.title}
        </h2>
        <div class="mt-8 space-y-3">
          {
            c.billing.items.map((item, i) => (
              <details class="group rounded-card border border-border bg-surface open:shadow-card transition-colors duration-150 ease-out-expo">
                <summary
                  class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-card px-5 py-4 text-start font-medium text-foreground hover:text-accent transition-colors duration-150 ease-out-expo [&::-webkit-details-marker]:hidden"
                  data-analytics-event="faq_opened"
                  data-analytics-question={`billing_${i}`}
                >
                  <span>{item.q}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-muted transition-transform duration-200 ease-out-expo group-open:rotate-180">
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </summary>
                <div class="px-5 pb-5 text-muted leading-relaxed">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
        <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          <a href={localePath("/faq", locale)} class="text-accent hover:text-accent-strong font-medium">{c.links.faq}</a>
          <a href={localePath("/developers", locale)} class="text-accent hover:text-accent-strong font-medium">{c.links.developers}</a>
        </p>
      </div>
    </section>

    <section class="relative" aria-labelledby="enterprise-title">
      <div class="max-w-6xl mx-auto px-6 lg:px-10 pb-24">
        <div class="rounded-panel border border-border bg-surface shadow-card p-8 sm:p-10 flex flex-col lg:flex-row lg:items-center gap-6 justify-between">
          <div class="max-w-xl">
            <h2 id="enterprise-title" class="font-display text-[1.7rem] sm:text-[2.1rem] font-semibold tracking-[-0.02em] leading-[1.15] text-foreground text-balance">
              {c.enterprise.title}
            </h2>
            <p class="text-base text-muted mt-3 leading-relaxed">{c.enterprise.body}</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href={contactHref}
              data-analytics-event="cta_clicked"
              data-analytics-location="pricing_enterprise"
              class="inline-flex items-center justify-center h-12 px-7 rounded-pill bg-accent text-accent-fg font-medium hover:bg-accent-strong active:scale-[0.98] transition-[background-color,transform] duration-200 ease-out-expo"
            >
              {c.enterprise.cta}
            </a>
            <a
              href={appUrl("/sign-up")}
              data-analytics-event="signup_start_click"
              data-analytics-location="pricing_page_bottom"
              class="inline-flex items-center justify-center h-12 px-7 rounded-pill border border-border-strong text-foreground font-medium hover:bg-surface-2 transition-colors duration-150 ease-out-expo"
            >
              {c.enterprise.secondary}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
  <Footer locale={locale} />
</Layout>
