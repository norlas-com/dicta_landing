---
import type { Locale } from "../i18n/ui";
import { t, localePath } from "../i18n/utils";
import { SITE } from "../../site.config.mjs";
import { navExtra } from "../i18n/nav-extra";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const home = localePath("/", locale);
const year = new Date().getFullYear();
const nx = navExtra[locale];
const columns = [
  { title: nx.product, links: [
    { href: "/features", label: nx.features, item: "features" },
    { href: "/pricing", label: nx.pricing, item: "pricing" },
    { href: "/download", label: d.nav.download, item: "download" },
  ] },
  { title: nx.useCases, links: [
    { href: "/use-cases/offline-meetings", label: nx.ucOffline, item: "uc_offline" },
    { href: "/use-cases/online-meetings", label: nx.ucOnline, item: "uc_online" },
    { href: "/use-cases/meeting-bot", label: nx.ucBot, item: "uc_bot" },
    { href: "/use-cases", label: nx.useCases, item: "use_cases" },
  ] },
  { title: nx.resources, links: [
    { href: "/blog", label: nx.blog, item: "blog" },
    { href: "/faq", label: d.nav.faq, item: "faq" },
    { href: "/developers", label: nx.developers, item: "developers" },
  ] },
];
---

<footer class="mt-auto border-t border-border/60">
  <div class="max-w-6xl mx-auto px-6 pt-10 pb-2 grid grid-cols-2 sm:grid-cols-3 gap-8 text-sm">
    {columns.map((col) => (
      <div>
        <p class="font-medium text-foreground mb-3">{col.title}</p>
        <ul class="space-y-2">
          {col.links.map((l) => (
            <li><a href={localePath(l.href, locale)} data-analytics-event="nav_clicked" data-analytics-item={l.item} class="text-muted hover:text-foreground transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="max-w-6xl mx-auto px-6 py-6 flex flex-wrap items-center justify-between gap-4 text-xs text-muted">
    <p>© {year} Dicta. {d.landing.footerRights}</p>
    <div class="flex flex-wrap items-center gap-4">
            <a href={`${home === "/" ? "" : home}/#contact`} data-analytics-event="nav_clicked" data-analytics-item="contact" class="hover:text-foreground transition-colors">{d.nav.contact}</a>
      {/* The apps are the only way to use some features (roundtable records on
          everyone's phone and has no browser path), so the download link
          belongs on every page, not just in the header. */}
      <a href={localePath("/privacy", locale)} data-analytics-event="nav_clicked" data-analytics-item="privacy" class="hover:text-foreground transition-colors">{d.nav.privacy}</a>
      <a href={localePath("/terms", locale)} data-analytics-event="nav_clicked" data-analytics-item="terms" class="hover:text-foreground transition-colors">{d.nav.terms}</a>
      {/* The public offer (ommaviy oferta) is the contract a paying customer
          accepts — payment gateways and UZ law want it publicly linkable. */}
      {/* The public offer is an Uzbek legal instrument — UZ courts, UZS, the
          IT Park VAT exemption. Linking it from the global site would
          misrepresent which terms a buyer there is agreeing to. */}
      {SITE.publicOffer && (
        <a href={localePath("/offer", locale)} data-analytics-event="nav_clicked" data-analytics-item="offer" class="hover:text-foreground transition-colors">{d.nav.offer}</a>
      )}
      {/* Google Play Data Safety + Apple review both want a public, linkable
          account-deletion page. Keep it in the footer on every page. */}
      <a href={localePath("/delete-account", locale)} data-analytics-event="nav_clicked" data-analytics-item="delete_account" class="hover:text-foreground transition-colors">{d.nav.deleteAccount}</a>
      {/* "Developed by Norlas" — the same attribution pill the meet.dicta.uz app uses. */}
      <a
        href="https://norlas.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Developed by Norlas"
        data-analytics-event="outbound_click"
        data-analytics-url="norlas.com"
        class="inline-flex items-center gap-2.5 rounded-full bg-surface-2 px-4 py-2 transition-colors hover:bg-surface-3"
      >
        <span class="text-sm font-semibold text-muted">{d.landing.developedBy}</span>
        <span class="inline-flex items-center">
          <img src="/norlas.svg" alt="" aria-hidden="true" class="h-[18px] w-[18px]" />
          <span class="text-sm font-bold uppercase tracking-wide text-foreground ms-[3px]">ORLAS</span>
        </span>
      </a>
    </div>
  </div>
</footer>
