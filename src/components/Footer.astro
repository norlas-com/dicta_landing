---
import type { Locale } from "../i18n/ui";
import { t, localePath } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const home = localePath("/", locale);
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border/60">
  <div class="max-w-6xl mx-auto px-6 py-6 flex flex-wrap items-center justify-between gap-4 text-xs text-muted">
    <p>© {year} Dicta. {d.landing.footerRights}</p>
    <div class="flex flex-wrap items-center gap-4">
      <a href={`${home === "/" ? "" : home}/#pricing`} data-analytics-event="nav_clicked" data-analytics-item="pricing" class="hover:text-foreground transition-colors">{d.pricing.navLabel}</a>
      <a href={localePath("/privacy", locale)} data-analytics-event="nav_clicked" data-analytics-item="privacy" class="hover:text-foreground transition-colors">{d.nav.privacy}</a>
      <a href={localePath("/terms", locale)} data-analytics-event="nav_clicked" data-analytics-item="terms" class="hover:text-foreground transition-colors">{d.nav.terms}</a>
      {/* "Developed by Norlas" — the same attribution pill the meet.dicta.uz app uses. */}
      <a
        href="https://norlas.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Developed by Norlas"
        data-analytics-event="outbound_click"
        data-analytics-url="norlas.com"
        class="inline-flex items-center gap-2.5 rounded-full bg-surface-2 px-4 py-2 transition-colors hover:bg-surface-3"
      >
        <span class="text-sm font-semibold text-muted">{d.landing.developedBy}</span>
        <span class="inline-flex items-center">
          <img src="/norlas.svg" alt="" aria-hidden="true" class="h-[18px] w-[18px]" />
          <span class="text-sm font-bold uppercase tracking-wide text-foreground ml-[3px]">ORLAS</span>
        </span>
      </a>
    </div>
  </div>
</footer>
