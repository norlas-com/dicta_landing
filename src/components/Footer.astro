---
import type { Locale } from "../i18n/ui";
import { t, localePath } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const home = localePath("/", locale);
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border/60">
  <div class="max-w-6xl mx-auto px-6 py-6 flex flex-wrap items-center justify-between gap-3 text-xs text-muted">
    <p>© {year} Dicta. {d.landing.footerRights}</p>
    <div class="flex items-center gap-4">
      <a href={`${home === "/" ? "" : home}/#pricing`} class="hover:text-foreground transition-colors">{d.pricing.navLabel}</a>
      <a href={localePath("/privacy", locale)} class="hover:text-foreground transition-colors">{d.nav.privacy}</a>
      <a href={localePath("/terms", locale)} class="hover:text-foreground transition-colors">{d.nav.terms}</a>
      <a href="https://norlas.com" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-foreground transition-colors">
        <span>Norlas</span>
      </a>
    </div>
  </div>
</footer>
