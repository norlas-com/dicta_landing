---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BrandIcons from "./BrandIcons.astro";

/**
 * One full-viewport screen of the feature story: numbered eyebrow chip,
 * serif title, Problem → Our solution copy — and a full-bleed photo that
 * fills the other half of the screen. Sides alternate per screen via
 * `flip`. Snap behavior comes from the `.feature-screen` rules in
 * global.css; the `.fs-anim*` elements animate every time the screen
 * becomes active (`is-active`, toggled by FeatureStory's observer).
 */
interface Props {
  /** 1-based screen number (renders as the "01" chip). */
  index: number;
  id: string;
  title: string;
  problem: string;
  solution: string;
  image: ImageMetadata;
  alt: string;
  /** Photo on the left on desktop (text stays first on mobile). */
  flip?: boolean;
  labels: { problem: string; solution: string };
  /** Brand logos rendered under the solution copy (see BrandIcons). */
  brands?: string[];
}
const { index, id, title, problem, solution, image, alt, flip = false, labels, brands } = Astro.props;
const num = String(index).padStart(2, "0");
---

<section id={id} data-screen class="feature-screen relative overflow-hidden">
  <div class="grid lg:grid-cols-2 min-h-[100svh]">
    <!-- Text half -->
    <div
      class:list={[
        "flex items-center px-6 sm:px-10 lg:px-16 xl:px-20 pt-20 pb-10 lg:py-16",
        flip && "lg:order-2",
      ]}
    >
      <div class="max-w-[34rem] mx-auto lg:mx-0 w-full">
        <span class="fs-anim grid place-items-center w-9 h-9 rounded-lg bg-accent-soft text-accent text-sm font-semibold tabular-nums">
          {num}
        </span>

        <h2
          class="fs-anim font-display text-[2.1rem] sm:text-[2.6rem] xl:text-[3.1rem] font-semibold tracking-[-0.018em] leading-[1.12] text-foreground text-balance mt-5"
          style="--ad:.08s"
        >
          {title}
        </h2>

        <div class="mt-7 space-y-6">
          <div class="fs-anim" style="--ad:.16s">
            <p class="text-2xs uppercase tracking-[0.18em] text-muted-soft mb-2">{labels.problem}</p>
            <p class="text-base sm:text-lg text-muted leading-relaxed">{problem}</p>
          </div>
          <div class="fs-anim" style="--ad:.24s">
            <p class="text-2xs uppercase tracking-[0.18em] text-accent mb-2">{labels.solution}</p>
            <p class="text-base sm:text-lg text-foreground-soft leading-relaxed">{solution}</p>
          </div>
        </div>

        {
          brands && (
            <div class="fs-anim mt-7" style="--ad:.32s">
              <BrandIcons brands={brands} />
            </div>
          )
        }

        {
          Astro.slots.has("cta") && (
            <div class="fs-anim mt-8" style="--ad:.4s">
              <slot name="cta" />
            </div>
          )
        }
      </div>
    </div>

    <!-- Photo half: full-bleed on desktop, tall band on mobile -->
    <div
      class:list={[
        "relative h-[46svh] min-h-[300px] lg:h-auto lg:min-h-0",
        flip && "lg:order-1",
      ]}
    >
      <div class="fs-anim-img absolute inset-0">
        <Image
          src={image}
          alt={alt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          format="webp"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
        />
        {/* Soft edge so the photo melts into the page background on the text side. */}
        <div
          aria-hidden="true"
          class:list={[
            "absolute inset-y-0 w-24 hidden lg:block from-background/60 to-transparent",
            flip ? "right-0 bg-gradient-to-l" : "left-0 bg-gradient-to-r",
          ]}
        >
        </div>
        <div class="absolute top-0 inset-x-0 h-1 bg-brand-gradient" aria-hidden="true"></div>
      </div>
      <slot name="visual" />
    </div>
  </div>
</section>
