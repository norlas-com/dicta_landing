---
import type { Locale } from "../i18n/ui";
import { t } from "../i18n/utils";
import { SITE } from "../../site.config.mjs";

/**
 * "Contact sales" form. Posts JSON to the Pages Function at /api/contact
 * (functions/api/contact.js), which relays the lead to Telegram.
 *
 * Without JS the <form> still posts (urlencoded) and the function answers with
 * a redirect back to #contact-sent, which CSS reveals via :target. The spam
 * guards are a honeypot field and a render timestamp; the timestamp is set by
 * the script on load because the page itself is static, so only the JS path
 * gets the "too fast" check.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale).contact;
const phonePlaceholder = SITE.id === "uz" ? "+998 90 123 45 67" : "+971 50 123 4567";

// text-base (16px) so iOS does not zoom the page when a field is focused.
const field =
  "w-full text-base rounded-control border border-border-strong bg-surface text-foreground placeholder:text-muted-soft px-4 transition-colors duration-150 ease-out-expo hover:border-accent/60 focus:border-accent";
const label = "block text-sm font-medium text-foreground-soft mb-1.5";
---

<section id="contact" class="relative scroll-mt-20">
  <div class="relative max-w-6xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 items-start">
      <div class="reveal max-w-xl">
        <p class="text-sm font-medium text-accent mb-4">{c.eyebrow}</p>
        <h2 class="font-display text-[clamp(2.3rem,4.6vw,3.6rem)] font-medium tracking-[-0.03em] leading-[1.04] text-foreground text-balance">
          <span class="block">{c.headingPre}</span>
          <span class="block italic font-normal text-accent">{c.headingAccent}</span>
        </h2>
        <p class="text-base sm:text-lg text-muted mt-5 leading-relaxed max-w-[44ch]">{c.sub}</p>
        <a
          href="mailto:support@dicta.uz"
          data-analytics-event="outbound_click"
          data-analytics-url="mailto:support@dicta.uz"
          class="inline-flex items-center gap-2 mt-8 text-base font-medium text-foreground hover:text-accent transition-colors duration-150 ease-out-expo"
          dir="ltr"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-accent"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          support@dicta.uz
        </a>
      </div>

      <div class="reveal relative rounded-panel border border-border bg-surface shadow-card p-6 sm:p-8" style="--rd:.1s">
        <form
          data-contact-form
          method="post"
          action="/api/contact"
          novalidate
          class="space-y-5"
          data-error-invalid={c.errorInvalid}
          data-error-generic={c.errorGeneric}
          data-sending={c.sending}
        >
          <div class="grid sm:grid-cols-2 gap-x-4 gap-y-5">
            <div>
              <label for="contact-name" class={label}>{c.name}</label>
              <input id="contact-name" name="name" type="text" maxlength="100" autocomplete="name" autocapitalize="words" enterkeyhint="next" class:list={[field, "h-12"]} />
            </div>
            <div>
              <label for="contact-company" class={label}>{c.company}</label>
              <input id="contact-company" name="company" type="text" maxlength="120" autocomplete="organization" enterkeyhint="next" class:list={[field, "h-12"]} />
            </div>
            <div>
              <label for="contact-phone" class={label}>{c.phone}</label>
              <input id="contact-phone" name="phone" type="tel" inputmode="tel" maxlength="32" autocomplete="tel" enterkeyhint="next" placeholder={phonePlaceholder} dir="ltr" class:list={[field, "h-12 text-start"]} />
            </div>
            <div>
              <label for="contact-email" class={label}>{c.email}</label>
              <input id="contact-email" name="email" type="email" inputmode="email" maxlength="160" autocomplete="email" autocapitalize="off" spellcheck="false" enterkeyhint="send" placeholder="name@company.com" dir="ltr" class:list={[field, "h-12 text-start"]} />
            </div>
          </div>
          <p class="text-sm text-muted -mt-1">{c.reachHint}</p>

          {/* Honeypot: invisible and unreachable for people, tempting for bots.
              Moved off-screen rather than display:none, which some bots skip. */}
          <div aria-hidden="true" class="absolute -start-[9999px] top-auto w-px h-px overflow-hidden">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="ts" value="" />
          <input type="hidden" name="site" value={SITE.id} />
          <input type="hidden" name="locale" value={locale} />
          <input type="hidden" name="path" value="" />

          <p data-contact-error role="alert" hidden class="text-sm text-danger"></p>

          <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <button
              type="submit"
              data-contact-submit
              class="shrink-0 whitespace-nowrap inline-flex items-center justify-center h-12 px-8 rounded-pill bg-accent text-accent-fg text-base font-semibold shadow-glow hover:bg-accent-strong active:scale-[0.98] transition-[background-color,transform,opacity] duration-200 ease-out-expo disabled:opacity-60 disabled:pointer-events-none"
            >
              {c.submit}
            </button>
            <p class="text-xs text-muted-soft">{c.note}</p>
          </div>
        </form>

        {/* Shown by the script after a successful send, or by :target after a
            no-JS post. role=status so it is announced when it appears. */}
        <div id="contact-sent" data-contact-success role="status" hidden class="text-center py-6">
          <div class="mx-auto mb-4 grid place-items-center w-12 h-12 rounded-full bg-accent-soft text-accent">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="font-display text-2xl font-semibold text-foreground">{c.successTitle}</h3>
          <p class="text-muted mt-2">{c.successBody}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* No-JS: the function redirects to #contact-sent; show the thanks and hide
     the form (:has is progressive — without it both show, which is harmless). */
  #contact-sent:target {
    display: block;
  }
  [data-contact-form]:has(~ #contact-sent:target) {
    display: none;
  }
</style>

<script>
  import { track } from "../lib/analytics";

  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>("[data-contact-submit]")!;
    const errorEl = form.querySelector<HTMLElement>("[data-contact-error]")!;
    const success = form.parentElement!.querySelector<HTMLElement>("[data-contact-success]")!;
    const idleLabel = submit.textContent ?? "";
    const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

    // Render time, for the server's "submitted too fast" check.
    el("ts").value = String(Date.now());
    el("path").value = location.pathname;

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      // Name and company are optional; we only need one way to reach them.
      const phone = el("phone").value.trim();
      const email = el("email").value.trim();
      const phoneOk = !phone || phone.replace(/\D/g, "").length >= 7;
      if (!form.checkValidity() || (!phone && !email) || !phoneOk) {
        showError(form.dataset.errorInvalid ?? "");
        (form.querySelector<HTMLElement>(":invalid") ?? el(phone || !email ? "phone" : "email")).focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = form.dataset.sending ?? idleLabel;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (res.status === 400) {
          showError(form.dataset.errorInvalid ?? "");
        } else if (!res.ok) {
          showError(form.dataset.errorGeneric ?? "");
        } else {
          form.hidden = true;
          success.hidden = false;
          success.focus?.();
          track("contact_submitted", { locale: el("locale").value, site: el("site").value });
          return;
        }
      } catch {
        showError(form.dataset.errorGeneric ?? "");
      }
      submit.disabled = false;
      submit.textContent = idleLabel;
    });
  });
</script>
