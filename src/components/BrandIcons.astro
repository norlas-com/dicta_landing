---
/**
 * A row of platform logo chips (Google Meet, Zoom, Teams, Jira, Trello,
 * Asana, ClickUp) shown under a feature's solution copy. Simplified brand
 * marks drawn inline (each in its brand color) — no external requests.
 */
interface Props {
  /** Which brands to show, in order. */
  brands: string[];
}
const { brands } = Astro.props;

const ALL: Record<string, { label: string; svg: string }> = {
  meet: {
    label: "Google Meet",
    svg: `<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path fill="#00832d" d="M13.5 12l2.6 3 3.5 2.2.6-5.2-.6-5-3.6 2z"/><path fill="#0066da" d="M2 16.5V21a1.5 1.5 0 0 0 1.5 1.5H8l1-3.6-1-3.4-3.3-1z"/><path fill="#e94235" d="M8 3L2 9l3 .8 3 .2 1-3.4z"/><path fill="#2684fc" d="M2 9h6v7.5H2z"/><path fill="#00ac47" d="M21.4 4.2L18 7v10.2l3.4 2.8c.5.4 1.3 0 1.3-.6V4.8c0-.6-.8-1-1.3-.6zM13.5 12v4.5H8v6h8.5A1.5 1.5 0 0 0 18 21v-3.8z"/><path fill="#ffba00" d="M16.5 1.5H8v7.5h5.5V12l4.5-3.7V3a1.5 1.5 0 0 0-1.5-1.5z"/></svg>`,
  },
  zoom: {
    label: "Zoom",
    svg: `<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#0b5cff"/><path fill="#fff" d="M5 8.6c0-.6.5-1.1 1.1-1.1h7.1c1.4 0 2.5 1.1 2.5 2.5v5.4c0 .6-.5 1.1-1.1 1.1H7.5A2.5 2.5 0 0 1 5 14V8.6zM16.6 10l2.8-2.1c.4-.3 1-.1 1 .5v7.2c0 .6-.6.8-1 .5L16.6 14v-4z"/></svg>`,
  },
  teams: {
    label: "Microsoft Teams",
    svg: `<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><circle cx="17" cy="7.5" r="2.6" fill="#7b83eb"/><circle cx="10.5" cy="6.5" r="3.4" fill="#5059c9"/><path fill="#7b83eb" d="M14.5 10.5H21a1 1 0 0 1 1 1v4.6a4 4 0 0 1-4 4h-.1a4 4 0 0 1-3.9-4v-5.1a.5.5 0 0 1 .5-.5z"/><path fill="#5059c9" d="M6.5 10h8a1 1 0 0 1 1 1v6a5 5 0 0 1-5 5 5 5 0 0 1-5-5v-6a1 1 0 0 1 1-1z"/><rect x="2" y="8" width="10" height="10" rx="1.4" fill="#4b53bc"/><path fill="#fff" d="M9.3 11.2H7.8v4.6H6.5v-4.6H5v-1.3h4.3z"/></svg>`,
  },
  jira: {
    label: "Jira",
    svg: `<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path fill="#2684ff" d="M21.6 11.3L12.7 2.4 12 1.7l-6.7 6.7-3 3a1 1 0 0 0 0 1.3l6.1 6.1L12 22.4l6.7-6.7.1-.1 2.8-2.9a1 1 0 0 0 0-1.4zM12 15.1L8.9 12 12 8.9l3.1 3.1z"/><path fill="#0052cc" d="M12 8.9A5.2 5.2 0 0 1 12 1.6l-6.8 6.8 3.7 3.7z"/><path fill="#0052cc" d="M15.1 12l-3.1 3.1a5.2 5.2 0 0 1 0 7.3l6.8-6.7z"/></svg>`,
  },
  trello: {
    label: "Trello",
    svg: `<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="5" fill="#0079bf"/><rect x="4.5" y="4.5" width="6.2" height="13" rx="1.4" fill="#fff"/><rect x="13.3" y="4.5" width="6.2" height="8" rx="1.4" fill="#fff"/></svg>`,
  },
  asana: {
    label: "Asana",
    svg: `<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.4" r="4.4" fill="#f06a6a"/><circle cx="5.4" cy="16.9" r="4.4" fill="#f06a6a"/><circle cx="18.6" cy="16.9" r="4.4" fill="#f06a6a"/></svg>`,
  },
  clickup: {
    label: "ClickUp",
    svg: `<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="cu-a" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#8930fd"/><stop offset="1" stop-color="#49ccf9"/></linearGradient><linearGradient id="cu-b" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#ff02f0"/><stop offset="1" stop-color="#ffc800"/></linearGradient></defs><path fill="url(#cu-a)" d="M3 16.5l3.2-2.5c1.6 2 3.4 3 5.8 3s4.2-1 5.8-3l3.2 2.5c-2.2 2.9-5.3 4.5-9 4.5s-6.8-1.6-9-4.5z"/><path fill="url(#cu-b)" d="M12 7.6L6.7 12 4.2 9.1 12 2.4l7.8 6.7-2.5 2.9z"/></svg>`,
  },
};

const chips = brands.map((b) => ALL[b]).filter(Boolean);
---

<div class="flex flex-wrap items-center gap-2">
  {
    chips.map((c) => (
      <span class="inline-flex items-center gap-1.5 h-8 ps-2 pe-2.5 rounded-pill border border-border bg-surface/80 text-xs font-medium text-foreground-soft">
        <Fragment set:html={c.svg} />
        {c.label}
      </span>
    ))
  }
</div>
