---
import type { Locale } from "../i18n/ui";
import { LOCALES, LOCALE_LABEL, LOCALE_COOKIE } from "../i18n/ui";
import { t, localePath, appUrl, switchLocalePath } from "../i18n/utils";
import StoreBadges from "./StoreBadges.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";
import { navExtra } from "../i18n/nav-extra";
import RecPill from "./meeting/RecPill.astro";

interface Props {
  locale: Locale;
  path: string;
  /** Per-locale targets for pages that do not exist in every locale (blog
   *  topics); a locale missing here falls back to the same bare path. */
  switchPaths?: Partial<Record<Locale, string>>;
}
const { locale, path, switchPaths } = Astro.props;
const d = t(locale);
const home = localePath("/", locale);
const nx = navExtra[locale];

// Everything the desktop bar shows, for the mobile sheet (below lg most of
// these links are hidden from the bar).
const menuLinks = [
  { href: localePath("/features", locale), label: nx.features, item: "features" },
  { href: localePath("/use-cases", locale), label: nx.useCases, item: "use_cases" },
  { href: localePath("/pricing", locale), label: nx.pricing, item: "pricing" },
  { href: localePath("/blog", locale), label: nx.blog, item: "blog" },
  { href: localePath("/download", locale), label: d.nav.download, item: "download" },
  { href: localePath("/developers", locale), label: nx.developers, item: "developers" },
];

// The bar marks the section you are in: the page itself, or any page under it
// (a feature page under Features, a post under Blog).
const here = localePath(path, locale);
// The pill spells out "Recording" from xl up, where the bar has room for it.
// Uzbek has the longest nav and the longest label ("Yozib olinmoqda"); with
// both, the bar runs edge to edge at 1280, so there it keeps the dot + clock.
const recLabelFits = locale !== "uz";
const current = (href: string) => (here === href ? "page" : here.startsWith(href) ? "true" : undefined);
---

<header class="sticky top-0 z-40 w-full border-b border-border/60 bg-background/90 supports-[backdrop-filter]:bg-background/75 supports-[backdrop-filter]:backdrop-blur-md transition-colors duration-200 [&.is-stuck]:border-border" data-header>
  <div class="max-w-6xl mx-auto ps-4 pe-2 sm:px-6 lg:px-10 h-16 flex items-center">
    <a href={home} data-analytics-event="nav_clicked" data-analytics-item="logo" aria-label="Dicta" class="inline-flex flex-none items-center group hover:text-accent transition-colors [&_img]:max-[399px]:h-[1.35rem] [&_span]:max-[399px]:text-[1.35rem] [&>span]:max-[399px]:gap-1.5">
      <Logo />
    </a>

    {/* Section links sit with the logo; the meeting controls sit on the far
        side, the way a call window puts its status and actions together. */}
    <nav class="flex items-center gap-0.5 sm:ms-3 lg:ms-5 xl:ms-6">
        <a
          href={localePath("/features", locale)}
          data-analytics-event="nav_clicked"
          data-analytics-item="features"
          aria-current={current(localePath("/features", locale))}
          class="hidden lg:inline-flex items-center h-9 px-2.5 rounded-pill text-sm font-medium whitespace-nowrap text-muted hover:text-foreground aria-[current]:text-foreground transition-colors duration-150 ease-out-expo"
        >
          {nx.features}
        </a>
        <a
          href={localePath("/use-cases", locale)}
          data-analytics-event="nav_clicked"
          data-analytics-item="use_cases"
          aria-current={current(localePath("/use-cases", locale))}
          class="hidden lg:inline-flex items-center h-9 px-2.5 rounded-pill text-sm font-medium whitespace-nowrap text-muted hover:text-foreground aria-[current]:text-foreground transition-colors duration-150 ease-out-expo"
        >
          {nx.useCases}
        </a>
        <a
          href={localePath("/pricing", locale)}
          data-analytics-event="nav_clicked"
          data-analytics-item="pricing"
          aria-current={current(localePath("/pricing", locale))}
          class="hidden sm:inline-flex items-center h-9 px-2.5 rounded-pill text-sm font-medium whitespace-nowrap text-muted hover:text-foreground aria-[current]:text-foreground transition-colors duration-150 ease-out-expo"
        >
          {nx.pricing}
        </a>
        <a
          href={localePath("/blog", locale)}
          data-analytics-event="nav_clicked"
          data-analytics-item="blog"
          aria-current={current(localePath("/blog", locale))}
          class="hidden lg:inline-flex items-center h-9 px-2.5 rounded-pill text-sm font-medium whitespace-nowrap text-muted hover:text-foreground aria-[current]:text-foreground transition-colors duration-150 ease-out-expo"
        >
          {nx.blog}
        </a>
        <a
          href={localePath("/download", locale)}
          data-analytics-event="nav_clicked"
          data-analytics-item="download"
          aria-current={current(localePath("/download", locale))}
          class="hidden lg:inline-flex items-center h-9 px-2.5 rounded-pill text-sm font-medium whitespace-nowrap text-muted hover:text-foreground aria-[current]:text-foreground transition-colors duration-150 ease-out-expo"
        >
          {d.nav.download}
        </a>
    </nav>

    <div class="ms-auto ps-2 flex flex-none items-center gap-0.5 sm:gap-1">
      <div class="hidden sm:block">
        <LanguageSwitcher locale={locale} path={path} switchPaths={switchPaths} />
      </div>
      {/* Below md the theme switch lives in the menu sheet, where there is room. */}
      <div class="hidden md:block">
        <ThemeToggle />
      </div>

      {/* The visit, recording: counts the whole visit across pages. */}
      {
        recLabelFits ? (
          <Fragment>
            <RecPill locale={locale} class="hidden xl:inline-flex mx-1" />
            <RecPill locale={locale} compact class="hidden lg:inline-flex xl:hidden mx-1" />
          </Fragment>
        ) : (
          <RecPill locale={locale} compact class="hidden lg:inline-flex mx-1" />
        )
      }

      <a
        href={appUrl("/sign-in")}
        data-analytics-event="login_click"
        data-analytics-location="header"
        class="hidden sm:inline-flex items-center h-10 px-3 rounded-pill text-sm font-medium text-foreground-soft hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {d.common.login}
      </a>

      {/* The one solid accent verb in the header: every page can start a trial
          without scrolling back to the hero. */}
      <a
        href={appUrl("/sign-up")}
        data-analytics-event="signup_start_click"
        data-analytics-location="header"
        class="inline-flex items-center h-10 px-4 max-[399px]:px-3.5 max-[399px]:text-[13px] sm:px-5 rounded-pill bg-accent text-accent-fg text-sm font-semibold shadow-glow hover:bg-accent-strong transition-colors duration-150 ease-out-expo whitespace-nowrap"
      >
        {d.home.startFree}
      </a>

      <RecPill locale={locale} compact class="lg:hidden ms-1 sm:ms-1.5 max-sm:px-2 max-sm:gap-1" />

      <button
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-label={nx.menu}
        class="lg:hidden inline-flex items-center justify-center w-9 sm:w-10 h-10 rounded-full text-foreground hover:bg-surface-2 transition-colors"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Mobile menu: a full-height sheet so every page is one tap away instead of
    a scroll to the footer. A modal <dialog> gives focus trapping, Esc and the
    inert page for free. */}
<dialog
  data-menu
  aria-label={nx.menu}
  tabindex="-1"
  class="mobile-menu lg:hidden m-0 p-0 outline-none w-full max-w-none h-[100dvh] max-h-none bg-background text-foreground"
>
  <div class="flex flex-col h-full">
    <div class="px-6 h-16 flex items-center justify-between flex-none">
      <a href={home} aria-label="Dicta" class="inline-flex items-center">
        <Logo />
      </a>
      <div class="flex items-center gap-1">
      <ThemeToggle />
      <button
        type="button"
        data-menu-close
        aria-label={nx.closeMenu}
        class="inline-flex items-center justify-center w-10 h-10 -me-2 rounded-full hover:bg-surface-2 transition-colors"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto px-6 pt-2 pb-6">
      <ul>
        {
          menuLinks.map((l) => (
            <li>
              <a
                href={l.href}
                data-analytics-event="nav_clicked"
                data-analytics-item={l.item}
                data-analytics-location="mobile_menu"
                aria-current={localePath(path, locale) === l.href ? "page" : undefined}
                class="flex items-center justify-between py-3.5 border-b border-border text-lg font-medium text-foreground aria-[current=page]:text-accent"
              >
                {l.label}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-muted rtl:-scale-x-100">
                  <path d="M9 6l6 6-6 6"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-7 text-xs font-semibold uppercase tracking-[0.06em] text-muted">{d.language}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          LOCALES.map((code) => (
            <li>
              <a
                href={switchPaths?.[code] ?? switchLocalePath(path, code)}
                hreflang={code}
                lang={code}
                data-set-locale={code}
                data-analytics-event="language_changed"
                data-analytics-lang={code}
                aria-current={code === locale ? "true" : undefined}
                class="inline-flex items-center h-9 px-4 rounded-pill border border-border text-sm text-foreground-soft aria-[current=true]:bg-foreground aria-[current=true]:text-background aria-[current=true]:border-foreground"
              >
                {LOCALE_LABEL[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex-none px-6 pt-4 pb-[max(1.25rem,env(safe-area-inset-bottom))] border-t border-border space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <a
          href={appUrl("/sign-in")}
          data-analytics-event="login_click"
          data-analytics-location="mobile_menu"
          class="inline-flex items-center justify-center h-12 rounded-pill border border-border-strong text-foreground font-medium"
        >
          {d.common.login}
        </a>
        <a
          href={appUrl("/sign-up")}
          data-analytics-event="signup_start_click"
          data-analytics-location="mobile_menu"
          class="inline-flex items-center justify-center h-12 rounded-pill bg-accent text-accent-fg font-semibold hover:bg-accent-strong transition-colors"
        >
          {d.home.startFree}
        </a>
      </div>
      <StoreBadges locale={locale} location="mobile_menu" class="justify-center [&>a]:flex-1 [&>a]:w-auto" />
    </div>
  </div>
</dialog>

<style>
  .mobile-menu::backdrop { background: transparent; }
  .mobile-menu[open] { animation: mobile-menu-in 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes mobile-menu-in {
    from { opacity: 0; transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu[open] { animation: none; }
  }
</style>

<script define:vars={{ cookie: LOCALE_COOKIE }}>
  const menu = document.querySelector("[data-menu]");
  if (menu) {
    document.querySelector("[data-menu-open]")?.addEventListener("click", () => {
      menu.showModal();
      // showModal() focuses the first link (the logo) and Safari draws the
      // focus ring around it; start on the sheet itself instead.
      menu.focus();
      document.documentElement.style.overflow = "hidden";
    });
    menu.querySelector("[data-menu-close]")?.addEventListener("click", () => menu.close());
    menu.addEventListener("close", () => (document.documentElement.style.overflow = ""));
    // Leaving the breakpoint with the sheet open (rotate, resize) must not
    // leave an invisible modal blocking the page.
    matchMedia("(min-width: 1024px)").addEventListener("change", (e) => e.matches && menu.close());
    // Same parent-domain cookie the header language switcher sets.
    menu.querySelectorAll("[data-set-locale]").forEach((link) => {
      link.addEventListener("click", () => {
        const code = link.getAttribute("data-set-locale");
        document.cookie = `${cookie}=${code}; path=/; max-age=31536000; domain=.dicta.uz; samesite=lax`;
        // Also remember it host-locally: the cookie above is scoped to .dicta.uz and
        // is not readable on dicta.live, where the first-visit auto-pick checks this.
        try { localStorage.setItem(cookie, code); } catch (e) {}
      });
    });
  }
</script>

<script>
  // Hairline under the sticky header once the page has scrolled.
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const sync = () => header.classList.toggle("is-stuck", scrollY > 8);
    addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>
