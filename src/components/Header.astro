---
import type { Locale } from "../i18n/ui";
import { LOCALES, LOCALE_LABEL, LOCALE_COOKIE } from "../i18n/ui";
import { t, localePath, appUrl, switchLocalePath } from "../i18n/utils";
import StoreBadges from "./StoreBadges.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { navExtra } from "../i18n/nav-extra";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const d = t(locale);
const home = localePath("/", locale);
const nx = navExtra[locale];

// Everything the desktop bar shows, for the mobile sheet (below lg most of
// these links are hidden from the bar).
const menuLinks = [
  { href: localePath("/features", locale), label: nx.features, item: "features" },
  { href: localePath("/use-cases", locale), label: nx.useCases, item: "use_cases" },
  { href: localePath("/pricing", locale), label: nx.pricing, item: "pricing" },
  { href: localePath("/blog", locale), label: nx.blog, item: "blog" },
  { href: localePath("/download", locale), label: d.nav.download, item: "download" },
  { href: localePath("/developers", locale), label: nx.developers, item: "developers" },
];
---

<header class="sticky top-0 z-40 w-full border-b border-transparent bg-background/90 supports-[backdrop-filter]:bg-background/75 supports-[backdrop-filter]:backdrop-blur-md transition-colors duration-200 [&.is-stuck]:border-border" data-header>
  <div class="max-w-6xl mx-auto px-6 lg:px-10 h-16 flex items-center justify-between">
    <a href={home} data-analytics-event="nav_clicked" data-analytics-item="logo" class="inline-flex items-baseline gap-2 group">
      <span class="font-display text-[1.6rem] font-semibold tracking-tight group-hover:text-accent transition-colors">Dicta</span>
      <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      <a
        href={localePath("/features", locale)}
        data-analytics-event="nav_clicked"
        data-analytics-item="features"
        class="hidden lg:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {nx.features}
      </a>

      <a
        href={localePath("/use-cases", locale)}
        data-analytics-event="nav_clicked"
        data-analytics-item="use_cases"
        class="hidden lg:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {nx.useCases}
      </a>

      <a
        href={localePath("/pricing", locale)}
        data-analytics-event="nav_clicked"
        data-analytics-item="pricing"
        class="hidden sm:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {nx.pricing}
      </a>

      <a
        href={localePath("/blog", locale)}
        data-analytics-event="nav_clicked"
        data-analytics-item="blog"
        class="hidden lg:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {nx.blog}
      </a>

      <a
        href={localePath("/download", locale)}
        data-analytics-event="nav_clicked"
        data-analytics-item="download"
        class="hidden lg:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {d.nav.download}
      </a>

      <div class="hidden sm:block">
        <LanguageSwitcher locale={locale} path={path} />
      </div>
      <ThemeToggle />

      <a
        href={appUrl("/sign-in")}
        data-analytics-event="login_click"
        data-analytics-location="header"
        class="hidden sm:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-foreground-soft hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {d.common.login}
      </a>

      {/* The one solid accent verb in the header: every page can start a trial
          without scrolling back to the hero. */}
      <a
        href={appUrl("/sign-up")}
        data-analytics-event="signup_start_click"
        data-analytics-location="header"
        class="inline-flex items-center h-10 px-4 sm:px-5 rounded-full bg-accent text-accent-fg text-sm font-medium shadow-glow hover:bg-accent-strong transition-colors duration-150 ease-out-expo"
      >
        {d.home.startFree}
      </a>

      <button
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-label={nx.menu}
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 -me-2 rounded-full text-foreground hover:bg-surface-2 transition-colors"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

{/* Mobile menu: a full-height sheet so every page is one tap away instead of
    a scroll to the footer. A modal <dialog> gives focus trapping, Esc and the
    inert page for free. */}
<dialog
  data-menu
  aria-label={nx.menu}
  class="mobile-menu lg:hidden m-0 p-0 w-full max-w-none h-[100dvh] max-h-none bg-background text-foreground"
>
  <div class="flex flex-col h-full">
    <div class="px-6 h-16 flex items-center justify-between flex-none">
      <a href={home} class="inline-flex items-baseline gap-2">
        <span class="font-display text-[1.6rem] font-semibold tracking-tight">Dicta</span>
        <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      </a>
      <button
        type="button"
        data-menu-close
        aria-label={nx.closeMenu}
        class="inline-flex items-center justify-center w-10 h-10 -me-2 rounded-full hover:bg-surface-2 transition-colors"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-6 pt-2 pb-6">
      <ul>
        {
          menuLinks.map((l) => (
            <li>
              <a
                href={l.href}
                data-analytics-event="nav_clicked"
                data-analytics-item={l.item}
                data-analytics-location="mobile_menu"
                aria-current={localePath(path, locale) === l.href ? "page" : undefined}
                class="flex items-center justify-between py-3.5 border-b border-border text-lg font-medium text-foreground aria-[current=page]:text-accent"
              >
                {l.label}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-muted rtl:-scale-x-100">
                  <path d="M9 6l6 6-6 6"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-7 text-xs font-semibold uppercase tracking-[0.06em] text-muted">{d.language}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          LOCALES.map((code) => (
            <li>
              <a
                href={switchLocalePath(path, code)}
                hreflang={code}
                lang={code}
                data-set-locale={code}
                data-analytics-event="language_changed"
                data-analytics-lang={code}
                aria-current={code === locale ? "true" : undefined}
                class="inline-flex items-center h-9 px-4 rounded-pill border border-border text-sm text-foreground-soft aria-[current=true]:bg-foreground aria-[current=true]:text-background aria-[current=true]:border-foreground"
              >
                {LOCALE_LABEL[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex-none px-6 pt-4 pb-[max(1.25rem,env(safe-area-inset-bottom))] border-t border-border space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <a
          href={appUrl("/sign-in")}
          data-analytics-event="login_click"
          data-analytics-location="mobile_menu"
          class="inline-flex items-center justify-center h-12 rounded-pill border border-border-strong text-foreground font-medium"
        >
          {d.common.login}
        </a>
        <a
          href={appUrl("/sign-up")}
          data-analytics-event="signup_start_click"
          data-analytics-location="mobile_menu"
          class="inline-flex items-center justify-center h-12 rounded-pill bg-accent text-accent-fg font-semibold hover:bg-accent-strong transition-colors"
        >
          {d.home.startFree}
        </a>
      </div>
      <StoreBadges locale={locale} location="mobile_menu" class="justify-center [&>a]:flex-1 [&>a]:w-auto" />
    </div>
  </div>
</dialog>

<style>
  .mobile-menu::backdrop { background: transparent; }
  .mobile-menu[open] { animation: mobile-menu-in 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes mobile-menu-in {
    from { opacity: 0; transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu[open] { animation: none; }
  }
</style>

<script define:vars={{ cookie: LOCALE_COOKIE }}>
  const menu = document.querySelector("[data-menu]");
  if (menu) {
    document.querySelector("[data-menu-open]")?.addEventListener("click", () => {
      menu.showModal();
      document.documentElement.style.overflow = "hidden";
    });
    menu.querySelector("[data-menu-close]")?.addEventListener("click", () => menu.close());
    menu.addEventListener("close", () => (document.documentElement.style.overflow = ""));
    // Leaving the breakpoint with the sheet open (rotate, resize) must not
    // leave an invisible modal blocking the page.
    matchMedia("(min-width: 1024px)").addEventListener("change", (e) => e.matches && menu.close());
    // Same parent-domain cookie the header language switcher sets.
    menu.querySelectorAll("[data-set-locale]").forEach((link) => {
      link.addEventListener("click", () => {
        const code = link.getAttribute("data-set-locale");
        document.cookie = `${cookie}=${code}; path=/; max-age=31536000; domain=.dicta.uz; samesite=lax`;
      });
    });
  }
</script>

<script>
  // Hairline under the sticky header once the page has scrolled.
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const sync = () => header.classList.toggle("is-stuck", scrollY > 8);
    addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>
