---
import type { Locale } from "../i18n/ui";
import { t, localePath, appUrl } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const d = t(locale);
const home = localePath("/", locale);
---

<header class="w-full">
  <div class="max-w-6xl mx-auto px-6 lg:px-10 h-16 flex items-center justify-between">
    <a href={home} data-analytics-event="nav_clicked" data-analytics-item="logo" class="inline-flex items-baseline gap-2 group">
      <span class="font-display text-2xl font-semibold tracking-tight group-hover:text-accent transition-colors">Dicta</span>
      <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      <a
        href={`${home === "/" ? "" : home}/#pricing`}
        data-analytics-event="nav_clicked"
        data-analytics-item="pricing"
        class="hidden sm:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {d.pricing.navLabel}
      </a>

      {/* /download now covers phone AND computer, so it earns a permanent nav
          slot. Hidden on the narrowest screens for the same reason Pricing is —
          the row runs out of width before the Login pill. */}
      <a
        href={localePath("/download", locale)}
        data-analytics-event="nav_clicked"
        data-analytics-item="download"
        class="hidden sm:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {d.nav.download}
      </a>

      <a
        href={localePath("/faq", locale)}
        data-analytics-event="nav_clicked"
        data-analytics-item="faq"
        class="hidden md:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {d.nav.faq}
      </a>

      <a
        href={`${home === "/" ? "" : home}/#contact`}
        data-analytics-event="nav_clicked"
        data-analytics-item="contact"
        class="hidden md:inline-flex items-center h-10 px-3 rounded-full text-sm font-medium text-muted hover:text-foreground transition-colors duration-150 ease-out-expo"
      >
        {d.nav.contact}
      </a>

      <LanguageSwitcher locale={locale} path={path} />
      <ThemeToggle />

      <a
        href={appUrl("/sign-in")}
        data-analytics-event="login_click"
        data-analytics-location="header"
        class="bg-surface-2 text-foreground border border-border rounded-full px-4 sm:px-5 h-10 inline-flex items-center text-sm font-medium hover:bg-border transition-colors duration-150 ease-out-expo"
      >
        {d.common.login}
      </a>
    </nav>
  </div>
</header>
