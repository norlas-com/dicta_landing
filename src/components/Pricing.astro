---
import type { Locale } from "../i18n/ui";
import { t, appUrl } from "../i18n/utils";
import type { BillingCatalog, CatalogPrices } from "../lib/catalog";

interface Props {
  locale: Locale;
  catalog: BillingCatalog;
}
const { locale, catalog } = Astro.props;
const p = t(locale).pricing;

const usd = (minor: number) =>
  minor === 0 ? "$0" : `$${(minor / 100).toFixed(2)}`;
const groupThousands = (n: number) =>
  Math.round(n)
    .toString()
    .replace(/\B(?=(\d{3})+(?!\d))/g, " ");

function amountFor(prices: CatalogPrices, cur: "UZS" | "USD") {
  const minor = prices[cur];
  if (minor === 0) return { amount: p.freeWord, unit: "" };
  if (cur === "USD") return { amount: usd(minor), unit: "" };
  return { amount: groupThousands(minor / 100), unit: p.uzsUnit };
}

function packsLineFor(cur: "UZS" | "USD"): string | null {
  if (!catalog.packs || catalog.packs.length === 0) return null;
  const cheapest = catalog.packs.reduce((a, b) =>
    b.prices[cur] < a.prices[cur] ? b : a,
  );
  const minor = cheapest.prices[cur];
  const price = cur === "USD" ? usd(minor) : `${groupThousands(minor / 100)} ${p.uzsUnit}`;
  return p.packsLine.replace("{price}", price);
}

const defaultCur: "UZS" | "USD" = catalog.default_currency ?? "UZS";
const currencies: ("UZS" | "USD")[] = ["UZS", "USD"];

// Enterprise (`custom`) is a display-only tier rendered last with a contact CTA,
// never a checkout card — drop it from the catalog loop if the API lists it.
const plans = catalog.plans.filter((plan) => plan.id !== "custom").map((plan) => {
  const isFree = plan.prices.USD === 0 && plan.prices.UZS === 0;
  const bullets = [
    p.bulletStorage.replace("{gb}", String(plan.storage_gb)),
    plan.retention_days == null
      ? p.bulletRetentionForever
      : p.bulletRetentionDays.replace("{days}", String(plan.retention_days)),
    p.support[plan.support],
  ];
  return {
    ...plan,
    isFree,
    bullets,
    minutesLabel: p.minutes.replace("{min}", String(plan.minutes)),
    uzs: amountFor(plan.prices, "UZS"),
    usd: amountFor(plan.prices, "USD"),
  };
});

const gridCols =
  plans.length + 1 >= 5
    ? "sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
    : "sm:grid-cols-2 lg:grid-cols-4";
const enterpriseBullets = [p.enterpriseMinutes, p.enterpriseMembers, p.enterpriseSupport];
const ENTERPRISE_CONTACT = "mailto:info@dicta.uz";

// Per-tier art and hue, as in the app's Billing tab. Full class literals so
// Tailwind sees them. The art is a transparent cut-out, so `tile` is only a
// pale backdrop in the tier hue; `tier` feeds the hover halo.
type Slot = "neutral" | "accent" | "business" | "top" | "enterprise";
const SLOT: Record<Slot, { art: string; tile: string; tier: string; text: string; primary: string }> = {
  neutral: {
    art: "/plans/plan-neutral.webp",
    tile: "#eeedf9",
    tier: "color-mix(in oklch, var(--color-foreground) 60%, transparent)",
    text: "text-muted",
    primary: "bg-foreground text-background hover:opacity-90",
  },
  accent: {
    art: "/plans/plan-accent.webp",
    tile: "#dfe5f1",
    tier: "var(--color-accent)",
    text: "text-accent",
    primary: "bg-accent text-accent-fg hover:bg-accent-strong",
  },
  business: {
    art: "/plans/plan-business.webp",
    tile: "#e9fcf7",
    tier: "var(--color-tier-business)",
    text: "text-tier-business",
    primary: "bg-tier-business text-tier-business-fg hover:bg-tier-business-strong",
  },
  top: {
    art: "/plans/plan-top.webp",
    tile: "#faf1e3",
    tier: "var(--color-tier-top)",
    text: "text-tier-top",
    primary: "bg-tier-top text-tier-top-fg hover:bg-tier-top-strong",
  },
  enterprise: {
    art: "/plans/plan-enterprise.webp",
    tile: "#cfdae8",
    tier: "color-mix(in oklch, var(--color-accent) 80%, transparent)",
    text: "text-accent",
    primary: "bg-accent text-accent-fg hover:bg-accent-strong",
  },
};
// Plan ids come from the API catalog; an unknown one gets the brand hue.
const PLAN_SLOT: Record<string, Slot> = { free: "neutral", pro: "accent", business: "business", top: "top" };
const slotFor = (id: string): Slot => PLAN_SLOT[id] ?? "accent";

const packsUZS = packsLineFor("UZS");
const packsUSD = packsLineFor("USD");
---

<section id="pricing" class="relative scroll-mt-20" data-pricing data-default-cur={defaultCur}>
  <div class="relative max-w-6xl mx-auto px-6 lg:px-10 py-14 sm:py-20 lg:py-28">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium text-accent mb-4">{p.eyebrow}</p>
      <h2 class="font-display text-[clamp(2.3rem,4.6vw,3.6rem)] font-medium tracking-[-0.03em] leading-[1.04] text-foreground text-balance">
        <span class="block">{p.headingPre}</span>
        <span class="block italic font-normal text-accent">{p.headingAccent}</span>
      </h2>
      <p class="text-base sm:text-lg text-muted mt-5 max-w-[56ch] leading-relaxed">{p.sub}</p>
    </div>

    <div class="mt-8 flex items-center gap-3">
      <span class="text-xs text-muted-soft uppercase tracking-[0.14em]">{p.currencyLabel}</span>
      <div role="tablist" aria-label={p.currencyLabel} class="inline-flex items-center p-1 rounded-pill border border-border bg-surface">
        {
          currencies.map((c) => (
            <button
              type="button"
              role="tab"
              data-cur-btn={c}
              aria-selected={c === defaultCur ? "true" : "false"}
              class:list={[
                "h-8 px-4 rounded-pill text-sm font-medium tabular-nums transition-colors duration-150 ease-out-expo",
                c === defaultCur ? "bg-accent text-accent-fg shadow-sm" : "text-muted hover:text-foreground",
              ]}
            >
              {c === "UZS" ? p.currencyUzs : p.currencyUsd}
            </button>
          ))
        }
      </div>
    </div>

    <div class:list={["mt-10 grid gap-5 items-stretch", gridCols]}>
      {
        [...plans.map((plan) => ({ kind: "plan" as const, plan })), { kind: "enterprise" as const, plan: null }].map((card, i) => {
          const plan = card.plan;
          const s = SLOT[plan ? slotFor(plan.id) : "enterprise"];
          const popular = plan?.popular ?? false;
          const bullets = plan ? plan.bullets : enterpriseBullets;
          return (
            <div class="reveal relative h-full" style={`--rd:${i * 0.08}s`}>
              <div
                class:list={[
                  "plan-card group relative h-full flex flex-col rounded-panel border bg-surface p-4",
                  popular ? "plan-glow z-[1] border-transparent" : "border-border",
                ]}
                style={`--tier:${s.tier}`}
                data-tier={plan ? slotFor(plan.id) : "enterprise"}
              >
                {/* Art tile. The figure is contained with padding so it is never
                    cropped; the tile is a pale backdrop in the tier hue. */}
                <div class="relative h-40 overflow-hidden rounded-card" style={`background-color:${s.tile}`}>
                  <div class="plan-float h-full w-full py-2" style={`--fd:${i * 0.4}s`}>
                    <img
                      src={s.art}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="plan-art h-full w-full object-contain"
                    />
                  </div>
                  {popular && (
                    <span class:list={["absolute end-2 top-2 inline-flex items-center h-6 px-2.5 rounded-pill text-2xs font-semibold uppercase tracking-[0.1em] shadow-sm", s.primary]}>
                      {p.popular}
                    </span>
                  )}
                </div>

                <h3 class:list={["mt-4 font-display text-xl font-medium", s.text]}>
                  {plan ? plan.name : p.enterpriseName}
                </h3>

                <div class="mt-2 flex flex-wrap items-baseline gap-x-1.5 min-h-[2.25rem]">
                  {plan ? (
                    <>
                      {/* dir isolates the space-grouped digits so RTL can't flip "849 000". */}
                      <span
                        data-price-amount
                        dir="ltr"
                        data-uzs={plan.uzs.amount}
                        data-usd={plan.usd.amount}
                        class:list={[
                          "font-display font-semibold tracking-[-0.01em] leading-none text-foreground whitespace-nowrap",
                          plan.isFree ? "text-3xl" : "text-[2.25rem] xl:text-[1.85rem]",
                        ]}
                      >
                        {defaultCur === "UZS" ? plan.uzs.amount : plan.usd.amount}
                      </span>
                      <span
                        data-price-unit
                        data-uzs={plan.uzs.unit}
                        data-usd={plan.usd.unit}
                        class="text-sm font-medium text-muted"
                        hidden={(defaultCur === "UZS" ? plan.uzs.unit : plan.usd.unit) === ""}
                      >
                        {defaultCur === "UZS" ? plan.uzs.unit : plan.usd.unit}
                      </span>
                    </>
                  ) : (
                    <span class="font-display font-semibold tracking-[-0.01em] leading-none text-[1.75rem] text-foreground">{p.enterprisePrice}</span>
                  )}
                </div>

                {/* Always laid out (blank for Enterprise) so the lists line up. */}
                <p class="mt-2 h-[1.35rem] text-sm text-muted-soft font-sans tabular-nums">{plan?.minutesLabel}</p>

                <ul class="mt-5 space-y-3">
                  {bullets.map((b) => (
                    <li class="flex items-start gap-2.5 text-sm text-foreground-soft">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class:list={["shrink-0 mt-0.5", s.text]}>
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span class="leading-snug">{b}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-6 pt-2 flex-1 flex items-end">
                  <a
                    href={plan ? appUrl("/sign-up") : ENTERPRISE_CONTACT}
                    data-analytics-event="pricing_plan_selected"
                    data-analytics-plan={plan ? plan.id : "custom"}
                    class:list={[
                      "w-full inline-flex items-center justify-center h-11 rounded-pill font-medium transition-[background-color,opacity,transform] duration-200 ease-out-expo active:scale-[0.98]",
                      plan ? [s.primary, "shadow-sm"] : "text-foreground bg-surface-2 border border-border-strong hover:bg-surface-3",
                    ]}
                  >
                    {plan ? p.cta : p.enterpriseCta}
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="mt-10 flex flex-col gap-2 text-center">
      {
        (packsUZS || packsUSD) && (
          <p class="text-sm text-muted" data-packs data-uzs={packsUZS ?? ""} data-usd={packsUSD ?? ""}>
            {defaultCur === "UZS" ? packsUZS : packsUSD}
          </p>
        )
      }
      <p class="text-sm text-foreground-soft font-medium">{p.reassurance}</p>
      {/* The tax basis belongs next to the price, not only in the offer: this
          is where most people first see what Dicta costs. */}
      <p class="text-xs text-muted-soft mt-2">{p.vatNote}</p>
    </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  document.querySelectorAll("[data-pricing]").forEach((section) => {
    const btns = section.querySelectorAll("[data-cur-btn]");
    const apply = (cur: string) => {
      const key = cur === "UZS" ? "uzs" : "usd";
      section.querySelectorAll("[data-price-amount]").forEach((el) => {
        el.textContent = el.getAttribute(`data-${key}`) ?? el.textContent;
      });
      section.querySelectorAll<HTMLElement>("[data-price-unit]").forEach((el) => {
        const v = el.getAttribute(`data-${key}`) ?? "";
        el.textContent = v;
        el.hidden = v === "";
      });
      section.querySelectorAll("[data-packs]").forEach((el) => {
        el.textContent = el.getAttribute(`data-${key}`) ?? "";
      });
      btns.forEach((b) => {
        const active = b.getAttribute("data-cur-btn") === cur;
        b.setAttribute("aria-selected", active ? "true" : "false");
        b.classList.toggle("bg-accent", active);
        b.classList.toggle("text-accent-fg", active);
        b.classList.toggle("shadow-sm", active);
        b.classList.toggle("text-muted", !active);
        b.classList.toggle("hover:text-foreground", !active);
      });
    };
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        const cur = b.getAttribute("data-cur-btn") ?? "UZS";
        apply(cur);
        track("pricing_currency_toggled", { currency: cur.toLowerCase() });
      }),
    );
  });
</script>
