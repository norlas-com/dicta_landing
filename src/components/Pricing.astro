---
import type { Locale } from "../i18n/ui";
import { t, appUrl } from "../i18n/utils";
import type { BillingCatalog, CatalogPrices } from "../lib/catalog";

interface Props {
  locale: Locale;
  catalog: BillingCatalog;
}
const { locale, catalog } = Astro.props;
const p = t(locale).pricing;

const usd = (minor: number) =>
  minor === 0 ? "$0" : `$${(minor / 100).toFixed(2)}`;
const groupThousands = (n: number) =>
  Math.round(n)
    .toString()
    .replace(/\B(?=(\d{3})+(?!\d))/g, " ");

function amountFor(prices: CatalogPrices, cur: "UZS" | "USD") {
  const minor = prices[cur];
  if (minor === 0) return { amount: p.freeWord, unit: "" };
  if (cur === "USD") return { amount: usd(minor), unit: "" };
  return { amount: groupThousands(minor / 100), unit: p.uzsUnit };
}

function packsLineFor(cur: "UZS" | "USD"): string | null {
  if (!catalog.packs || catalog.packs.length === 0) return null;
  const cheapest = catalog.packs.reduce((a, b) =>
    b.prices[cur] < a.prices[cur] ? b : a,
  );
  const minor = cheapest.prices[cur];
  const price = cur === "USD" ? usd(minor) : `${groupThousands(minor / 100)} ${p.uzsUnit}`;
  return p.packsLine.replace("{price}", price);
}

const defaultCur: "UZS" | "USD" = catalog.default_currency ?? "UZS";
const currencies: ("UZS" | "USD")[] = ["UZS", "USD"];

const plans = catalog.plans.map((plan) => {
  const isFree = plan.prices.USD === 0 && plan.prices.UZS === 0;
  const bullets = [
    p.bulletStorage.replace("{gb}", String(plan.storage_gb)),
    plan.retention_days == null
      ? p.bulletRetentionForever
      : p.bulletRetentionDays.replace("{days}", String(plan.retention_days)),
    p.support[plan.support],
  ];
  return {
    ...plan,
    isFree,
    bullets,
    minutesLabel: p.minutes.replace("{min}", String(plan.minutes)),
    uzs: amountFor(plan.prices, "UZS"),
    usd: amountFor(plan.prices, "USD"),
  };
});

const packsUZS = packsLineFor("UZS");
const packsUSD = packsLineFor("USD");
---

<section id="pricing" class="relative scroll-mt-20" data-pricing data-default-cur={defaultCur}>
  <div class="relative max-w-6xl mx-auto px-6 lg:px-10 py-14 sm:py-20 lg:py-28">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium text-accent mb-4">{p.eyebrow}</p>
      <h2 class="font-display text-[clamp(2.3rem,4.6vw,3.6rem)] font-medium tracking-[-0.03em] leading-[1.04] text-foreground text-balance">
        <span class="block">{p.headingPre}</span>
        <span class="block italic font-normal text-accent">{p.headingAccent}</span>
      </h2>
      <p class="text-base sm:text-lg text-muted mt-5 max-w-[56ch] leading-relaxed">{p.sub}</p>
    </div>

    <div class="mt-8 flex items-center gap-3">
      <span class="text-xs text-muted-soft uppercase tracking-[0.14em]">{p.currencyLabel}</span>
      <div role="tablist" aria-label={p.currencyLabel} class="inline-flex items-center p-1 rounded-pill border border-border bg-surface">
        {
          currencies.map((c) => (
            <button
              type="button"
              role="tab"
              data-cur-btn={c}
              aria-selected={c === defaultCur ? "true" : "false"}
              class:list={[
                "h-8 px-4 rounded-pill text-sm font-medium tabular-nums transition-colors duration-150 ease-out-expo",
                c === defaultCur ? "bg-accent text-accent-fg shadow-sm" : "text-muted hover:text-foreground",
              ]}
            >
              {c === "UZS" ? p.currencyUzs : p.currencyUsd}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 items-stretch">
      {
        plans.map((plan, i) => (
          <div class:list={["reveal relative h-full", plan.popular && "sm:-my-1"]} style={`--rd:${i * 0.08}s`}>
            <div
              class:list={[
                "relative h-full flex flex-col rounded-panel overflow-hidden transition-transform duration-200 ease-out-expo",
                plan.popular
                  ? "border border-accent/40 bg-surface shadow-glow"
                  : "border border-border bg-surface hover:-translate-y-0.5 hover:shadow-card",
              ]}
            >
              <div class="flex flex-col flex-1 p-6">
                <div class="flex items-center justify-between gap-2 min-h-[1.75rem]">
                  <h3 class="text-lg font-semibold text-foreground">{plan.name}</h3>
                  {plan.popular && (
                    <span class="inline-flex items-center h-6 px-2.5 rounded-pill bg-accent-soft text-accent text-2xs font-semibold uppercase tracking-[0.1em]">
                      {p.popular}
                    </span>
                  )}
                </div>

                <div class="mt-4 flex items-baseline gap-1.5">
                  <span
                    data-price-amount
                    data-uzs={plan.uzs.amount}
                    data-usd={plan.usd.amount}
                    class:list={[
                      "font-display font-semibold tracking-[-0.01em] leading-none",
                      plan.isFree ? "text-3xl text-accent" : "text-[2.25rem] text-foreground",
                    ]}
                  >
                    {defaultCur === "UZS" ? plan.uzs.amount : plan.usd.amount}
                  </span>
                  <span
                    data-price-unit
                    data-uzs={plan.uzs.unit}
                    data-usd={plan.usd.unit}
                    class="text-sm font-medium text-muted"
                    hidden={(defaultCur === "UZS" ? plan.uzs.unit : plan.usd.unit) === ""}
                  >
                    {defaultCur === "UZS" ? plan.uzs.unit : plan.usd.unit}
                  </span>
                </div>

                <p class="mt-2 text-sm text-muted-soft font-sans tabular-nums">{plan.minutesLabel}</p>

                <ul class="mt-6 space-y-3">
                  {plan.bullets.map((b) => (
                    <li class="flex items-start gap-2.5 text-sm text-foreground-soft">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class:list={["shrink-0 mt-0.5", plan.popular ? "text-accent" : "text-muted"]}>
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span class="leading-snug">{b}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-6 pt-2 flex-1 flex items-end">
                  <a
                    href={appUrl("/sign-up")}
                    data-analytics-event="pricing_plan_selected"
                    data-analytics-plan={plan.id}
                    class:list={[
                      "w-full inline-flex items-center justify-center h-11 rounded-pill font-medium transition-[background-color,transform] duration-200 ease-out-expo active:scale-[0.98]",
                      plan.popular
                        ? "bg-accent text-accent-fg shadow-glow hover:bg-accent-strong"
                        : "text-foreground bg-surface-2 border border-border-strong hover:bg-surface-3",
                    ]}
                  >
                    {p.cta}
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-2 text-center">
      {
        (packsUZS || packsUSD) && (
          <p class="text-sm text-muted" data-packs data-uzs={packsUZS ?? ""} data-usd={packsUSD ?? ""}>
            {defaultCur === "UZS" ? packsUZS : packsUSD}
          </p>
        )
      }
      <p class="text-sm text-foreground-soft font-medium">{p.reassurance}</p>
      {/* The tax basis belongs next to the price, not only in the offer: this
          is where most people first see what Dicta costs. */}
      <p class="text-xs text-muted-soft mt-2">{p.vatNote}</p>
    </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  document.querySelectorAll("[data-pricing]").forEach((section) => {
    const btns = section.querySelectorAll("[data-cur-btn]");
    const apply = (cur: string) => {
      const key = cur === "UZS" ? "uzs" : "usd";
      section.querySelectorAll("[data-price-amount]").forEach((el) => {
        el.textContent = el.getAttribute(`data-${key}`) ?? el.textContent;
      });
      section.querySelectorAll<HTMLElement>("[data-price-unit]").forEach((el) => {
        const v = el.getAttribute(`data-${key}`) ?? "";
        el.textContent = v;
        el.hidden = v === "";
      });
      section.querySelectorAll("[data-packs]").forEach((el) => {
        el.textContent = el.getAttribute(`data-${key}`) ?? "";
      });
      btns.forEach((b) => {
        const active = b.getAttribute("data-cur-btn") === cur;
        b.setAttribute("aria-selected", active ? "true" : "false");
        b.classList.toggle("bg-accent", active);
        b.classList.toggle("text-accent-fg", active);
        b.classList.toggle("shadow-sm", active);
        b.classList.toggle("text-muted", !active);
        b.classList.toggle("hover:text-foreground", !active);
      });
    };
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        const cur = b.getAttribute("data-cur-btn") ?? "UZS";
        apply(cur);
        track("pricing_currency_toggled", { currency: cur.toLowerCase() });
      }),
    );
  });
</script>
