---
import "../styles/global.css";
import { LOCALES, type Locale } from "../i18n/ui";
import { localePath, switchLocalePath } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Bare route (no locale prefix), e.g. "/" or "/download". */
  path: string;
  ogImage?: string;
  /** Extra JSON-LD objects to embed in <head>. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  path,
  ogImage = "/og/meeting.png",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://dicta.uz");
const canonical = new URL(localePath(path, locale), site).toString();
const ogImageAbs = new URL(ogImage, site).toString();
const htmlLangMap: Record<Locale, string> = {
  uz: "uz-UZ",
  ru: "ru-RU",
  en: "en-US",
};

// GA4 "Landing" data stream (property dicta-4e39f / 535205407). The measurement
// id is public (visible in page source), so it's committed as a fallback so the
// Cloudflare Pages build always has it; a PUBLIC_GA_MEASUREMENT_ID env var (Pages
// settings) overrides it if ever needed. Build-time inlined; skipped on noindex.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "G-GHTZKSLH1X";
---

<!doctype html>
<html lang={htmlLangMap[locale]} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply the stored theme before first paint (no flash). Also mark the
         document as JS-capable so .reveal elements may start hidden. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          var stored = localStorage.getItem("dicta-theme");
          var choice =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          var root = document.documentElement;
          root.classList.toggle("light", choice === "light");
          root.classList.toggle("dark", choice === "dark");
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* GA4 (gtag.js). Consent Mode v2 defaults granted now so a later cookie
        banner just flips consent. Cross-domain linker stitches the
        dicta.uz → meet.dicta.uz handoff. MPA → automatic page_view per load. */}
    {
      gaId && !noindex && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId, contentLanguage: htmlLangMap[locale] }}>
            window.dataLayer = window.dataLayer || [];
            // Assigned to window (not a bare `function`) because Astro's
            // define:vars wraps this script in an IIFE — a local function would
            // not be reachable from the helper/delegated listener.
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "granted",
            });
            gtag("config", gaId, {
              anonymize_ip: true,
              allow_google_signals: false,
              content_language: contentLanguage,
              linker: { domains: ["dicta.uz", "meet.dicta.uz"] },
            });
          </script>
        </Fragment>
      )
    }

    <!-- hreflang alternates -->
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={htmlLangMap[l]}
          href={new URL(switchLocalePath(path, l), site).toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocalePath(path, "uz"), site).toString()}
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dicta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content={htmlLangMap[locale].replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Icons + PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0A0F" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFAFB" media="(prefers-color-scheme: light)" />

    {
      jsonLd.map((obj) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(obj)}
        />
      ))
    }
  </head>
  <body class="font-sans">
    <main class="min-h-screen bg-background text-foreground flex flex-col">
      <slot />
    </main>

    <script>
      // Scroll-reveal: elements with .reveal rise in on first intersection.
      const revealables = document.querySelectorAll(".reveal");
      if (revealables.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("revealed");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        revealables.forEach((el) => io.observe(el));
      }
    </script>

    <script>
      // Delegated GA4 click tracking: any element (or ancestor) tagged with
      // data-analytics-event fires that event; extra data-analytics-<key>
      // attributes become event params (kebab → snake_case). Lets CTAs stay
      // plain <a>/<button> with declarative tracking, no per-component wiring.
      import { track } from "../lib/analytics";
      document.addEventListener(
        "click",
        (e) => {
          const target = e.target as HTMLElement | null;
          const el = target?.closest<HTMLElement>("[data-analytics-event]");
          if (!el) return;
          const event = el.dataset.analyticsEvent;
          if (!event) return;
          const params: Record<string, string> = {};
          for (const attr of Array.from(el.attributes)) {
            if (
              attr.name.startsWith("data-analytics-") &&
              attr.name !== "data-analytics-event"
            ) {
              const key = attr.name
                .slice("data-analytics-".length)
                .replace(/-/g, "_");
              params[key] = attr.value;
            }
          }
          track(event, params);
        },
        { capture: true },
      );
    </script>
  </body>
</html>
