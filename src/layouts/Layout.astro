---
import "../styles/global.css";
import { LOCALES, DEFAULT_LOCALE, dirFor, type Locale } from "../i18n/ui";
import { SITE } from "../../site.config.mjs";
import { localePath, switchLocalePath } from "../i18n/utils";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import interCyr from "@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url";
import literataLatin from "@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url";
import literataCyr from "@fontsource-variable/literata/files/literata-cyrillic-opsz-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Bare route (no locale prefix), e.g. "/" or "/download". */
  path: string;
  ogImage?: string;
  /** Extra JSON-LD objects to embed in <head>. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Pages whose translations live at different slugs (blog posts): the
   *  absolute path of each existing translation, keyed by locale. Replaces the
   *  default "same bare path in every locale" hreflang set. */
  alternates?: Partial<Record<Locale, string>>;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  locale,
  path,
  ogImage = "/og/meeting.png",
  jsonLd = [],
  noindex = false,
  alternates,
  ogType = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://dicta.uz");
// Cloudflare Pages serves every page as a directory and 308s `/pricing` to
// `/pricing/`, and the sitemap lists the slashed form. Canonical and hreflang
// must name the URL that actually answers 200, not the one that redirects.
const pageUrl = (p: string) =>
  new URL(p.endsWith("/") || /\.[a-z0-9]+$/i.test(p) ? p : `${p}/`, site).toString();
const canonical = pageUrl(localePath(path, locale));

// First-visit language pick (client side: the site is static, so there is no
// Accept-Language header to read at request time; navigator.languages mirrors
// it). Only the unprefixed default-locale URL is ever redirected, and only for
// a visitor with no saved choice — so a deep link to /ru/ or an explicit
// switch is never overridden, and crawlers (which get skipped by UA/webdriver,
// and send no language list) keep indexing the canonical page. The pick is not
// stored: only the switcher writes the choice.
const autoLocaleTargets =
  !noindex && locale === DEFAULT_LOCALE
    ? Object.fromEntries(
        LOCALES.filter((l) => l !== DEFAULT_LOCALE && (!alternates || alternates[l])).map((l) => [
          l,
          new URL(pageUrl(alternates ? alternates[l]! : switchLocalePath(path, l)), site).pathname,
        ]),
      )
    : null;
const ogImageAbs = new URL(ogImage, site).toString();
const htmlLangMap: Record<Locale, string> = {
  uz: "uz-UZ",
  ru: "ru-RU",
  en: "en-US",
  // Region-neutral on purpose: this site targets the whole Arabic-speaking
  // market, and an `ar-SA` here would tell search engines otherwise.
  ar: "ar",
};

// GA4 "Landing" data stream (property dicta-4e39f / 535205407). The measurement
// id is public (visible in page source), so it's committed as a fallback so the
// Cloudflare Pages build always has it; a PUBLIC_GA_MEASUREMENT_ID env var (Pages
// settings) overrides it if ever needed. Build-time inlined; skipped on noindex.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "G-GHTZKSLH1X";

// Yandex Metrica: only when a counter id is configured, never on noindex pages.
// Falls back to the per-site id in site.config.mjs (public, like gaId above),
// so both Pages projects get it without a dashboard env var.
const ymId = import.meta.env.PUBLIC_YANDEX_METRICA_ID || SITE.metricaId;
const ymNum = ymId && /^\d+$/.test(String(ymId)) ? Number(ymId) : 0;
const ymScript = `window.__ymId=${ymNum};(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(${ymNum},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});`;

// Preload only the font subsets the first paint of this locale uses. Arabic
// pages resolve Noto Sans Arabic through unicode-range, so nothing is guessed.
const preloadFonts =
  locale === "ru"
    ? [interCyr, literataCyr]
    : locale === "ar"
      ? []
      : [interLatin, literataLatin];

// Site-wide entities, emitted on the home page of each locale.
const siteJsonLd =
  path === "/" && !noindex
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": `${SITE.url}/#organization`,
          name: "Dicta",
          url: SITE.url,
          logo: new URL("/apple-touch-icon.png", site).toString(),
        },
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${SITE.url}/#website`,
          name: "Dicta",
          url: SITE.url,
          inLanguage: htmlLangMap[locale],
          publisher: { "@id": `${SITE.url}/#organization` },
        },
      ]
    : [];
---

<!doctype html>
<!-- `dir` matters as much as `lang`: without it an Arabic page renders
     Arabic text in a left-to-right layout, and every logical CSS property
     silently behaves as its physical twin. -->
<html lang={htmlLangMap[locale]} dir={dirFor(locale)} class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="yandex-verification" content="43a91dcab154cecf" />
    <meta name="yandex-verification" content="bbb434cb37757d74" />
    <meta name="facebook-domain-verification" content="yu4vndr3j1e2txmb77andifxzywezl" />
    <meta name="facebook-domain-verification" content="ou38cng23gj4udjzl35ci1859six31" />

    <!-- Apply the stored theme before first paint (no flash). Also mark the
         document as JS-capable so .reveal elements may start hidden. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          var stored = localStorage.getItem("dicta-theme");
          var choice =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          var root = document.documentElement;
          root.classList.toggle("light", choice === "light");
          root.classList.toggle("dark", choice === "dark");
        } catch (e) {
          document.documentElement.classList.add("light");
        }
      })();
    </script>

    {
      autoLocaleTargets && (
        <script
          is:inline
          define:vars={{ targets: autoLocaleTargets, defaultLocale: DEFAULT_LOCALE, cookieName: "dicta_locale" }}
        >
          (function () {
            try {
              if (navigator.webdriver) return;
              if (/bot|crawl|spider|slurp|headless|lighthouse|facebookexternalhit|preview/i.test(navigator.userAgent)) return;
              if (document.cookie.indexOf(cookieName + "=") !== -1) return;
              if (localStorage.getItem(cookieName)) return;
              var langs = navigator.languages && navigator.languages.length ? navigator.languages : navigator.language ? [navigator.language] : [];
              if (!langs.length) return;
              var offered = ["uz", "ru", "en"].filter(function (l) { return l === defaultLocale || targets[l]; });
              var pick = null;
              for (var i = 0; i < langs.length && !pick; i++) {
                var p = String(langs[i]).toLowerCase().split("-")[0];
                if (offered.indexOf(p) !== -1) pick = p;
              }
              if (!pick && offered.indexOf("en") !== -1) pick = "en";
              if (!pick || pick === defaultLocale || !targets[pick]) return;
              location.replace(targets[pick] + location.search + location.hash);
            } catch (e) {}
          })();
        </script>
      )
    }

    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A noindex page (the 404) has no canonical address and no translations. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" type="application/rss+xml" title="Dicta blog" href="/blog/rss.xml" />

    {ymNum > 0 && !noindex && <script is:inline set:html={ymScript} />}

    {/* GA4 (gtag.js). Consent Mode v2 defaults granted now so a later cookie
        banner just flips consent. Cross-domain linker stitches the
        dicta.uz → meet.dicta.uz handoff. MPA → automatic page_view per load. */}
    {
      gaId && !noindex && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId, contentLanguage: htmlLangMap[locale], linkerDomains: SITE.gaLinkerDomains }}>
            window.dataLayer = window.dataLayer || [];
            // Assigned to window (not a bare `function`) because Astro's
            // define:vars wraps this script in an IIFE — a local function would
            // not be reachable from the helper/delegated listener.
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "granted",
            });
            gtag("config", gaId, {
              anonymize_ip: true,
              allow_google_signals: false,
              content_language: contentLanguage,
              // define:vars, not SITE: this inline script runs in the browser, where
              // the build-time SITE import does not exist.
              linker: { domains: linkerDomains },
            });
          </script>
        </Fragment>
      )
    }

    <!-- hreflang alternates -->
    {
      !noindex &&
        LOCALES.filter((l) => !alternates || alternates[l]).map((l) => (
          <link
            rel="alternate"
            hreflang={htmlLangMap[l]}
            href={pageUrl(alternates ? alternates[l]! : switchLocalePath(path, l))}
          />
        ))
    }
    {
      !noindex && (!alternates || alternates[DEFAULT_LOCALE]) && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={pageUrl(alternates ? alternates[DEFAULT_LOCALE]! : switchLocalePath(path, DEFAULT_LOCALE))}
        />
      )
    }

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dicta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content={htmlLangMap[locale].replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Icons + PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1A1922" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAF8F2" media="(prefers-color-scheme: light)" />

    {
      [...siteJsonLd, ...jsonLd].map((obj) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(obj)}
        />
      ))
    }
  </head>
  <body class="font-sans" data-fp={noindex ? "0" : "1"}>
    <main class="min-h-screen bg-background text-foreground flex flex-col">
      <slot />
    </main>

    <script>
      // Scroll-reveal: elements with .reveal rise in on first intersection.
      const revealables = document.querySelectorAll(".reveal, .reveal-shot");
      if (revealables.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("revealed");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        revealables.forEach((el) => io.observe(el));
      }
    </script>

    <script>
      // Dicta first-party analytics (session_start, screen_view/leave, ui_tap,
      // signup_cta_tapped -> POST /v1/analytics/events). Skipped on noindex
      // pages, exactly like GA4 / Metrica above.
      import { initFirstParty } from "../lib/firstParty";
      if (document.body.dataset.fp === "1") initFirstParty();
    </script>

    <script>
      // Delegated GA4 click tracking: any element (or ancestor) tagged with
      // data-analytics-event fires that event; extra data-analytics-<key>
      // attributes become event params (kebab → snake_case). Lets CTAs stay
      // plain <a>/<button> with declarative tracking, no per-component wiring.
      import { track } from "../lib/analytics";
      document.addEventListener(
        "click",
        (e) => {
          const target = e.target as HTMLElement | null;
          const el = target?.closest<HTMLElement>("[data-analytics-event]");
          if (!el) return;
          const event = el.dataset.analyticsEvent;
          if (!event) return;
          const params: Record<string, string> = {};
          for (const attr of Array.from(el.attributes)) {
            if (
              attr.name.startsWith("data-analytics-") &&
              attr.name !== "data-analytics-event"
            ) {
              const key = attr.name
                .slice("data-analytics-".length)
                .replace(/-/g, "_");
              params[key] = attr.value;
            }
          }
          track(event, params);
        },
        { capture: true },
      );
    </script>
  </body>
</html>
